  "limitations": [
    {
      "code": "photo_scaled_architecture",
      "detail": "Topology follows owner drawing 10431.jpg and photographs 171121/171151/171217/171343/171333. One isolated round pillar precedes the lift; the main row contains eleven photo-estimated pillars, not the four schematic symbols. Core dimensions, pitch and partly occluded bench bays are photo-scaled estimates, not a survey. Station Base axes, platform width, length and rail datum are retained."
    },
    {
      "code": "sculptural_inference",
      "detail": "Central pear is a flattened, smooth 2.02 m bas-relief, broad below and narrow at the neck, with bronze seed details, a short stalk and pointed leaf. Its profile/depth and partly occluded branch paths are inferred from 171147/171529; no people are baked into artwork and no exact scan is claimed."
    },
    {
      "code": "upper_circulation",
      "detail": "Only one public stair end is authored. The lift has three blank sides and one static split-door entrance; shaft/cabin and lift operation are not invented. The opposite central service core has side approaches ending at the platform wall and independent adjacent track portals. Far vestibule corridors remain approximated."
    },
    {
      "code": "future_engine_adaptation",
      "detail": "Mirror SubViewport, procedural wood/track grains and world-space material coordinates need future adaptation/baking. Native mesh/MultiMesh geometry, image assets, relief paths and dimensions are retained; no Roblox build or export is claimed."
    }
  ]
