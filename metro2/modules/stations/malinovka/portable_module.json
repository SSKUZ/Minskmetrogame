  "limitations": [
    {
      "code": "photo_scaled_architecture",
      "detail": "All 47 owner photos reviewed. Fixed V106 Station Base rail/platform datum. Architectural dimensions, 2x14 column grid, central 2x4 decorated columns, bench repetition and unseen sides inferred from photographs, not a measured survey. No unseen street vestibule reconstructed."
    },
    {
      "code": "sculpture_inference",
      "detail": "Raised/recessed column radius field, roughness transitions and bronze bird silhouettes reconstructed from photos 164931/164945/164957/165158/165225. Hidden circumferential carving and bird feather surfaces inferred. This is not a photogrammetry scan."
    },
    {
      "code": "static_equipment",
      "detail": "Bird sculptures, lift doorways, equipment and station information displays are static. Clocks retain the local Station Base departure hook. No train model or passenger AI dependency."
    },
    {
      "code": "future_portability",
      "detail": "Native Mesh/ArrayMesh/MultiMesh, per-surface materials, source textures, radius height fields, carving paths, bird profiles and anchors retained. Rail grain shader and world triplanar UVs require future baking/adaptation; Godot lights require Roblox adaptation. No Roblox export or compatibility testing performed."
    }
  ]
