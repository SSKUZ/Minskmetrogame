␀␀␀␀␀␀␀␀␀␀extends Node
## Loose, hash-addressed resources: unlike mounted PCKs these can be released on Web.
## File names in scene dependencies are user:// paths, identical in CI and runtime.
const Budget = preload("res://modules/line/build_budget.gd")
const MAX_RESIDENT_BYTES := 192 * 1024 * 1024
var _users: Dictionary = {}
var _files: Dictionary = {}
var _pending: Dictionary = {}
var _decoded: Dictionary = {}
var _leases: Dictionary = {}
var _consumer_tokens: Dictionary = {}
var _lease_serial := 0
var _resident_bytes := 0
const MAX_ARCHIVE_CACHE_BYTES := 24 * 1024 * 1024
var _archive_cache: Dictionary={}
var _archive_order: Array[String]=[]
var _archive_bytes := 0
var error_message := ""
signal progress(consumer_id: int, message: String)

static func shared(consumer: Node) -> Node:
    var root := consumer.get_tree().root
    var service := root.get_node_or_null("MetroStaticResourceStore")
    if service==null:
        service=load("res://modules/line/static_resource_store.gd").new()
        service.name="MetroStaticResourceStore"
        root.add_child(service)
    return service

func instantiate_chunk(description: Dictionary, consumer: Node) -> Node3D:
    error_message=""
    var reference: WeakRef=weakref(consumer)
    var reserved: Array[String]=[]
    for file in description.files+description.get("textures",[]):
        var path: String=str(file.path)
        if not _users.has(path):
            _trim_archives(int(file.bytes))
            if _resident_bytes+_archive_bytes+int(file.bytes)>MAX_RESIDENT_BYTES:
                error_message="Недостаточно свободной памяти для геометрии"
                _release_paths(reserved)
                return null
            _files[path]=file
            _resident_bytes+=int(file.bytes)
        _users[path]=int(_users.get(path,0))+1
        reserved.append(path)
    if not await _ensure_chunk(description,reference):
        _release_paths(reserved)
        return null
    if not _alive(reference):
        _release_paths(reserved)
        return null
    # Prepare one mesh/material/texture resource at a time. Scene parsing then
    # reuses these decoded resources instead of decoding an entire station graph.
    var decoding=Budget.new(self,1500)
    # Resolve source images without generic Texture2D binary hints first, as
    # required by Godot 4.3 exported CTEX mappings. Keep references only for leases.
    for file in description.get("textures",[])+description.files:
        var path: String=str(file.path)
        if path==str(description.scene) or _decoded.has(path): continue
        await decoding.checkpoint()
        if not _alive(reference):
            _release_paths(reserved)
            return null
        var resource := ResourceLoader.load(path,"",ResourceLoader.CACHE_MODE_REUSE)
        if resource==null:
            error_message="Не удалось подготовить ресурс геометрии: "+path
            _release_paths(reserved)
            return null
        _decoded[path]=resource
    # One small prepared scene per frame; resource parsing cannot be preempted on Web.
    await get_tree().process_frame
    if not _alive(reference):
        _release_paths(reserved)
        return null
    var scene := ResourceLoader.load(str(description.scene),"PackedScene",ResourceLoader.CACHE_MODE_REUSE) as PackedScene
    var node: Node3D=scene.instantiate() as Node3D if scene!=null else null
    scene=null
    if node==null:
        error_message="Не удалось прочитать подготовленную геометрию: "+str(description.scene)
        _release_paths(reserved)
        return null
    var consumer_id: int=consumer.get_instance_id()
    if not _consumer_tokens.has(consumer_id):
        _consumer_tokens[consumer_id]=[]
        consumer.tree_exiting.connect(_release_consumer.bind(consumer_id),CONNECT_ONE_SHOT)
    _lease_serial+=1
    _leases[_lease_serial]={"paths":reserved,"consumer":consumer_id}
    _consumer_tokens[consumer_id].append(_lease_serial)
    node.set_meta("static_resource_token",_lease_serial)
    return node

func _ensure_chunk(description: Dictionary, reference: WeakRef) -> bool:
    for archive in description.archives:
        var files: Array=[]
        for file in description.files:
            if str(file.archive)==str(archive.file): files.append(file)
        if not await _ensure_archive(archive,files,reference): return false
    return true

func _ensure_archive(archive: Dictionary, files: Array, reference: WeakRef) -> bool:
    var key := "archive:"+str(archive.sha256)
    var waiting_since: int=Time.get_ticks_msec()
    while _pending.has(key):
        await get_tree().process_frame
        if not _alive(reference): return false
        if Time.get_ticks_msec()-waiting_since>130000:
            error_message="Не завершена совместная загрузка архива: "+str(archive.file)
            return false
    if not _alive(reference): return false
    var missing := false
    for file in files:
        if not FileAccess.file_exists(str(file.path)): missing=true;break
    if not missing: return true
    if not OS.has_feature("web"):
        error_message="Подготовленный участок отсутствует"
        return false
    _pending[key]=true
    var bytes: PackedByteArray=await _download(archive,reference)
    var success: bool=bytes.size()==int(archive.bytes) and not bytes.is_empty()
    if success:
        var writing=Budget.new(self,1500)
        for file in files:
            var path: String=str(file.path)
            var file_wait: int=Time.get_ticks_msec()
            while _pending.has(path):
                await get_tree().process_frame
                if not _alive(reference): break
                if Time.get_ticks_msec()-file_wait>130000:
                    error_message="Не завершена запись ресурса: "+path
                    success=false
                    break
            if not success: break
            if not _alive(reference): success=false;break
            if FileAccess.file_exists(path): continue
            var offset: int=int(file.offset)
            var length: int=int(file.bytes)
            if offset<0 or length<0 or offset+length>bytes.size(): success=false;break
            _pending[path]=true
            DirAccess.make_dir_recursive_absolute(path.get_base_dir())
            var partial := path+".partial"
            var output := FileAccess.open(partial,FileAccess.WRITE)
            if output==null:
                _pending.erase(path)
                success=false
                break
            for position in range(offset,offset+length,262144):
                output.store_buffer(bytes.slice(position,mini(position+262144,offset+length)))
                await writing.checkpoint()
                if not _alive(reference): break
            success=_alive(reference) and output.get_error()==OK
            output.close()
            if success: success=DirAccess.rename_absolute(partial,path)==OK
            if not success and FileAccess.file_exists(partial): DirAccess.remove_absolute(partial)
            _pending.erase(path)
            if not success: break
    _pending.erase(key)
    if not success and error_message.is_empty(): error_message="Не удалось распаковать архив: "+str(archive.file)
    return success

func _download(info: Dictionary, reference: WeakRef) -> PackedByteArray:
    var cache_key: String=str(info.sha256)
    if _archive_cache.has(cache_key):
        _archive_order.erase(cache_key)
        _archive_order.append(cache_key)
        return _archive_cache[cache_key]
    var request := HTTPRequest.new()
    var completed: Array=[]
    request.request_completed.connect(func(result: int, code: int, headers: PackedStringArray, body: PackedByteArray): completed.append([result,code,headers,body]))
    request.accept_gzip=false
    request.timeout=40.0
    request.body_size_limit=int(info.bytes)+1024
    add_child(request)
    var base: String=str(JavaScriptBridge.eval("new URL('.', window.location.href).href",true))
    var downloaded := PackedByteArray()
    for attempt in range(3):
        if not _alive(reference): break
        completed.clear()
        if request.request(base+str(info.file))!=OK:
            error_message="Не удалось запросить архив: "+str(info.file)
            continue
        var last_bytes: int=-1
        var last_change: int=Time.get_ticks_msec()
        while completed.is_empty() and _alive(reference):
            var received: int=request.get_downloaded_bytes()
            if received!=last_bytes:
                last_bytes=received
                last_change=Time.get_ticks_msec()
                var node: Node=reference.get_ref() as Node
                progress.emit(node.get_instance_id(),"Геометрия: %.1f / %.1f МБ" % [float(received)/1048576.0,float(info.bytes)/1048576.0])
            if Time.get_ticks_msec()-last_change>20000:
                error_message="Нет данных при загрузке архива: "+str(info.file)
                break
            await get_tree().process_frame
        if completed.is_empty():
            request.cancel_request()
            if not _alive(reference): break
            continue
        var reply: Array=completed[0]
        if not _alive(reference): break
        if int(reply[0])!=HTTPRequest.RESULT_SUCCESS or int(reply[1])!=200:
            error_message="Архив "+str(info.file)+" · HTTP %d, код %d" % [int(reply[1]),int(reply[0])]
            continue
        var bytes: PackedByteArray=reply[3]
        if bytes.size()!=int(info.bytes): continue
        var digest := HashingContext.new()
        digest.start(HashingContext.HASH_SHA256)
        var hashing=Budget.new(self,1500)
        for offset in range(0,bytes.size(),262144):
            digest.update(bytes.slice(offset,mini(offset+262144,bytes.size())))
            await hashing.checkpoint()
            if not _alive(reference): break
        if not _alive(reference): break
        if digest.finish().hex_encode()!=str(info.sha256): continue
        downloaded=bytes
        break
    request.queue_free()
    if downloaded.is_empty():
        if error_message.is_empty(): error_message="Не удалось загрузить архив: "+str(info.file)
    # Station fragments also share archive dependencies. Use the same bounded
    # cache as tunnel groups instead of downloading their archive repeatedly.
    elif downloaded.size()<=MAX_ARCHIVE_CACHE_BYTES:
        _trim_archives(downloaded.size())
        if _resident_bytes+_archive_bytes+downloaded.size()<=MAX_RESIDENT_BYTES:
            _archive_cache[cache_key]=downloaded
            _archive_order.append(cache_key)
            _archive_bytes+=downloaded.size()
    return downloaded

func _trim_archives(incoming: int) -> void:
    while not _archive_order.is_empty() and (_archive_bytes+incoming>MAX_ARCHIVE_CACHE_BYTES or _resident_bytes+_archive_bytes+incoming>MAX_RESIDENT_BYTES):
        var key: String=_archive_order.pop_front()
        _archive_bytes-=(_archive_cache[key] as PackedByteArray).size()
        _archive_cache.erase(key)

func release_chunk(node: Node) -> void:
    if not is_instance_valid(node): return
    release_token(int(node.get_meta("static_resource_token",0)))
    if node.has_meta("static_resource_token"): node.remove_meta("static_resource_token")

func release_token(token: int) -> void:
    if not _leases.has(token): return
    var lease: Dictionary=_leases[token]
    _leases.erase(token)
    if _consumer_tokens.has(lease.consumer): _consumer_tokens[lease.consumer].erase(token)
    _release_paths(lease.paths)

func _release_consumer(consumer_id: int) -> void:
    for token in _consumer_tokens.get(consumer_id,[]).duplicate(): release_token(int(token))
    _consumer_tokens.erase(consumer_id)
    if _consumer_tokens.is_empty():
        _archive_cache.clear()
        _archive_order.clear()
        _archive_bytes=0

func _release_paths(paths: Array) -> void:
    for path in paths:
        var count: int=int(_users.get(path,0))-1
        if count>0:
            _users[path]=count
            continue
        _users.erase(path)
        if _files.has(path): _resident_bytes-=int(_files[path].bytes)
        _files.erase(path)
        _decoded.erase(path)
        # Scene instances retain decoded Resources until disposed. Godot's cache
        # is weak; neither this service nor a PCK retains the discarded payload.
        if str(path).begins_with("user://metro-static/") and FileAccess.file_exists(path): DirAccess.remove_absolute(path)

func _alive(reference: WeakRef) -> bool:
    var node: Node=reference.get_ref() as Node
    return is_instance_valid(node) and node.is_inside_tree() and not bool(node.get_meta("static_cancelled",false))
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends Node3D
## Prepared architecture only; original dynamic scripts live in their own subtrees.
const Budget = preload("res://modules/line/build_budget.gd")
const Store = preload("res://modules/line/static_resource_store.gd")
var manifest: Dictionary = {}
var line_open := false
var static_ready := false
var static_failed := false
var static_error:=""
signal static_progress(message: String)
var _leases: Array[int]=[]
var _store: Node

func _ready() -> void:
    var work: RefCounted=get_meta("metro_line_work",null)
    var own_budget := work==null
    if own_budget:
        work=Budget.new(self,1500)
        set_meta("metro_line_work",work)
        hide()
    work.begin(self)
    _store=Store.shared(self)
    _store.progress.connect(_resource_progress)
    var chunks: Array=manifest.get("open_chunks",[]) if line_open else manifest.get("closed_chunks",[])
    var completed:=0
    if chunks.is_empty():
        static_failed=true
        static_error="В индексе станции отсутствуют фрагменты геометрии"
    for chunk in chunks:
        static_progress.emit("Геометрия станции: %d/%d" % [completed+1,chunks.size()])
        if not await work.checkpoint():
            static_failed=true
            static_error="Подготовка станции отменена"
            break
        var fragment: Node3D=await _store.instantiate_chunk(chunk,self)
        if fragment==null:
            static_failed=true
            static_error=_store.error_message
            break
        _leases.append(int(fragment.get_meta("static_resource_token",0)))
        var target: Node=get_node_or_null(NodePath(str(chunk.get("attach_parent","."))))
        if target==null:
            static_failed=true
            static_error="Не найден родитель фрагмента станции: "+str(chunk.get("attach_parent","."))
            _store.release_chunk(fragment)
            fragment.free()
            break
        # Retain original parent/name paths. Only the temporary fragment wrapper
        # is extra; it stays empty and owns the resource lease until unloading.
        var children: Array[Node]=fragment.get_children()
        add_child(fragment)
        for child in children:
            _set_subtree_owner(child,null)
            fragment.remove_child(child)
            target.add_child(child)
            _set_subtree_owner(child,self)
            if not await work.checkpoint():
                static_failed=true
                static_error="Подготовка станции отменена"
                break
        if static_failed: break
        completed+=1
    work.finish(self)
    if own_budget:
        while not work.pending.is_empty():
            if not await work.checkpoint(): return
            await get_tree().process_frame
        work.release_sources()
    if manifest.has("walking_lite"): set_meta("metro_walk_lite_data",manifest.walking_lite)
    if manifest.has("platform_navigation"): set_meta("metro_platform_navigation",manifest.platform_navigation)
    if not static_failed and int(manifest.get("walking_collision",0))>0: set_meta("metro_walk_collision",int(manifest.walking_collision))
    static_ready=not static_failed
    if own_budget and static_ready: show()

func _resource_progress(consumer_id: int, message: String) -> void:
    if consumer_id==get_instance_id(): static_progress.emit(message)

func _set_subtree_owner(node: Node, new_owner: Node) -> void:
    node.owner=new_owner
    for child in node.get_children(): _set_subtree_owner(child,new_owner)

func static_loading_complete() -> bool:
    return static_ready or static_failed

func release_static_resources() -> void:
    set_meta("static_cancelled",true)
    if is_instance_valid(_store):
        for token in _leases: _store.release_token(token)
    _leases.clear()

func _exit_tree() -> void:
    release_static_resources()
␀␀␀␀extends RefCounted
## Route-only, build-time cuts. Standalone architecture and shared source meshes
## remain intact. Both batched surfaces and MultiMesh instances use the same cut.
const TRACKS := [0.992,-11.732]

static func open_connections(station: Node3D, budget: RefCounted = null) -> Dictionary:
    var datum: Dictionary=station.get_meta("metro_line_datum",{})
    if datum.is_empty(): return {}
    var low: float=float(datum.low_local_z)
    var high: float=float(datum.high_local_z)
    var volumes: Array[Dictionary]=[]
    for x in TRACKS:
        # The line owns geometry outside these exact station boundaries.
        if bool(datum.get("trim_external_portals",false)):
            var width: float=maxf(float(datum.low_profile[0]),float(datum.high_profile[0]))+0.30
            volumes.append(_box_volume(AABB(Vector3(x-width,-0.65,low-16.0),Vector3(width*2.0,8.9,16.0)),false))
            volumes.append(_box_volume(AABB(Vector3(x-width,-0.65,high),Vector3(width*2.0,8.9,16.0)),false))
        for end in [low,high]:
            var profile: Array=datum.low_profile if end==low else datum.high_profile
            volumes.append(_opening(x,end,Vector2(float(profile[0]),float(profile[1])),datum))
    var inverse: Transform3D=station.global_transform.affine_inverse()
    var nodes: Array[Node]=station.find_children("*","GeometryInstance3D",true,false)
    var changed := 0
    for node in nodes:
        if budget!=null and not await budget.checkpoint(): return {}
        if not (node as Node3D).is_visible_in_tree(): continue
        if node is MeshInstance3D:
            var instance := node as MeshInstance3D
            if instance.mesh==null: continue
            var materials: Array[Material]=[]
            for surface in range(instance.mesh.get_surface_count()): materials.append(instance.get_active_material(surface))
            var pose: Transform3D=inverse*instance.global_transform
            var replacement: ArrayMesh=await _cut_mesh(instance.mesh,pose,materials,volumes,datum,budget)
            if replacement!=null:
                instance.mesh=replacement
                for surface in range(replacement.get_surface_count()): instance.set_surface_override_material(surface,null)
                if replacement.get_surface_count()==0: instance.hide()
                changed+=1
        elif node is MultiMeshInstance3D:
            var instance := node as MultiMeshInstance3D
            var original: MultiMesh=instance.multimesh
            if original==null or original.mesh==null: continue
            var retained: Array[int]=[]
            for i in range(original.instance_count):
                if budget!=null and not await budget.checkpoint(): return {}
                var local: Transform3D=original.get_instance_transform(i)
                var pose: Transform3D=inverse*instance.global_transform*local
                var materials: Array[Material]=[]
                for surface in range(original.mesh.get_surface_count()):
                    materials.append(instance.material_override if instance.material_override!=null else original.mesh.surface_get_material(surface))
                var replacement: ArrayMesh=await _cut_mesh(original.mesh,pose,materials,volumes,datum,budget)
                if replacement==null:
                    retained.append(i)
                    continue
                changed+=1
                if replacement.get_surface_count()==0: continue
                # Preserve instance colours/custom data as well as the transform.
                var part := MultiMeshInstance3D.new()
                part.name=str(instance.name)+"_OpenPortal%d" % i
                part.transform=instance.transform
                part.layers=instance.layers
                part.cast_shadow=instance.cast_shadow
                part.material_override=instance.material_override
                part.multimesh=_copy_instances(original,[i],replacement)
                instance.get_parent().add_child(part)
            if retained.size()!=original.instance_count:
                instance.multimesh=_copy_instances(original,retained,original.mesh)
                if retained.is_empty(): instance.hide()
    station.set_meta("line_opened_portal_meshes",changed)
    return {"low":low,"high":high,"low_profile":datum.low_profile,"high_profile":datum.high_profile}

static func _copy_instances(source: MultiMesh, indices: Array[int], mesh: Mesh) -> MultiMesh:
    var result := MultiMesh.new()
    result.transform_format=source.transform_format
    result.use_colors=source.use_colors
    result.use_custom_data=source.use_custom_data
    result.mesh=mesh
    result.instance_count=indices.size()
    for i in range(indices.size()):
        result.set_instance_transform(i,source.get_instance_transform(indices[i]))
        if source.use_colors: result.set_instance_color(i,source.get_instance_color(indices[i]))
        if source.use_custom_data: result.set_instance_custom_data(i,source.get_instance_custom_data(indices[i]))
    return result

static func _box_volume(box: AABB, cap: bool) -> Dictionary:
    var planes: Array[Plane]=[]
    for axis in range(3):
        var normal := Vector3.ZERO
        normal[axis]=1.0
        planes.append(Plane(normal,box.end[axis]))
        planes.append(Plane(-normal,-box.position[axis]))
    return {"bounds":box,"planes":planes,"cap":cap}

static func _opening(x: float, z: float, profile: Vector2, datum: Dictionary) -> Dictionary:
    var volume: Dictionary=_box_volume(AABB(Vector3(x-profile.x,-0.6,z-0.25),Vector3(profile.x*2.0,profile.y+0.6,0.5)),true)
    var shape: String=str(datum.get("portal_shape","round"))
    var spring: float=float(datum.get("portal_spring_y",2.3))
    var crown: float=float(datum.get("portal_crown_m",0.0))
    if shape=="ellipse" or crown>0.0:
        for i in range(48):
            var a: Vector2
            var b: Vector2
            if shape=="ellipse":
                var ta: float=PI-float(i)*PI/48.0
                var tb: float=PI-float(i+1)*PI/48.0
                a=Vector2(x+profile.x*cos(ta),spring+(profile.y-spring)*sin(ta))
                b=Vector2(x+profile.x*cos(tb),spring+(profile.y-spring)*sin(tb))
            else:
                var xa: float=-1.0+float(i)*2.0/48.0
                var xb: float=-1.0+float(i+1)*2.0/48.0
                a=Vector2(x+profile.x*xa,profile.y-crown*xa*xa)
                b=Vector2(x+profile.x*xb,profile.y-crown*xb*xb)
            var normal: Vector3=Vector3(a.y-b.y,b.x-a.x,0.0).normalized()
            volume.planes.append(Plane(normal,normal.dot(Vector3(a.x,a.y,z))))
    return volume

static func _cut_mesh(mesh: Mesh, pose: Transform3D, materials: Array[Material], volumes: Array[Dictionary], datum: Dictionary, budget: RefCounted) -> ArrayMesh:
    if absf(pose.basis.determinant())<0.0000000001: return null
    var bounds: AABB=pose*mesh.get_aabb()
    if not volumes.any(func(v: Dictionary): return v.bounds.grow(0.001).intersects(bounds)): return null
    var result := ArrayMesh.new()
    var lining: bool=(bounds.size.x>3.0 and bounds.size.y>3.0) or (bounds.size.z>1.0 and ((bounds.size.y>3.0 and bounds.size.x<0.5) or (bounds.size.x>3.0 and bounds.size.y<0.5)))
    var changed := false
    var inverse: Transform3D=pose.affine_inverse()
    var normal_basis: Basis=pose.basis.inverse().transposed()
    for surface in range(mesh.get_surface_count()):
        if mesh is ArrayMesh and (mesh as ArrayMesh).surface_get_primitive_type(surface)!=Mesh.PRIMITIVE_TRIANGLES: return null
        var arrays: Array=mesh.surface_get_arrays(surface)
        var vertices: PackedVector3Array=arrays[Mesh.ARRAY_VERTEX]
        var indices: PackedInt32Array=_indices(arrays,vertices.size())
        var output := SurfaceTool.new()
        output.begin(Mesh.PRIMITIVE_TRIANGLES)
        var emitted := 0
        for i in range(0,indices.size(),3):
            if i%192==0 and budget!=null and not await budget.checkpoint(): return null
            var polygon: Array[Dictionary]=[]
            for j in range(3):
                var index: int=indices[i+j]
                var vertex: Dictionary={"p":pose*vertices[index]}
                for channel in [Mesh.ARRAY_NORMAL,Mesh.ARRAY_TEX_UV,Mesh.ARRAY_TEX_UV2,Mesh.ARRAY_COLOR]:
                    if arrays[channel]!=null and not arrays[channel].is_empty(): vertex[channel]=arrays[channel][index]
                if arrays[Mesh.ARRAY_TANGENT]!=null and not arrays[Mesh.ARRAY_TANGENT].is_empty():
                    var t: PackedFloat32Array=arrays[Mesh.ARRAY_TANGENT]
                    vertex[Mesh.ARRAY_TANGENT]=Vector4(t[index*4],t[index*4+1],t[index*4+2],t[index*4+3])
                if lining and vertex.has(Mesh.ARRAY_NORMAL):
                    var n: Vector3=normal_basis*vertex[Mesh.ARRAY_NORMAL]
                    var snapped: Vector3=_snap(vertex.p,n.normalized(),datum)
                    if snapped.distance_squared_to(vertex.p)>0.00000001: changed=true;vertex.p=snapped
                polygon.append(vertex)
            var triangle_bounds: AABB=AABB(polygon[0].p,Vector3.ZERO).expand(polygon[1].p).expand(polygon[2].p)
            var face: Vector3=(polygon[1].p-polygon[0].p).cross(polygon[2].p-polygon[0].p)
            var pieces: Array=[polygon]
            for volume in volumes:
                if not volume.bounds.grow(0.001).intersects(triangle_bounds): continue
                if bool(volume.cap) and (not _cap_material(materials[surface]) or absf(face.normalized().z)<0.6 or triangle_bounds.size.y<1.5 or triangle_bounds.size.x<0.7): continue
                if not bool(volume.cap):
                    if triangle_bounds.position.x<float(volume.bounds.position.x)-0.001 or triangle_bounds.end.x>float(volume.bounds.end.x)+0.001: continue
                    var centre_x: float=float(volume.bounds.get_center().x)
                    var inner_width: float=float(volume.bounds.size.x)*0.5-0.30
                    var roof_or_end: bool=triangle_bounds.size.x>3.0 and absf(triangle_bounds.get_center().x-centre_x)<0.5
                    var side_wall: bool=triangle_bounds.size.x<0.5 and triangle_bounds.size.y>3.0 and absf(absf(triangle_bounds.get_center().x-centre_x)-inner_width)<0.30
                    if not roof_or_end and not side_wall: continue
                var next: Array=[]
                for piece in pieces:
                    var cut: Array=_subtract(piece,volume.planes)
                    if cut.size()!=1 or cut[0]!=piece: changed=true
                    next.append_array(cut)
                pieces=next
            for piece in pieces:
                for j in range(1,piece.size()-1):
                    if ((piece[j].p-piece[0].p) as Vector3).cross(piece[j+1].p-piece[0].p).length_squared()<0.000000000001: continue
                    for vertex in [piece[0],piece[j],piece[j+1]]:
                        if vertex.has(Mesh.ARRAY_NORMAL): output.set_normal((vertex[Mesh.ARRAY_NORMAL] as Vector3).normalized())
                        if vertex.has(Mesh.ARRAY_TEX_UV): output.set_uv(vertex[Mesh.ARRAY_TEX_UV])
                        if vertex.has(Mesh.ARRAY_TEX_UV2): output.set_uv2(vertex[Mesh.ARRAY_TEX_UV2])
                        if vertex.has(Mesh.ARRAY_COLOR): output.set_color(vertex[Mesh.ARRAY_COLOR])
                        if vertex.has(Mesh.ARRAY_TANGENT):
                            var t: Vector4=vertex[Mesh.ARRAY_TANGENT]
                            output.set_tangent(Plane(Vector3(t.x,t.y,t.z).normalized(),t.w))
                        output.add_vertex(inverse*vertex.p)
                        emitted+=1
        if emitted>0:
            output.index()
            output.commit(result)
            result.surface_set_material(result.get_surface_count()-1,materials[surface])
    return result if changed else null

static func _snap(point: Vector3, normal: Vector3, datum: Dictionary) -> Vector3:
    for end in [float(datum.low_local_z),float(datum.high_local_z)]:
        var profile: Array=datum.low_profile if end==float(datum.low_local_z) else datum.high_profile
        for x in TRACKS:
            if absf(point.x-x)>float(profile[0])+0.20 or absf(point.z-end)>12.0: continue
            if point.y>=0.5 and absf(point.z-end)<0.20: point.z=end
            # Some existing rectangular throats stop their side walls below
            # their roof. Close that portal seam without touching station halls.
            if str(datum.get("portal_shape","round"))=="rectangle" and absf(normal.x)>0.8 and absf(normal.y)<0.2:
                if absf(absf(point.x-x)-float(profile[0]))<0.18 and point.y>float(profile[1])-0.50 and point.y<float(profile[1]): point.y=float(profile[1])
    return point

static func _subtract(polygon: Array, planes: Array) -> Array:
    var inside: Array=polygon
    var outside: Array=[]
    for plane in planes:
        var part: Array=_clip(inside,plane,false)
        if part.size()>=3: outside.append(part)
        inside=_clip(inside,plane,true)
        if inside.size()<3: break
    return outside

static func _clip(polygon: Array, plane: Plane, keep_inside: bool) -> Array:
    var result: Array=[]
    if polygon.is_empty(): return result
    var previous: Dictionary=polygon[-1]
    var d0: float=plane.distance_to(previous.p)
    var previous_in: bool=d0<=0.0 if keep_inside else d0>0.0
    for current in polygon:
        var d1: float=plane.distance_to(current.p)
        var current_in: bool=d1<=0.0 if keep_inside else d1>0.0
        if previous_in!=current_in:
            var weight: float=d0/(d0-d1)
            var vertex: Dictionary={}
            # Position uses a String key; mesh attributes use integer keys.
            # Every stored attribute supports lerp without comparing key types.
            for key in previous:
                vertex[key]=previous[key].lerp(current[key],weight)
            result.append(vertex)
        if current_in: result.append(current)
        previous=current;d0=d1;previous_in=current_in
    return result

static func _cap_material(material: Material) -> bool:
    var opaque := material as BaseMaterial3D
    return opaque!=null and opaque.albedo_texture==null and maxf(opaque.albedo_color.r,maxf(opaque.albedo_color.g,opaque.albedo_color.b))<0.25

static func _indices(arrays: Array, count: int) -> PackedInt32Array:
    if arrays[Mesh.ARRAY_INDEX]!=null and not (arrays[Mesh.ARRAY_INDEX] as PackedInt32Array).is_empty(): return arrays[Mesh.ARRAY_INDEX]
    var result := PackedInt32Array()
    for i in range(count): result.append(i)
    return result
