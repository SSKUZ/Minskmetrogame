␀␀␀␀␀␀␀␀␀␀␀extends Control
## Three.js masterUnit / masterHandle / infoSpeaker translated into native vector UI.
## The cab owns the master value. This overlay writes only during a user drag.
var game: Node3D
var lever := 0.0
var stick := Vector2.ZERO
var flight := false
var _deck: Control
var _master: MasterConsole
var _joystick: FlightStick
var _doors: DeckButton
var _speaker: DeckButton
var _view: DeckButton
var _platform: DeckButton
var _flight: DeckButton
var _cab: Node3D
var _touch := -2
var _drag_kind := ""
var _drag_start := Vector2.ZERO
var _drag_value := 0.0
var _drag_moved := false
var _physical_held := false

class Artwork extends Control:
    var fonts: Font = ThemeDB.fallback_font
    static func gradient(colors: Array[Color]) -> GradientTexture2D:
        var ramp := Gradient.new()
        var offsets := PackedFloat32Array()
        for i in range(colors.size()): offsets.append(float(i)/float(colors.size()-1))
        ramp.offsets=offsets
        ramp.colors=PackedColorArray(colors)
        var texture := GradientTexture2D.new()
        texture.gradient=ramp
        texture.width=8; texture.height=128
        texture.fill_from=Vector2(0,0); texture.fill_to=Vector2(0,1)
        return texture
    static func panel(canvas: CanvasItem,rect: Rect2,fill: Color,border: Color,radius: int = 12,shadow: int = 0) -> void:
        var style := StyleBoxFlat.new()
        style.bg_color=fill
        style.border_color=border
        style.set_border_width_all(1)
        style.set_corner_radius_all(radius)
        style.shadow_color=Color(0,0,0,0.5)
        style.shadow_size=shadow
        style.shadow_offset=Vector2(0,3)
        canvas.draw_style_box(style,rect)
    func caption(text: String,rect: Rect2,font_size: int,color: Color) -> void:
        draw_string(fonts,Vector2(rect.position.x,rect.position.y+fonts.get_ascent(font_size)),text,HORIZONTAL_ALIGNMENT_CENTER,rect.size.x,font_size,color)

class MasterConsole extends Artwork:
    var value := 0.0
    var chrome: GradientTexture2D
    var shell: GradientTexture2D
    func _init() -> void:
        mouse_filter=Control.MOUSE_FILTER_STOP
        chrome=gradient([Color("#e0e8e9"),Color("#a4b0b2"),Color("#4e5b61"),Color("#1a2329"),Color("#444f55")])
        shell=gradient([Color("#484b4d"),Color("#181f25"),Color("#2e353a"),Color("#0b1117")])
    func _draw() -> void:
        panel(self,Rect2(Vector2.ZERO,size),Color("#20282e"),Color("#8d8275"),16,5)
        draw_texture_rect(shell,Rect2(5,18,size.x-10,size.y-36),false)
        draw_line(Vector2(13,5),Vector2(size.x-13,5),Color("#c3c8c5"),1,true)
        caption("КОНТРОЛЛЕР",Rect2(5,12,size.x-10,14),11,Color("#d8e6e8"))
        caption("МАШИНИСТА",Rect2(5,27,size.x-10,12),9,Color("#98a6ae"))
        panel(self,Rect2(35,54,20,174),Color("#080b0e"),Color("#6e7578"),9)
        draw_line(Vector2(42,59),Vector2(42,223),Color("#30383b"),3,true)
        for i in range(11):
            var y := 64.0+float(i)*15.4
            draw_line(Vector2(20,y),Vector2(28 if i != 5 else 31,y),Color("#839399"),1,true)
        draw_line(Vector2(13,141),Vector2(74,141),Color("#e0c37e"),2,true)
        caption("ТЯГА",Rect2(77,59,48,14),10,Color("#62e2a5"))
        caption("0",Rect2(77,134,48,16),12,Color("#e0c37e"))
        caption("ТОРМОЗ",Rect2(74,211,55,14),9,Color("#ff857b"))
        var y := 141.0-value*77.0
        panel(self,Rect2(16,y-10,59,31),Color("#11181d"),Color("#11181d"),10,5)
        panel(self,Rect2(40,y+13,10,18),Color("#879397"),Color("#a6b0b3"),3)
        panel(self,Rect2(14,y-14,62,29),Color("#4e5b61"),Color("#b5c2c4"),10,3)
        draw_texture_rect(chrome,Rect2(19,y-10,52,20),false)
        draw_line(Vector2(23,y-9),Vector2(67,y-9),Color("#f0f6f5"),1,true)
        for x in [30.0,36.0,42.0,48.0,54.0,60.0]:
            draw_line(Vector2(x,y+2),Vector2(x,y+7),Color(0.02,0.04,0.05,0.60),1,true)
        panel(self,Rect2(9,241,size.x-18,31),Color("#0a171c"),Color("#41575b"),7)
        var tone := Color("#62e2a5") if value > 0.0 else Color("#ff857b") if value < 0.0 else Color("#e0c37e")
        var text := "ТЯГА %d%%" % roundi(value*100) if value > 0.0 else "ТОРМОЗ %d%%" % roundi(-value*100) if value < 0.0 else "НЕЙТРАЛЬ"
        caption(text,Rect2(11,249,size.x-22,15),11,tone)
        draw_circle(Vector2(16,47),2.0,Color("#94a3a7"))
        draw_circle(Vector2(size.x-16,47),2.0,Color("#94a3a7"))

class DeckButton extends Button:
    var kind := ""
    var label := ""
    var amount := 0.0
    var selected := false
    var shade: GradientTexture2D
    var metal: GradientTexture2D
    func _init() -> void:
        focus_mode=Control.FOCUS_NONE
        mouse_filter=Control.MOUSE_FILTER_STOP
        mouse_default_cursor_shape=Control.CURSOR_POINTING_HAND
        for state in ["normal","hover","pressed","disabled","focus"]:
            add_theme_stylebox_override(state,StyleBoxEmpty.new())
        shade=Artwork.gradient([Color("#344c5d"),Color("#1b3040"),Color("#101e2b")])
        metal=Artwork.gradient([Color("#d2dbdd"),Color("#7e939c"),Color("#465e69")])
        button_down.connect(queue_redraw)
        button_up.connect(queue_redraw)
        mouse_entered.connect(queue_redraw)
        mouse_exited.connect(queue_redraw)
    func _draw() -> void:
        var held := is_pressed()
        var tint := Color("#a6c4d5") if not selected else Color("#69d9bc")
        if disabled: tint=Color("#66747b")
        Artwork.panel(self,Rect2(Vector2(0,2 if held else 0),size-Vector2(0,2)),Color("#102431"),tint,12,2 if held else 4)
        draw_texture_rect(shade,Rect2(6,10,size.x-12,size.y-20),false,Color(0.68,1.0,1.0) if held or selected else Color.WHITE)
        draw_line(Vector2(13,5),Vector2(size.x-13,5),Color(0.8,0.93,1,0.35),1,true)
        var ink := Color("#d8f5ff") if not disabled else Color("#7c898e")
        var center := Vector2(size.x*0.5,27 if size.y > 65 else 16)
        if kind == "doors": _draw_doors(center)
        elif kind == "speaker":
            var c := center+Vector2(-8,0)
            draw_colored_polygon(PackedVector2Array([c+Vector2(-9,-6),c+Vector2(-2,-6),c+Vector2(9,-15),c+Vector2(9,15),c+Vector2(-2,6),c+Vector2(-9,6)]),ink)
            draw_arc(c+Vector2(9,0),13,-0.8,0.8,16,ink,2,true)
            draw_arc(c+Vector2(9,0),20,-0.8,0.8,18,ink,2,true)
        elif kind == "flight":
            var c := center
            draw_colored_polygon(PackedVector2Array([c+Vector2(0,-11),c+Vector2(18,7),c+Vector2(3,3),c+Vector2(0,12),c+Vector2(-3,3),c+Vector2(-18,7)]),ink)
        elif kind == "platform":
            draw_rect(Rect2(center+Vector2(-19,-8),Vector2(38,5)),ink)
            for x in [-13.0,13.0]: draw_line(center+Vector2(x,-2),center+Vector2(x,10),ink,2,true)
            draw_line(center+Vector2(-22,11),center+Vector2(22,11),ink,2,true)
        else:
            Artwork.panel(self,Rect2(center+Vector2(-15,-11),Vector2(30,21)),Color("#102431"),ink,4)
            draw_line(center+Vector2(0,-9),center+Vector2(0,6),ink,1,true)
            draw_line(center+Vector2(-12,3),center+Vector2(12,3),ink,1,true)
        var font := ThemeDB.fallback_font
        var text_y := size.y-12.0
        draw_string(font,Vector2(2,text_y),label,HORIZONTAL_ALIGNMENT_CENTER,size.x-4,11,ink)
        if kind == "doors" or selected:
            draw_line(Vector2(15,size.y-5),Vector2(size.x-15,size.y-5),Color("#62e2a5") if selected or amount > 0.01 else Color("#e0c37e"),2,true)
    func _draw_doors(center: Vector2) -> void:
        var frame := Rect2(center+Vector2(-25,-20),Vector2(50,42))
        Artwork.panel(self,frame,Color("#080f14"),Color("#a6b7be"),5)
        # Actual train animation fraction, not a speculative button tween.
        var offset := amount*17.0
        for side in [-1.0,1.0]:
            var x: float=center.x+side*(10.5+offset)-9.5
            var r := Rect2(x,center.y-17,19,36)
            Artwork.panel(self,r,Color("#708792"),Color("#c7d4d8"),3)
            draw_texture_rect(metal,r.grow(-2),false)
            Artwork.panel(self,Rect2(x+4,center.y-12,11,16),Color("#102f40"),Color("#a0b7c0"),2)
            draw_line(Vector2(x+4,center.y+10),Vector2(x+15,center.y+10),Color("#d3dcd9"),2,true)

class FlightStick extends Artwork:
    var axis := Vector2.ZERO
    func _init() -> void: mouse_filter=Control.MOUSE_FILTER_STOP
    func _draw() -> void:
        var center := size*0.5
        draw_circle(center,61,Color(0.03,0.06,0.08,0.65))
        draw_arc(center,58,0,TAU,64,Color(0.65,0.76,0.80,0.7),2,true)
        draw_circle(center,44,Color(0.15,0.22,0.27,0.6))
        draw_arc(center,38,0,TAU,48,Color(0.50,0.65,0.70,0.35),1,true)
        var knob := center+axis*37
        draw_circle(knob+Vector2(0,4),23,Color(0,0,0,0.55))
        draw_circle(knob,23,Color("#8ca8b5"))
        draw_circle(knob+Vector2(0,-2),20,Color("#405e70"))
        draw_arc(knob+Vector2(0,-2),18,PI,TAU,24,Color("#c1d4dc"),2,true)

func initialize(owner: Node3D) -> void:
    game=owner
    set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
    mouse_filter=Control.MOUSE_FILTER_IGNORE
    _deck=Control.new()
    _deck.mouse_filter=Control.MOUSE_FILTER_IGNORE
    add_child(_deck)
    _master=MasterConsole.new()
    _master.name="MasterUnit"
    _master.size=Vector2(132,284)
    _deck.add_child(_master)
    _view=_button("view","САЛОН",Vector2(100,54),func(): _toggle_cabin_salon())
    _platform=_button("platform","ПЛАТФОРМА",Vector2(100,54),func(): _select_mode("platform"))
    _flight=_button("flight","ПОЛЁТ",Vector2(100,54),func(): _select_mode("flight"))
    _doors=_button("doors","ДВЕРИ",Vector2(82,86),_toggle_doors)
    _speaker=_button("speaker","INFO",Vector2(72,78),func():
        var cab := _get_cab()
        if cab != null: cab.call("command","info"))
    _joystick=FlightStick.new()
    _joystick.size=Vector2(128,128)
    _deck.add_child(_joystick)
    resized.connect(_layout)
    _layout()
    _bind_cab()

func _button(kind: String,label: String,dimensions: Vector2,action: Callable) -> DeckButton:
    var button := DeckButton.new()
    button.kind=kind; button.label=label
    button.size=dimensions
    button.tooltip_text=label
    button.pressed.connect(action)
    _deck.add_child(button)
    return button

func _layout() -> void:
    if not is_instance_valid(_deck): return
    var factor := minf(size.x/390.0,size.y/550.0)
    factor=maxf(0.1,factor)
    _deck.scale=Vector2.ONE*factor
    _deck.size=size/factor
    var bounds := _deck.size
    _master.position=Vector2(10,bounds.y-296)
    _view.position=Vector2(bounds.x-110,80)
    _platform.position=Vector2(bounds.x-110,138)
    _flight.position=Vector2(bounds.x-110,196 if _platform.visible else 138)
    _doors.position=Vector2(bounds.x-174,bounds.y-98)
    _speaker.position=Vector2(bounds.x-82,bounds.y-90)
    _joystick.position=Vector2(bounds.x-138,bounds.y-246)

func _get_cab() -> Node3D:
    if not is_instance_valid(game): return null
    return game.get("cab_runtime") as Node3D

func _bind_cab() -> void:
    var cab := _get_cab()
    if cab == _cab: return
    _cab=cab
    if is_instance_valid(_cab):
        _cab.connect("master_interaction_changed",_physical_controller_changed)
        _physical_controller_changed(bool(_cab.call("master_is_held")))

func _physical_controller_changed(held: bool) -> void:
    _physical_held=held
    if held and _drag_kind == "master": _release_pointer()
    _master.visible=not held

func physical_controller_touched() -> void: _physical_controller_changed(true)
func physical_controller_released() -> void: _physical_controller_changed(false)

func blocks_cab_pointer(point: Vector2) -> bool:
    # Physical picking runs before GUI; reserve only actual screen control bounds.
    for control in [_master,_joystick,_view,_platform,_flight,_doors,_speaker]:
        if is_instance_valid(control) and control.is_visible_in_tree():
            if control.get_global_rect().has_point(point): return true
    return false

func _local_point(point: Vector2,control: Control) -> Vector2:
    return control.get_global_transform_with_canvas().affine_inverse()*point

func _input(event: InputEvent) -> void:
    if not is_visible_in_tree() or not is_instance_valid(_master): return
    var pointer := -2
    var point := Vector2.ZERO
    var press := false
    var release := false
    var moving := false
    if event is InputEventScreenTouch:
        pointer=event.index; point=event.position
        press=event.pressed; release=not event.pressed or event.canceled
    elif event is InputEventScreenDrag:
        pointer=event.index; point=event.position; moving=true
    elif event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT:
        if event.device == -1: return # Touch already owns its real finger stream.
        pointer=-1; point=event.position; press=event.pressed; release=not event.pressed
    elif event is InputEventMouseMotion:
        if event.device == -1: return
        pointer=-1; point=event.position; moving=true
    else: return
    if press and _touch == -2:
        if _master.visible and _master.get_global_rect().has_point(point) and not _physical_held:
            _drag_kind="master"
            _drag_start=_local_point(point,_master)
            _drag_value=float(_cab.call("get_master_value")) if is_instance_valid(_cab) else 0.0
            _drag_moved=false
        elif _joystick.visible and _joystick.get_global_rect().has_point(point):
            _drag_kind="stick"
        else: return
        _touch=pointer
        if _drag_kind == "stick": _move_stick(point)
        get_viewport().set_input_as_handled()
        return
    if pointer != _touch or _drag_kind.is_empty(): return
    if release:
        _release_pointer()
    elif moving:
        if _drag_kind == "master":
            var delta := _local_point(point,_master)-_drag_start
            if _drag_moved or absf(delta.y) >= 5.0:
                _drag_moved=true
                var value := clampf(_drag_value-delta.y/77.0,-1.0,1.0)
                if is_instance_valid(_cab): _cab.call("command","master",value)
        else: _move_stick(point)
    get_viewport().set_input_as_handled()

func _move_stick(point: Vector2) -> void:
    stick=(_local_point(point,_joystick)-_joystick.size*0.5)/45.0
    if stick.length() > 1.0: stick=stick.normalized()
    _joystick.axis=stick
    _joystick.queue_redraw()

func _release_pointer() -> void:
    # Release ownership only. The cab retains the commanded master setting.
    _touch=-2
    _drag_kind=""
    stick=Vector2.ZERO
    if is_instance_valid(_joystick):
        _joystick.axis=stick
        _joystick.queue_redraw()

func _toggle_cabin_salon() -> void:
    _select_mode("salon" if str(game.get("camera_mode")) == "cabin" else "cabin")

func _select_mode(mode: String) -> void:
    if mode == "platform" and not bool(game.call("platform_camera_available")): return
    _release_pointer()
    game.call("_set_camera_mode",mode)

func _toggle_doors() -> void:
    var doors := game.get("door_system") as Node
    if not is_instance_valid(doors) or not bool(doors.get("validated")): return
    var cab := _get_cab()
    if cab == null: return
    var targets: Dictionary=doors.get("side_targets")
    # Route uses the left platform side. Never invoke request_open (both sides).
    cab.call("command","close" if bool(targets.get(-1,false)) else "openLeft")

func _process(_delta: float) -> void:
    if not is_instance_valid(game) or not is_instance_valid(_master): return
    _bind_cab()
    if is_instance_valid(_cab):
        var current := float(_cab.call("get_master_value"))
        lever=current
        if not is_equal_approx(_master.value,current):
            _master.value=current
            _master.queue_redraw()
    var mode := str(game.get("camera_mode"))
    var was_flight := flight
    flight=mode == "flight"
    _joystick.visible=flight
    if not flight and was_flight: _release_pointer()
    var available := bool(game.call("platform_camera_available"))
    if _platform.visible != available:
        _platform.visible=available
        _layout()
    var view_label := "КАБИНА" if mode == "salon" else "САЛОН"
    if _view.label != view_label:
        _view.label=view_label
        _view.queue_redraw()
    for button in [_view,_platform,_flight]:
        var active: bool=(button == _view and mode in ["cabin","salon"]) or (button == _platform and mode == "platform") or (button == _flight and flight)
        if button.selected != active:
            button.selected=active
            button.queue_redraw()
    var doors := game.get("door_system") as Node
    if is_instance_valid(doors):
        var fractions: Dictionary=doors.get("side_open")
        var amount := float(fractions.get(-1,0.0))
        if not is_equal_approx(_doors.amount,amount):
            _doors.amount=amount
            _doors.queue_redraw()
        _doors.disabled=not bool(doors.get("validated"))
    if is_instance_valid(_cab):
        var binding: Node = game.get("info_binding")
        var system: Node = binding.get("audio") if is_instance_valid(binding) else null
        var playing: bool = system != null and system.announcer.is_busy()
        if playing != _speaker.selected:
            _speaker.selected=playing
            _speaker.queue_redraw()

func _notification(what: int) -> void:
    if what == NOTIFICATION_APPLICATION_FOCUS_OUT: _release_pointer()
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends Node3D
const Behaviour = preload("res://scripts/passengers/passenger_behaviour.gd")
const Animator = preload("res://scripts/passengers/passenger_animation.gd")
var id := 0
var group_id := -1
var state := "waiting"
var space := "platform"
var walk_speed := 1.1
var radius := 0.24
var door_id := -1
var car: Node3D
var slot: Dictionary = {}
var path: Array[Vector3] = []
var animation = Animator.new()
var visual: Node3D
var clock := 0.0
var destination := 1
var wants_board := true
var navigation: RefCounted
var aisle:=Rect2()
var detour: Array[Vector3]=[]
var blocked_for:=0.0
var replan_delay:=0.0
var skeleton: Skeleton3D
var hips := -1
var pelvis_rest := Vector3.ZERO

func setup(scene: PackedScene, number: int) -> void:
    id = number
    walk_speed = 0.96 + float(number%5)*0.065
    visual = scene.instantiate()
    add_child(visual)
    animation.setup(visual,id)
    animation.play("Idle")
    process_priority=20
    for node in visual.find_children("*","Skeleton3D",true,false):
        skeleton=node
        for i in skeleton.get_bone_count():
            if str(skeleton.get_bone_name(i)).to_lower().ends_with("hips"):
                hips=i;pelvis_rest=skeleton.get_bone_global_rest(i).origin;break
        if hips>=0: break

    var behaviour := Behaviour.new()
    behaviour.name="CalmPassengerActivities"
    add_child(behaviour)
    behaviour.setup(self)

func _process(_delta: float) -> void:
    if skeleton==null or hips<0: return
    # Original chair clips move the pelvis backward. Keep the reserved bench
    # anchor at the pelvis and fit the seat height as in PassengerAnimator.
    var pelvis: Vector3=skeleton.transform*skeleton.get_bone_global_pose(hips).origin
    visual.position.x=-pelvis.x
    visual.position.z=-pelvis.z if state in ["sittingDown","seated","standingUp"] else -(pelvis.z-pelvis_rest.z)
    if state=="seated": visual.position.y=float(slot.get("height",position.y))-position.y-pelvis.y
    elif state not in ["sittingDown","standingUp"]: visual.position.y=0

func follow(points: Array[Vector3], next_state: String) -> void:
    detour.clear()
    blocked_for=0.0
    path = points
    state = next_state
    animation.play("Walk")

func step(dt: float,agents: Array,nearby: Array = []) -> bool:
    replan_delay=maxf(0,replan_delay-dt)
    if path.is_empty():return true
    var goal: Vector3=detour[0] if not detour.is_empty() else path[0]
    var offset:=goal-position
    var amount:=minf(offset.length(),walk_speed*dt)
    var desired:=position+offset.normalized()*amount
    var blocker: Node3D
    var frame:=get_parent() as Node3D
    var inverse:=frame.global_transform.affine_inverse()
    var candidates: Array=nearby if not nearby.is_empty() else agents
    for other in candidates:
        if other==self:continue
        var other_point: Vector3=inverse*other.global_position
        var center:=Vector2(other_point.x,other_point.z)
        var start:=Vector2(position.x,position.z)
        var finish:=Vector2(desired.x,desired.z)
        var clearance: float=radius+other.radius+0.025
        # Swept separation protects bodies even at a low animation rate.
        if start.distance_to(center)<clearance and (finish-start).dot(start-center)>0:continue
        if navigation.distance_to_segment(center,start,finish)<clearance:
            blocker=other;break
    var static_blocked := false
    if space=="platform" and navigation!=null and navigation.platform.has_point(Vector2(position.x,position.z)) and navigation.platform.has_point(Vector2(desired.x,desired.z)):
        static_blocked=not navigation.clear_segment(position,desired)
    if is_instance_valid(blocker) or static_blocked:
        blocked_for+=dt
        animation.play("Idle")
        var may_detour: bool=space=="platform" and navigation.platform.has_point(Vector2(path[0].x,path[0].z))
        if space=="train":
            may_detour=aisle.has_point(Vector2(position.x,position.z)) and aisle.has_point(Vector2(path[0].x,path[0].z))
        if may_detour and blocked_for>0.30 and replan_delay<=0:
            # A stable ID priority lets one head-on walker pass a waiting peer.
            var yield_time:=1.1 if is_instance_valid(blocker) and not blocker.path.is_empty() and blocker.id<id else 0.30
            if blocked_for>=yield_time:
                var people: Array=[]
                for other in agents:
                    if other==self:continue
                    var other_point: Vector3=inverse*other.global_position
                    people.append({"position":other_point,"clearance":radius+other.radius+0.07})
                var region: Rect2=navigation.platform if space=="platform" else aisle
                var replacement: Array[Vector3]=navigation.route(position,path[0],people,region,space=="platform")
                if not replacement.is_empty():detour=replacement
                replan_delay=0.7+float(id%3)*0.12
        return false
    blocked_for=0.0
    animation.play("Walk")
    position=desired
    if Vector2(offset.x,offset.z).length()>0.01:
        rotation.y=lerp_angle(rotation.y,atan2(offset.x,offset.z),minf(1,dt*7))
    if position.distance_to(goal)<0.015:
        position=goal
        if not detour.is_empty():detour.pop_front()
        if detour.is_empty() and position.distance_to(path[0])<0.02:path.pop_front()
    return path.is_empty()

func idle(dt: float, speed: float, acceleration: float) -> void:
    clock += dt
    if space=="train" and get_parent() is Node3D: car=get_parent() as Node3D
    animation.balance(dt,clock,speed,acceleration,state=="seated",space=="train" and path.is_empty())
    if state == "waiting" or state == "queued":
        animation.play("Idle")
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends RefCounted
## Existing per-door queues and seat reservations; one assignment unit per frame.
var layout: RefCounted
var navigation: RefCounted
var platform_root: Node3D
var opened := false
var exchange_active := false
var _pending: Array=[]
var _stop_offset := 0.0

func assign(agents: Array,stop_offset: float) -> void:
    _stop_offset=stop_offset
    var units: Dictionary={}
    for a in agents:
        if a.space!="platform" or not a.wants_board or a.state not in ["waiting","waitingNextTrain"]: continue
        if _pending.any(func(unit):return unit.has(a)): continue
        var key: int=a.group_id if a.group_id>=0 else -a.id-1
        if not units.has(key): units[key]=[]
        units[key].append(a)
    for group in units.values(): _pending.append(group)

func _assign_one() -> void:
    if _pending.is_empty(): return
    var group: Array=_pending.pop_front()
    var group_car: Node3D
    for a in group:
        if not is_instance_valid(a) or a.space!="platform" or not a.wants_board: continue
        var choices: Array=[]
        for d in layout.doors:
            if not layout.usable(d): continue
            var target: Vector3=platform_root.to_local(layout.landing(d,1.65))+Vector3(0,0,_stop_offset)
            var score: float=a.position.distance_to(target)+float(d.enter.size())*2.0+float(d.exit.size())*3.0
            if is_instance_valid(group_car) and d.car!=group_car: score+=12.0
            choices.append({"door":d,"score":score})
        choices.sort_custom(func(left,right):return float(left.score)<float(right.score))
        for choice in choices:
            var d: Dictionary=choice.door
            var slot: Dictionary=layout.reserve(d.car,d.marker.position.z,a.id%4!=0)
            if slot.is_empty(): continue
            var target: Vector3=_queue_point(d,d.enter.size(),a)
            var path: Array[Vector3]=navigation.route(a.position,target)
            if path.is_empty(): layout.release(slot);continue
            group_car=d.car
            a.set_meta("queue_target",target)
            a.slot=slot
            a.door_id=d.id
            a.car=d.car
            a.follow(path,"queueing")
            d.enter.append(a)
            break
        # If capacity is temporarily reserved, the line retries unassigned
        # waiters after alighters have cleared. No extra passenger is admitted.

func _queue_point(d: Dictionary, rank: int, exclude: Node3D=null) -> Vector3:
    var result:=Vector3.ZERO
    for attempt in range(32):
        var place: int=rank+attempt
        var point: Vector3=layout.landing(d,1.65+float(int(place/2))*0.35)
        point+=d.car.global_basis.z.normalized()*(-1.0 if place%2==0 else 1.0)*(1.4+float(int(place/2))*0.7)
        point=platform_root.to_local(point)+Vector3(0,0,_stop_offset)
        result=navigation.free_point(point)
        var occupied:=false
        for other in layout.doors:
            for person in other.enter:
                if person==exclude: continue
                var target: Vector3=person.get_meta("queue_target",person.position)
                if target.distance_squared_to(result)<0.31: occupied=true;break
            if occupied: break
        if not occupied: return result
    return result

func cancel_waiters() -> void:
    _pending.clear()
    for d in layout.doors:
        for a in d.enter.duplicate():
            if a==d.active or a.space!="platform": continue
            layout.release(a.slot)
            a.slot={}
            a.path.clear();a.detour.clear()
            a.state="waiting"
            a.door_id=-1
            a.car=null
            a.animation.play("Idle")
            d.enter.erase(a)

func request_alight(agents: Array) -> void:
    for a in agents:
        if a.space!="train" or a.state not in ["riding","seated"]: continue
        var nearest: Dictionary={}
        var distance:=INF
        for d in layout.doors:
            if d.car!=a.car or not layout.usable(d): continue
            var score: float=absf(a.position.z-d.marker.position.z)+float(d.exit.size())
            if score<distance: distance=score;nearest=d
        # A car beyond the platform cannot discharge onto the track. Keep its
        # riders/reservations until a real door in that car becomes accessible.
        if nearest.is_empty(): continue
        a.door_id=nearest.id
        nearest.exit.append(a)
        if a.state=="seated":
            a.state="standingUp";a.animation.play("Stand up (chair)",false)
        else: a.state="exitQueued"

func can_step(a: Node3D) -> bool:
    var d: Dictionary=layout.door(a.door_id)
    return not d.is_empty() and layout.usable(d)

func update(agents: Array,can_exchange: bool) -> void:
    if not can_exchange:
        exchange_active=false
        return
    if not exchange_active:
        refresh_waiting_bays()
        exchange_active=true
    opened=true
    _assign_one()
    for d in layout.doors:
        var active=d.active
        if active!=null:
            if not layout.usable(d): continue
            if active.path.is_empty():
                if active.state=="boarding":
                    active.reparent(d.car,true)
                    active.space="train"
                    active.aisle=layout.aisle_bounds(d.car)
                    d.enter.erase(active);d.active=null
                    settle(active,d,agents)
                elif active.state=="alighting":
                    layout.release(active.slot)
                    active.reparent(platform_root,true)
                    active.space="platform"
                    active.slot={}
                    active.visual.position=Vector3.ZERO
                    active.wants_board=false
                    var out: Vector3=navigation.free_point(active.position+layout.outward(d)*0.8+d.car.global_basis.z.normalized()*1.7)
                    active.follow(navigation.route(active.position,out),"leaving")
                    if active.path.is_empty(): active.state="waitingNextTrain";active.animation.play("Idle")
                    d.exit.erase(active);d.active=null
            continue
        if not layout.usable(d): continue
        # Alighters have priority across the entire car, including passengers
        # still standing up, so boarders cannot occupy their route to the aisle.
        var car_exiting: bool=layout.doors.any(func(other):return other.car==d.car and (not other.exit.is_empty() or (other.active!=null and other.active.state=="alighting")))
        if not d.exit.is_empty():
            var a=d.exit[0]
            if a.state!="exitQueued": continue
            var seam: Vector3=d.marker.position
            var outside: Vector3=d.car.to_local(layout.landing(d))
            var path: Array[Vector3]=[Vector3(free_aisle_x(d.car,a.position.z,agents),a.position.y,a.position.z),Vector3(0,seam.y,seam.z),seam,outside]
            a.follow(path,"alighting");d.active=a
        elif not car_exiting and not d.enter.is_empty():
            var a=d.enter[0]
            if a.state!="queued" or a.slot.is_empty(): continue
            var approach: Vector3=platform_root.to_local(layout.landing(d))
            var path: Array[Vector3]=navigation.route(a.position,approach)
            if path.is_empty(): continue
            path.append(platform_root.to_local(d.marker.global_position))
            path.append(platform_root.to_local(d.car.to_global(Vector3(float(d.side)*0.35,d.marker.position.y,d.marker.position.z))))
            a.follow(path,"boarding");d.active=a

func settle(a: Node3D,d: Dictionary,agents: Array) -> void:
    if a.slot.is_empty(): a.slot=layout.reserve(d.car,a.position.z,a.id%4!=0)
    a.aisle=layout.aisle_bounds(d.car)
    if a.slot.is_empty(): a.state="riding";a.animation.play("Idle");return
    var point: Vector3=a.slot.position
    var path: Array[Vector3]=[Vector3(free_aisle_x(d.car,a.position.z,agents),a.position.y,a.position.z),Vector3(free_aisle_x(d.car,point.z,agents),point.y,point.z),point]
    a.follow(path,"settling")

func complete(agents: Array) -> bool:
    if not opened or not _pending.is_empty(): return false
    for d in layout.doors:
        if d.active!=null or not d.enter.is_empty() or not d.exit.is_empty(): return false
    for a in agents:
        if a.state in ["boarding","alighting","queueing","queued","settling","sittingDown","standingUp","exitQueued"]: return false
    return true

func refresh_waiting_bays() -> void:
    for d in layout.doors:
        var rank:=0
        for a in d.enter:
            if a==d.active or a.space!="platform": continue
            var point: Vector3=_queue_point(d,rank,a)
            a.set_meta("queue_target",point)
            var path: Array[Vector3]=navigation.route(a.position,point)
            if not path.is_empty(): a.follow(path,"queueing")
            rank+=1

func free_aisle_x(car: Node3D,z: float,agents: Array) -> float:
    for other in agents:
        if other.space=="train" and other.car==car and other.state=="riding" and other.path.is_empty() and absf(other.position.z-z)<0.7 and absf(other.position.x)<0.65:
            return -signf(other.position.x)*0.35
    return 0.0
␀␀␀extends Node3D
const Spawner=preload("res://scripts/passengers/passenger_spawner.gd")
const Layout=preload("res://scripts/passengers/passenger_train_adapter.gd")
const Navigation=preload("res://scripts/passengers/passenger_navigation.gd")
const Boarding=preload("res://scripts/passengers/passenger_boarding.gd")
@export_range(0,200) var passenger_count := 18
@export_range(0,200) var boarding_count := 18
var agents: Array=[]
var layout=Layout.new()
var navigation=Navigation.new()
var spawner=Spawner.new()
var boarding=Boarding.new()
var clock := 0.0
var speed := 0.0
var acceleration := 0.0
var exchange_enabled := false

func configure(train: Node3D,doors: Node,stop_offset: float,obstacles: Array[Rect2]) -> void:
    layout.configure(train,doors)
    navigation.obstacles=obstacles
    agents=spawner.spawn(self,passenger_count,navigation,layout.doors)
    for a in agents:
        a.navigation=navigation
        a.wants_board=a.id<boarding_count
        if not a.wants_board:a.position.x=-3.3-float(a.id%2)*0.7
    boarding.layout=layout;boarding.navigation=navigation;boarding.platform_root=self
    boarding.assign(agents,stop_offset)

func request_alight() -> void:
    boarding.request_alight(agents)

func complete() -> bool:
    return boarding.complete(agents)

func simulation_agents() -> Array:
    return agents

func _physics_process(delta: float) -> void:
    var dt:=minf(delta,0.1)
    clock+=dt
    var active: Array=simulation_agents()
    # Conservative world-space broad phase. Preserve the complete crowd for
    # route replanning, but sweep only nearby bodies for each walking step.
    var cells: Dictionary={}
    for person in active:
        var p: Vector3=person.global_position
        var cell := Vector2i(floori(p.x/1.5),floori(p.z/1.5))
        if not cells.has(cell): cells[cell]=[]
        cells[cell].append(person)
    for a in active:
        a.idle(dt,speed,acceleration)
        if a.state=="standingUp" and a.animation.finished():
            a.visual.position=Vector3.ZERO
            a.state="exitQueued";a.animation.play("Idle")
        elif a.state=="sittingDown" and a.animation.finished():
            a.state="seated";a.animation.play("Sit idle (chair)")
        if a.path.is_empty(): continue
        # Closed doors pause only doorway crossing, waiting people may still stroll.
        if a.state in ["boarding","alighting"] and (not exchange_enabled or not boarding.can_step(a)): continue
        var p: Vector3=a.global_position
        var cell := Vector2i(floori(p.x/1.5),floori(p.z/1.5))
        var nearby: Array=[]
        for dx in range(-2,3):
            for dz in range(-2,3): nearby.append_array(cells.get(cell+Vector2i(dx,dz),[]))
        if not a.step(dt,active,nearby): continue
        match a.state:
            "queueing":a.state="queued";a.animation.play("Idle")
            "settling":
                if a.slot.get("seated",false):
                    a.rotation.y=a.slot.heading
                    a.state="sittingDown";a.animation.play("Sit down (chair)",false)
                else:a.state="riding";a.animation.play("Idle")
            "leaving":a.state="waitingNextTrain";a.animation.play("Idle")
    boarding.update(active,exchange_enabled)

func doors_clear() -> bool:
    for d in layout.doors:
        if d.active!=null:return false
    for a in agents:
        if a.state in ["boarding","alighting","returning"]:return false
    return true
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends RefCounted
## Static furniture and dynamic body discs share one bounded visibility graph.
var obstacles: Array[Rect2]=[]
var platform:=Rect2(-10.0,-11.0,9.1,101.0)
var platform_area:=platform
var height := 1.1805

func read_station(root: Node3D, budget: RefCounted, fallback: Rect2) -> void:
    platform_area=fallback
    var slab := root.find_child("IslandPlatform",true,false) as MeshInstance3D
    if slab!=null and slab.mesh!=null:
        var box: AABB=slab.global_transform*slab.get_aabb()
        platform_area=Rect2(box.position.x,box.position.z,box.size.x,box.size.z)
        height=box.end.y
    platform=platform_area.grow(-0.30)
    for node in root.find_children("*","CollisionShape3D",true,false):
        var collider:=node as CollisionShape3D
        if not await budget.checkpoint(): return
        if collider.disabled or collider.shape==null: continue
        var size:=Vector3.ZERO
        if collider.shape is BoxShape3D: size=collider.shape.size
        elif collider.shape is CylinderShape3D: size=Vector3((collider.shape as CylinderShape3D).radius*2.0,(collider.shape as CylinderShape3D).height,(collider.shape as CylinderShape3D).radius*2.0)
        elif collider.shape is CapsuleShape3D: size=Vector3((collider.shape as CapsuleShape3D).radius*2.0,(collider.shape as CapsuleShape3D).height,(collider.shape as CapsuleShape3D).radius*2.0)
        elif collider.shape is SphereShape3D: size=Vector3.ONE*collider.shape.radius*2.0
        if size!=Vector3.ZERO: _add_box(collider.global_transform*AABB(-size*0.5,size))
    for node in root.find_children("*","GeometryInstance3D",true,false):
        if not await budget.checkpoint(): return
        if not (node as Node3D).is_visible_in_tree(): continue
        if node is MultiMeshInstance3D:
            var multi: MultiMesh=node.multimesh
            if multi==null or multi.mesh==null: continue
            var count: int=multi.instance_count if multi.visible_instance_count<0 else mini(multi.instance_count,multi.visible_instance_count)
            for i in range(count):
                if i%32==0 and not await budget.checkpoint(): return
                var pose: Transform3D=node.global_transform*multi.get_instance_transform(i)
                _add_box(pose*multi.mesh.get_aabb())
        elif node is MeshInstance3D and node.mesh!=null:
            var mesh: Mesh=node.mesh
            var pose: Transform3D=node.global_transform
            var box: AABB=pose*mesh.get_aabb()
            if not _intersects_walkway(box): continue
            if box.size.x<8.0 and box.size.z<18.0:
                _add_box(box)
                continue
            # Static stations batch columns/furniture into larger meshes. Read
            # body-height triangle footprints once, with the existing frame budget.
            for surface in range(mesh.get_surface_count()):
                var arrays: Array=mesh.surface_get_arrays(surface)
                var vertices: PackedVector3Array=arrays[Mesh.ARRAY_VERTEX]
                var indices: PackedInt32Array=arrays[Mesh.ARRAY_INDEX] if arrays[Mesh.ARRAY_INDEX]!=null else PackedInt32Array()
                var count: int=indices.size() if not indices.is_empty() else vertices.size()
                for i in range(0,count,3):
                    if i%192==0 and not await budget.checkpoint(): return
                    var a: Vector3=pose*vertices[indices[i] if not indices.is_empty() else i]
                    var b: Vector3=pose*vertices[indices[i+1] if not indices.is_empty() else i+1]
                    var c: Vector3=pose*vertices[indices[i+2] if not indices.is_empty() else i+2]
                    _add_box(AABB(a,Vector3.ZERO).expand(b).expand(c))

func _intersects_walkway(box: AABB) -> bool:
    return box.end.y>height+0.15 and box.position.y<height+1.65 and platform_area.intersects(Rect2(box.position.x,box.position.z,box.size.x,box.size.z).grow(0.02))

func _add_box(box: AABB) -> void:
    if not _intersects_walkway(box) or box.size.x>8.0 or box.size.z>18.0: return
    var shape:=Rect2(box.position.x,box.position.z,maxf(box.size.x,0.02),maxf(box.size.z,0.02))
    for i in range(obstacles.size()-1,-1,-1):
        if not obstacles[i].grow(0.06).intersects(shape): continue
        var combined: Rect2=shape.merge(obstacles[i])
        if combined.size.x>8.0 or combined.size.y>18.0: continue
        shape=combined
        obstacles.remove_at(i)
    obstacles.append(shape)

func free_point(point: Vector3) -> Vector3:
    point.x=clampf(point.x,platform.position.x,platform.end.x-0.001)
    point.z=clampf(point.z,platform.position.y,platform.end.y-0.001)
    point.y=height
    if not obstacles.any(func(o: Rect2): return o.grow(0.34).has_point(Vector2(point.x,point.z))): return point
    var nearest:=point
    var best:=INF
    for radius in range(1,11):
        for direction in range(16):
            var angle: float=float(direction)*TAU/16.0
            var candidate:=point+Vector3(cos(angle),0,sin(angle))*float(radius)*0.35
            if not platform.has_point(Vector2(candidate.x,candidate.z)): continue
            if obstacles.any(func(o: Rect2): return o.grow(0.34).has_point(Vector2(candidate.x,candidate.z))): continue
            var distance: float=point.distance_squared_to(candidate)
            if distance<best: best=distance;nearest=candidate
        if is_finite(best): return nearest
    return nearest


static func distance_to_segment(p: Vector2,a: Vector2,b: Vector2) -> float:
    var delta:=b-a
    var t:=clampf((p-a).dot(delta)/maxf(delta.length_squared(),0.000001),0,1)
    return p.distance_to(a+delta*t)

func clear_segment(a: Vector3,b: Vector3,people: Array=[],use_static: bool=true) -> bool:
    var start:=Vector2(a.x,a.z)
    var finish:=Vector2(b.x,b.z)
    if use_static:
        for shape in obstacles:
            var box:=shape.grow(0.32)
            if box.has_point(start) or box.has_point(finish):return false
            var corners: Array[Vector2]=[box.position,Vector2(box.end.x,box.position.y),box.end,Vector2(box.position.x,box.end.y)]
            for i in range(4):
                if Geometry2D.segment_intersects_segment(start,finish,corners[i],corners[(i+1)%4])!=null:return false
    for person in people:
        var center:=Vector2(person.position.x,person.position.z)
        var clearance: float=person.clearance
        # An agent already close to someone may back away without teleporting.
        if start.distance_to(center)<clearance and (finish-start).dot(start-center)>=0:continue
        if distance_to_segment(center,start,finish)<clearance:return false
    return true

func route(a: Vector3,b: Vector3,people: Array=[],region: Rect2=Rect2(),use_static: bool=true) -> Array[Vector3]:
    var bounds:=platform if region.size==Vector2.ZERO else region
    if not bounds.has_point(Vector2(b.x,b.z)): return []
    if clear_segment(a,b,people,use_static):return [b]
    var nodes: Array[Vector3]=[a,b]
    if use_static:
        var corridor:=Rect2(Vector2(a.x,a.z),Vector2.ZERO).expand(Vector2(b.x,b.z)).grow(1.6)
        for shape in obstacles:
            if not shape.intersects(corridor):continue
            var box:=shape.grow(0.38)
            for point in [box.position,Vector2(box.end.x,box.position.y),box.end,Vector2(box.position.x,box.end.y)]:
                if bounds.has_point(point):nodes.append(Vector3(point.x,a.y,point.y))
    var nearby: Array=people.filter(func(person):return distance_to_segment(Vector2(person.position.x,person.position.z),Vector2(a.x,a.z),Vector2(b.x,b.z))<float(person.clearance)+0.25)
    nearby.sort_custom(func(left,right):return a.distance_squared_to(left.position)<a.distance_squared_to(right.position))
    for person in nearby.slice(0,6):
        var center: Vector3=person.position
        var radius: float=float(person.clearance)/cos(PI/8.0)+0.035
        for i in range(8):
            var angle:=float(i)*TAU/8.0
            var point:=Vector3(center.x+cos(angle)*radius,a.y,center.z+sin(angle)*radius)
            if bounds.has_point(Vector2(point.x,point.z)):nodes.append(point)
    var costs: Array[float]=[]
    var previous: Array[int]=[]
    var visited: Array[bool]=[]
    for i in nodes.size():costs.append(INF);previous.append(-1);visited.append(false)
    costs[0]=0.0
    for iteration in nodes.size():
        var best: int=-1
        for i in nodes.size():
            if not visited[i] and (best<0 or costs[i]<costs[best]):best=i
        if best<0 or costs[best]==INF:break
        if best==1:break
        visited[best]=true
        for i in nodes.size():
            if visited[i] or not clear_segment(nodes[best],nodes[i],people,use_static):continue
            var cost:=costs[best]+nodes[best].distance_to(nodes[i])
            if cost<costs[i]:costs[i]=cost;previous[i]=best
    var result: Array[Vector3]=[]
    if costs[1]==INF:return result
    var index:=1
    while index!=0:result.push_front(nodes[index]);index=previous[index]
    return result
␀␀␀␀␀␀␀␀extends RefCounted
const Agent = preload("res://scripts/passengers/passenger_agent.gd")
const LIBRARY := "res://assets/passengers/manifest.json"
# Explicit original resources let the existing pack planner retain every model.
const MODELS := ["res://assets/passengers/boy-low.glb","res://assets/passengers/elder-man-low.glb","res://assets/passengers/elder-woman-low.glb","res://assets/passengers/girl-low.glb","res://assets/passengers/man-casual-low.glb","res://assets/passengers/man-hoodie-low.glb","res://assets/passengers/man-jacket-low.glb","res://assets/passengers/man-shirt-low.glb","res://assets/passengers/woman-coat-low.glb","res://assets/passengers/woman-longhair-low.glb","res://assets/passengers/woman-skirt-low.glb","res://assets/passengers/woman-suit-low.glb"]
var cache: Dictionary = {}

func spawn(parent: Node3D,count: int,navigation: RefCounted,available_doors: Array) -> Array:
    var result: Array=[]
    for i in count: result.append(spawn_one(parent,i,count,navigation,available_doors))
    finish_groups(result)
    return result

var _variants: Array = []

func spawn_one(parent: Node3D,i: int,count: int,navigation: RefCounted,available_doors: Array,stable_id: int=-1) -> Node3D:
    if _variants.is_empty():
        var manifest: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(LIBRARY))
        _variants=manifest.models.filter(func(m):return str(m.file).ends_with("-low.glb"))
    var variants: Array=_variants
    var filename: String=variants[i%variants.size()].file
    if not cache.has(filename): cache[filename]=load("res:/" + "/assets/passengers/"+filename)
    var a=Agent.new()
    a.name="Passenger%02d"%i
    parent.add_child(a)
    a.setup(cache[filename],stable_id if stable_id>=0 else i)
    # Adjacent companions share a door and remain together in one car.
    a.group_id=int(i/2) if i%6<2 else -1
    var z := 3.0+float(i)*73.0/maxf(1,count-1)
    var point := Vector3(-2.0-float(i%2)*0.7,1.1805,z)
    point=navigation.free_point(point)
    a.position=point
    return a

func finish_groups(result: Array) -> void:
    for a in result:
        if a.group_id<0: continue
        var companions: Array=result.filter(func(b):return b.group_id==a.group_id)
        var slowest: float=a.walk_speed
        for b in companions: slowest=minf(slowest,b.walk_speed)
        for b in companions:
            b.walk_speed=slowest
            for peer in companions:
                if peer!=b:
                    b.set_meta("social_peer",weakref(peer))
                    break
␀␀␀extends RefCounted
## PassengerLayout: original GLB geometry -> reusable car/door/place contract.
var doors: Array[Dictionary] = []
var places: Array[Dictionary] = []
var cars: Array[Node3D] = []
var controller: Node
var platform_selected := false
var platform_area := Rect2()
var platform_height := 1.1805

func configure(train: Node3D,door_controller: Node) -> void:
    controller=door_controller
    doors.clear();places.clear();cars.clear()
    for car in train.get_children():
        if not str(car.name).begins_with("OriginalV106Car"): continue
        cars.append(car)
        var seams: Dictionary = {}
        for leaf in controller.leaves:
            var moving: Node3D = leaf.parts[0].node
            if not car.is_ancestor_of(moving): continue
            var center: Vector3 = leaf.center
            var seam: float = leaf.seam
            var side: int=-1 if center.x<0.0 else 1
            var key := "%d:%d" % [side,roundi(seam*100)]
            if seams.has(key): continue
            seams[key]=true
            var marker := Marker3D.new()
            marker.name="PassengerDoor%02d" % doors.size()
            car.add_child(marker)
            marker.position=Vector3(center.x,1.033,seam)
            doors.append({"id":doors.size(),"car":car,"marker":marker,"enter":[],"exit":[],"active":null,"side":side,"available":side<0})
        # Upholstery is one merged mesh spanning both benches in the source
        # GLBs. Read anchors extracted from its actual horizontal cushion faces.
        var catalog: Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://modules/passengers/v106_seats.json"))
        var original: Dictionary=catalog.cars.get(str(car.name),{})
        for seat in original.get("seats",[]):
            var xyz: Array=seat.position
            var p:=Vector3(float(xyz[0]),float(xyz[1]),float(xyz[2]))
            if not clear_door(car,p,0.80):continue
            places.append({"car":car,"position":p,"height":float(seat.height),"seated":true,"used":false,"heading":float(seat.heading)})
        var car_doors: Array = doors.filter(func(d):return d.car==car and int(d.side)<0)
        car_doors.sort_custom(func(a,b):return a.marker.position.z<b.marker.position.z)
        for i in range(car_doors.size()-1):
            var z: float=(car_doors[i].marker.position.z+car_doors[i+1].marker.position.z)*0.5
            for side in [-1.0,1.0]:
                places.append({"car":car,"position":Vector3(side*0.42,1.033,z),"height":1.033,"seated":false,"used":false,"heading":0.0,"grip":_handrail_grip(car,Vector3(side*0.42,1.033,z))})

func clear_door(car: Node3D,p: Vector3,margin: float) -> bool:
    for d in doors:
        if d.car==car and absf(p.z-d.marker.position.z)<margin: return false
    return true

func select_platform(area: Rect2, height: float, navigation: RefCounted=null) -> int:
    platform_selected=true
    platform_area=area
    platform_height=height
    var count := 0
    for d in doors:
        var point: Vector3=landing(d)
        var along: Vector3=d.car.global_basis.z.normalized()*0.70
        d.available=absf(d.marker.global_position.y-height)<0.6 and area.has_point(Vector2(point.x+along.x,point.z+along.z)) and area.has_point(Vector2(point.x-along.x,point.z-along.z))
        if d.available and navigation!=null:
            d.available=navigation.clear_segment(point,landing(d,0.80))
        if d.available: count+=1
    return count

func outward(d: Dictionary) -> Vector3:
    var axis: Vector3=d.car.global_basis.x*float(d.side)
    axis.y=0.0
    return axis.normalized()

func landing(d: Dictionary, distance: float=1.15) -> Vector3:
    var point: Vector3=d.marker.global_position+outward(d)*distance
    point.y=platform_height
    return point

func usable(d: Dictionary, require_open: bool=true) -> bool:
    if not bool(d.get("available",true)): return false
    return not require_open or (is_instance_valid(controller) and float(controller.side_open[int(d.get("side",-1))])>=0.99)

func door(id: int) -> Dictionary:
    return doors[id] if id>=0 and id<doors.size() else {}

func reserve(car: Node3D,near_z: float,seated: bool) -> Dictionary:
    for preference in [seated,not seated]:
        var candidates: Array=[]
        for place in places:
            if place.car!=car or place.used or bool(place.seated)!=preference: continue
            var blocked := false
            for other in places:
                if other.car!=car or not other.used: continue
                if preference:
                    blocked=not other.seated and signf(other.position.x)==signf(place.position.x) and absf(other.position.z-place.position.z)<0.7
                else:
                    blocked=(not other.seated and absf(other.position.z-place.position.z)<0.9) or (other.seated and signf(other.position.x)==signf(place.position.x) and absf(other.position.z-place.position.z)<0.7)
                if blocked: break
            if not blocked: candidates.append(place)
        candidates.sort_custom(func(a,b):return absf(a.position.z-near_z)<absf(b.position.z-near_z))
        if not candidates.is_empty():
            candidates[0].used=true
            return candidates[0]
    return {}

func release(slot: Dictionary) -> void:
    if not slot.is_empty(): slot.used=false

func aisle_bounds(car: Node3D) -> Rect2:
    var lo:=INF
    var hi:=-INF
    for d in doors:
        if d.car==car:
            lo=minf(lo,d.marker.position.z);hi=maxf(hi,d.marker.position.z)
    for p in places:
        if p.car==car:
            lo=minf(lo,p.position.z);hi=maxf(hi,p.position.z)
    return Rect2(-0.43,lo-0.3,0.86,hi-lo+0.6)

func _handrail_grip(car: Node3D,place: Vector3) -> Vector3:
    var nearest := Vector3(place.x,2.20,place.z)
    var score := INF
    for node in car.find_children("*","MeshInstance3D",true,false):
        var mesh := node as MeshInstance3D
        if mesh.mesh==null: continue
        var box: AABB=car.global_transform.affine_inverse()*mesh.global_transform*mesh.get_aabb()
        var center := box.get_center()
        if absf(center.x)>1.25 or center.y<1.7 or center.y>2.9: continue
        var vertical := box.size.y>0.65 and box.size.x<0.16 and box.size.z<0.16
        var longitudinal := box.size.z>0.8 and box.size.x<0.16 and box.size.y<0.16
        if not vertical and not longitudinal: continue
        var target := Vector3(center.x,clampf(2.20,box.position.y,box.end.y),clampf(place.z,box.position.z,box.end.z))
        var distance := Vector3(place.x,2.20,place.z).distance_squared_to(target)
        if distance<score: score=distance;nearest=target
    return nearest
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀