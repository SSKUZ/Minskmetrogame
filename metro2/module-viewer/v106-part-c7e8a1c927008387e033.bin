t_colors.append(material.albedo_color)
            _pilot_materials.append(material)
            mesh.material_override = material
    for id in ["Gauge_кВ_Needle","Gauge_кА_Needle"]:
        var needle := model.find_child(id,true,false) as Node3D
        if needle != null: _gauge_needles.append(needle)
    var radio := model.find_child("RadioConsole",true,false) as Node3D
    _radio_readout = Label3D.new()
    _radio_readout.position = Vector3(0.02,-0.25,0.075)
    _radio_readout.pixel_size = 0.00045
    _radio_readout.font_size = 20
    _radio_readout.modulate = Color(0.6,0.9,0.5)
    _radio_readout.layers = 2
    radio.add_child(_radio_readout)
    if _speed_segments.size() != 14 or _pilot_materials.size() != 10 or _gauge_needles.size() != 2:
        push_error("Cab instrument attachment mismatch: segments=%d lamps=%d needles=%d" % [_speed_segments.size(),_pilot_materials.size(),_gauge_needles.size()])
    _readout = Label3D.new()
    _readout.font_size = 28
    _readout.pixel_size = 0.0007
    _readout.position = Vector3(0.3,1.11,1.05)
    _readout.rotation.x = -0.1
    _readout.modulate = Color(0.7,1.0,0.55)
    _readout.layers = 2
    model.add_child(_readout)

func _update_instruments() -> void:
    var speed := float(game.get("speed"))*3.6
    var number := 88 if lamp_test else mini(99,roundi(speed))
    var bits := [0x3f,0x06,0x5b,0x4f,0x66,0x6d,0x7d,0x07,0x7f,0x6f]
    for index in range(_speed_segments.size()):
        var digit := int(number/10) if index < 7 else number%10
        var on := (int(bits[digit]) & (1 << (index%7))) != 0
        var material := _speed_segments[index].material_override as BaseMaterial3D
        material.albedo_color = Color(0.65,0.88,0.13) if on else Color(0.018,0.027,0.012)
        material.emission_enabled = on
        material.emission = Color(0.4,0.65,0.08)
    var moving_doors := float(doors.get("openness")) > 0.001 and float(doors.get("openness")) < 0.999
    var statuses := [traction_actual > 0.0,false,applied_brake > 0.01,false,traction_actual == 0.0 and applied_brake < 0.01,false,bool(doors.get("target_open")),moving_doors,bool(doors.call("can_move")),false]
    for index in range(_pilot_materials.size()):
        var on: bool = lamp_test or (index < statuses.size() and bool(statuses[index]))
        _pilot_materials[index].albedo_color = _pilot_colors[index] if on else Color(0.035,0.04,0.035)
        _pilot_materials[index].emission_enabled = true
        _pilot_materials[index].emission = _pilot_colors[index]
        _pilot_materials[index].emission_energy_multiplier = 0.9 if on else 0.02
    for index in range(_gauge_needles.size()):
        var fraction := 0.0 # Original electrical instruments explicitly say НЕТ ДАННЫХ.
        _gauge_needles[index].rotation.z = -PI*0.75+PI*1.5*clampf(fraction,0.0,1.0)
    _radio_readout.visible = false
    _radio_readout.text = radio_channel+" · "+("ПЕРЕДАЧА" if radio_tx else "ВЫЗОВ" if radio_call else "ПРИЁМ")
    _readout.visible = false # Preserve original panel lettering; screen HUD carries game status.


func _install_audio() -> void:
    _horn = AudioStreamPlayer.new()
    _radio = AudioStreamPlayer.new()
    add_child(_horn)
    add_child(_radio)
    _horn.stream = _tone(330.0,0.45,true)
    # Radio controls cannot replay a station announcement from another route.

func _tone(frequency: float, seconds: float, loop: bool) -> AudioStreamWAV:
    var stream := AudioStreamWAV.new()
    stream.format = AudioStreamWAV.FORMAT_16_BITS
    stream.mix_rate = 22050
    var samples := int(seconds*22050.0)
    var bytes := PackedByteArray()
    bytes.resize(samples*2)
    for i in range(samples):
        var t := float(i)/22050.0
        var envelope := minf(1.0,float(mini(i,samples-1-i))/220.0)
        bytes.encode_s16(i*2,int((sin(t*frequency*TAU)+sin(t*440.0*TAU))*2300.0*envelope))
    stream.data = bytes
    if loop:
        stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
        stream.loop_end = samples
    return stream

func _make_video() -> Dictionary:
    var viewport := SubViewport.new()
    viewport.size = Vector2i(256,512)
    viewport.world_3d = get_world_3d()
    viewport.render_target_update_mode = SubViewport.UPDATE_DISABLED
    viewport.transparent_bg = false
    add_child(viewport)
    var camera := Camera3D.new()
    camera.cull_mask = 1
    camera.fov = 48.0
    camera.far = 120.0
    camera.near = 0.08
    viewport.add_child(camera)
    camera.current = true
    var material := StandardMaterial3D.new()
    material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
    material.albedo_texture = viewport.get_texture()
    material.uv1_scale = Vector3(-1,1,1)
    material.uv1_offset = Vector3(1,0,0)
    return {"viewport":viewport,"camera":camera,"material":material}

func _install_video(lead: Node3D) -> void:
    _install_car_mirrors(lead,false)
    # The original fourth GLB has a reversed, translated cab frame. Work in
    # its authored local coordinates instead of applying head-car coordinates.
    var rear := (game.get("train") as Node3D).get_node("OriginalV106Car04") as Node3D
    var housing := rear.find_child("mirror-right",true,false) as MeshInstance3D
    if housing != null:
        var rear_frame := housing.get_parent() as Node3D
        preload("res://scripts/cab_view_cleanup_v37.gd").apply(rear_frame)
        _install_car_mirrors(rear_frame,true)

func _install_car_mirrors(frame: Node3D,rear: bool) -> void:
    var cleanup = preload("res://scripts/cab_view_cleanup_v37.gd")
    var originals: Dictionary = cleanup.mirror_parts(frame)
    for child in frame.find_children("mirror-*","MeshInstance3D",true,false):
        var housing := child as MeshInstance3D
        if model.is_ancestor_of(housing): continue
        var center := frame.to_local(housing.to_global(housing.get_aabb().get_center()))
        var side := signf(center.x)
        var yellow := housing.get_active_material(0)
        var pivot := Node3D.new()
        pivot.name = "CompleteOriginalMirrorLeft" if side < 0.0 else "CompleteOriginalMirrorRight"
        frame.add_child(pivot)
        pivot.position = center
        housing.reparent(pivot,true)
        var video := _make_video()
        video["side"] = side
        video["pivot"] = pivot
        video["frame"] = frame
        video["rear"] = rear
        for part in originals[side]:
            # Retain the original reflective pane; replace the old straight
            # support with the photographed forward-facing bent bracket.
            if not bool(part.get_meta("reflection")):
                part.free()
                continue
            frame.add_child(part)
            part.reparent(pivot,true)
            part.material_override = video.material
            part.layers = 32
            part.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
        housing.layers = 1
        pivot.position = cleanup.mirror_position(side)
        pivot.scale = Vector3(1.35,1.45,1.0)
        cleanup.mirror_mount(frame,side,yellow)
        _mirrors.append(video)

func _update_video() -> void:
    var viewer := game.get("camera") as Camera3D
    for video in _mirrors:
        var enabled := bool(switches.mirrorLeft if video.side < 0.0 else switches.mirrorRight)
        var pivot := video.pivot as Node3D
        var frame := video.frame as Node3D
        var eye: Vector3 = POSITION+EYE if bool(video.rear) else frame.to_local(to_global(EYE))
        var toward_eye := (eye-pivot.position).normalized()
        var behind := Vector3(float(video.side)*1.90,2.40,65.0)
        var toward_rear := (behind-pivot.position).normalized()
        var normal := (toward_eye+toward_rear).normalized()
        var open_angle := atan2(normal.x,normal.z)
        pivot.rotation.y = open_angle if enabled else open_angle+float(video.side)*PI*0.5
        if not enabled or not viewer.is_position_in_frustum(pivot.global_position): continue
        var camera := video.camera as Camera3D
        # A small outboard offset keeps the rear-view lens clear of the body
        # after moving the visible mirror inward into the windscreen opening.
        var lens := pivot.position
        lens.x = float(video.side)*maxf(absf(lens.x),1.46)
        lens.z += 0.04
        camera.global_position = frame.to_global(lens)
        camera.look_at(frame.to_global(behind),frame.global_basis.y)
        (video.viewport as SubViewport).render_target_update_mode = SubViewport.UPDATE_ONCE

func make_screen_controls(ui: CanvasLayer) -> void:
    _cab_light_button = Button.new()
    _cab_light_button.position = Vector2(245,55)
    _cab_light_button.custom_minimum_size = Vector2(240,42)
    _cab_light_button.toggle_mode = true
    ui.add_child(_cab_light_button)
    _cab_light_button.pressed.connect(func(): command("cabLight"); _apply_cab_light())
    _apply_cab_light()
    var toggle := Button.new()
    toggle.text = "ПУЛЬТ / ДВЕРИ"
    toggle.position = Vector2(15,55)
    toggle.custom_minimum_size = Vector2(220,42)
    ui.add_child(toggle)
    var panel := VBoxContainer.new()
    panel.position = Vector2(15,100)
    panel.visible = false
    ui.add_child(panel)
    toggle.pressed.connect(func(): panel.visible = not panel.visible)
    var row := GridContainer.new()
    row.columns = 3
    panel.add_child(row)
    for entry in [["ТЯГА +","tractionUp"],["НЕЙТРАЛЬ","release"],["ТЯГА −","tractionDown"],["ЛЕВЫЕ ДВЕРИ","openLeft"],["ЗАКРЫТЬ","close"],["ПРАВЫЕ ДВЕРИ","openRight"],["РЕВЕРС","reverse"],["ФАРЫ","headlights"],["СВЕТ КАБИНЫ","cabLight"],["СЛУЖ. ТОРМОЗ","service"],["ЭКСТРЕННЫЙ","emergency"],["СИГНАЛ","horn"]]:
        var button := Button.new()
        button.text = entry[0]
        button.custom_minimum_size = Vector2(150,42)
        row.add_child(button)
        var id: String = entry[1]
        if id == "horn":
            button.button_down.connect(func(): command(id))
            button.button_up.connect(func(): command(id,0.0,"release"))
        else:
            button.pressed.connect(func(): command(id))
    var all_controls := OptionButton.new()
    for id in CONTROL_IDS:
        all_controls.add_item(CONTROL_TITLES[id])
    panel.add_child(all_controls)
    var activate := Button.new()
    activate.text = "Выбранный орган: нажать / удерживать"
    panel.add_child(activate)
    activate.button_down.connect(func(): command(CONTROL_IDS[all_controls.selected]))
    activate.button_up.connect(func(): command(CONTROL_IDS[all_controls.selected],0.0,"release"))
    var status := Label.new()
    status.add_theme_font_size_override("font_size",16)
    panel.add_child(status)
    var timer := Timer.new()
    timer.wait_time = 0.25
    timer.autostart = true
    panel.add_child(timer)
    timer.timeout.connect(func():
        status.text = "%s · Тяга %d · Тормоз %.0f%%\n%s" % ["ВПЕРЁД" if direction == 1 else "НАЗАД" if direction == -1 else "НЕЙТРАЛЬ",controller_notch,applied_brake*100,notice]
        status.text += "\nОбогрев: Л %s %.0f°C · П %s %.0f°C" % ["ВКЛ" if switches.heatLeft else "ВЫКЛ",window_temperature.x,"ВКЛ" if switches.heatRight else "ВЫКЛ",window_temperature.y]
    )

func cancel_interaction() -> void:
    var was_master := _active == "master"
    _active = ""
    _pointer = -2
    if was_master: master_interaction_changed.emit(false)
    horn_active = false
    radio_tx = false
    sand_left = false
    sand_right = false
    lamp_test = false
    if _horn != null: _horn.stop()

func _notification(what: int) -> void:
    if what == NOTIFICATION_APPLICATION_FOCUS_OUT:
        cancel_interaction()


func _input(event: InputEvent) -> void:
    if is_instance_valid(game) and game.has_method("driver_has_control") and not game.call("driver_has_control"):
        return
    # Capture the physical master before GUI/unhandled-input routing. Once held,
    # continue receiving the same finger even over other controls or outside the
    # projected grip; the camera must never consume a controller drag.
    if ready_for_play and is_instance_valid(game) and str(game.get("camera_mode")) == "cabin":
        var camera := game.get("camera") as Camera3D
        var pressing: bool = (event is InputEventScreenTouch and event.pressed) or (event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and event.pressed)
        var captured := _active == "master"
        # Android can emit a second, emulated mouse stream for the same touch.
        # Consume it while the real finger owns the lever, rather than letting
        # the orbit camera rotate or steal the gesture.
        if captured and _pointer >= 0 and event is InputEventMouse:
            get_viewport().set_input_as_handled()
            return
        if captured or (pressing and not _screen_pointer_reserved(event.position) and _master_hit(event.position,camera)):
            if handle_input(event,camera):
                get_viewport().set_input_as_handled()
                return
    # Release a captured 3D control even if the pointer ends over screen UI.
    var released: bool = (event is InputEventScreenTouch and not event.pressed) or (event is InputEventMouseButton and event.button_index == MOUSE_BUTTON_LEFT and not event.pressed)
    if released and not _active.is_empty() and is_instance_valid(game):
        if handle_input(event,game.get("camera") as Camera3D):
            get_viewport().set_input_as_handled()
    if event is InputEventKey and not event.pressed and event.physical_keycode == KEY_T:
        lamp_test = false
    if event is InputEventKey and not event.pressed and event.physical_keycode == KEY_H:
        horn_active = false
        if _horn != null: _horn.stop()




func get_master_value() -> float:
    # Shared commanded setting; readers never reconstruct it from rounded notches.
    return controller_value

func master_is_held() -> bool:
    return _active == "master"

func _screen_pointer_reserved(point: Vector2) -> bool:
    if not is_instance_valid(game): return false
    var overlay := game.get("_flight_ui") as Control
    return is_instance_valid(overlay) and overlay.has_method("blocks_cab_pointer") and bool(overlay.call("blocks_cab_pointer",point))
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends RefCounted
## Photo-based cab sides on instantiated end cars; original GLBs stay intact.
const BODY_BOTTOM := 0.95
const BODY_TOP := 3.1075

static func _triangle_bounds(a: Vector3,b: Vector3,c: Vector3) -> AABB:
    var low := a.min(b).min(c)
    return AABB(low,a.max(b).max(c)-low)

static func _half(poly: Array, axis: int, edge: float, greater: bool) -> Array:
    var result: Array = []
    for i in range(poly.size()):
        var a: Array = poly[i]
        var b: Array = poly[(i+1)%poly.size()]
        var av: float = a[0][axis]
        var bv: float = b[0][axis]
        var ai: bool = av >= edge if greater else av <= edge
        var bi: bool = bv >= edge if greater else bv <= edge
        if ai: result.append(a)
        if ai != bi:
            var t := (edge-av)/(bv-av)
            result.append([a[0].lerp(b[0],t),a[1].lerp(b[1],t),a[2].lerp(b[2],t),a[3].lerp(b[3],t)])
    return result

static func _subtract(poly: Array, volume: AABB) -> Array:
    var outside: Array = []
    var remaining: Array = poly
    for axis in range(3):
        for upper in [false,true]:
            var edge: float = volume.end[axis] if upper else volume.position[axis]
            var piece := _half(remaining,axis,edge,upper)
            if piece.size() >= 3: outside.append(piece)
            remaining = _half(remaining,axis,edge,not upper)
            if remaining.size() < 3: return outside
    return outside

static func apply(lead: Node3D) -> void:
    var paint: BaseMaterial3D
    var paint_vertex := Color.WHITE
    var paint_score := INF
    # Replace the entire old side-door skin, inside AND outside. This removes
    # all old door seams/handles/small-window frames before making one blue skin.
    var sides := [AABB(Vector3(-1.40,BODY_BOTTOM,-9.505),Vector3(0.22,BODY_TOP-BODY_BOTTOM,1.845)),AABB(Vector3(1.18,BODY_BOTTOM,-9.505),Vector3(0.22,BODY_TOP-BODY_BOTTOM,1.845))]
    for child in lead.find_children("*","MeshInstance3D",true,false):
        var instance := child as MeshInstance3D
        if not instance.visible: continue
        var transform := lead.global_transform.affine_inverse()*instance.global_transform
        var inverse := transform.affine_inverse()
        var box: AABB = transform*instance.get_aabb()
        var metal := box.size.z > 18.0 and absf(box.position.y-0.09) < 0.01 and absf(box.end.y-3.1075) < 0.01
        var volumes: Array = sides.duplicate()
        # Remove any remaining original solid cabinet in the left doorway.
        # Floor, side skin, door and rear bulkhead lie outside this volume.
        volumes.append(AABB(Vector3(-1.245,1.0,-9.25),Vector3(0.58,1.45,1.20)))
        if metal: volumes.append(AABB(Vector3(-1.32,0.95,-9.60),Vector3(2.64,2.35,2.0)))
        var relevant := false
        for volume in volumes:
            if box.intersects(volume): relevant = true
        # Also read the adjacent body paint; it can share a material-batched mesh.
        var contains_paint_sample := box.position.y <= 1.30 and box.end.y >= 1.30 and box.position.z <= -3.0 and box.end.z >= -3.0
        if not relevant and not contains_paint_sample: continue
        var replacement := ArrayMesh.new()
        var changed := false
        for surface in range(instance.mesh.get_surface_count()):
            var material := instance.get_active_material(surface)
            var arrays: Array = instance.mesh.surface_get_arrays(surface).duplicate(true)
            var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
            var normals: PackedVector3Array = arrays[Mesh.ARRAY_NORMAL] if arrays[Mesh.ARRAY_NORMAL] != null else PackedVector3Array()
            var uvs: PackedVector2Array = arrays[Mesh.ARRAY_TEX_UV] if arrays[Mesh.ARRAY_TEX_UV] != null else PackedVector2Array()
            var colors: PackedColorArray = arrays[Mesh.ARRAY_COLOR] if arrays[Mesh.ARRAY_COLOR] != null else PackedColorArray()
            var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX] if arrays[Mesh.ARRAY_INDEX] != null else PackedInt32Array()
            if indices.is_empty():
                indices.resize(vertices.size())
                for i in range(vertices.size()): indices[i] = i
            var kept := PackedInt32Array()
            var clipped := SurfaceTool.new()
            clipped.begin(Mesh.PRIMITIVE_TRIANGLES)
            var clipped_count := 0
            for triangle in range(0,indices.size(),3):
                var ids := [indices[triangle],indices[triangle+1],indices[triangle+2]]
                var a: Vector3 = transform*vertices[ids[0]]
                var b: Vector3 = transform*vertices[ids[1]]
                var c: Vector3 = transform*vertices[ids[2]]
                # Select the actual exterior blue surface near the lower body,
                # including its vertex colour. Surface 0 of a batch is not
                # necessarily the body paint (it may be the interior lining).
                var base := material as BaseMaterial3D
                if base != null and base.transparency == BaseMaterial3D.TRANSPARENCY_DISABLED and absf((a+b+c).x/3.0) > 1.24:
                    var vertex_color := Color.WHITE
                    if base.vertex_color_use_as_albedo and colors.size() == vertices.size():
                        vertex_color = (colors[ids[0]]+colors[ids[1]]+colors[ids[2]])/3.0
                    var hue := base.albedo_color*vertex_color
                    if hue.b > hue.r*1.6 and hue.g > hue.r*1.3 and hue.b > hue.g*1.3:
                        var triangle_bounds := _triangle_bounds(a,b,c)
                        var reference := Vector3(signf((a+b+c).x)*1.345,1.30,-3.0)
                        var nearest := Vector3(clampf(reference.x,triangle_bounds.position.x,triangle_bounds.end.x),clampf(reference.y,triangle_bounds.position.y,triangle_bounds.end.y),clampf(reference.z,triangle_bounds.position.z,triangle_bounds.end.z))
                        var score := reference.distance_squared_to(nearest)
                        if score < paint_score:
                            paint_score = score
                            paint = base
                            paint_vertex = vertex_color
                if not relevant or maxf(a.y,maxf(b.y,c.y)) <= BODY_BOTTOM:
                    kept.append_array(PackedInt32Array(ids))
                    continue
                var tri_box := _triangle_bounds(a,b,c)
                var cuts: Array = []
                for volume in volumes:
                    if tri_box.intersects(volume): cuts.append(volume)
                if cuts.is_empty():
                    kept.append_array(PackedInt32Array(ids))
                    continue
                changed = true
                var poly: Array = []
                for id in ids:
                    poly.append([transform*vertices[id],normals[id] if normals.size() == vertices.size() else Vector3.UP,uvs[id] if uvs.size() == vertices.size() else Vector2.ZERO,colors[id] if colors.size() == vertices.size() else Color.WHITE])
                var pieces: Array = [poly]
                for volume in cuts:
                    var next: Array = []
                    for piece in pieces: next.append_array(_subtract(piece,volume))
                    pieces = next
                for piece in pieces:
                    for k in range(1,piece.size()-1):
                        for vertex in [piece[0],piece[k],piece[k+1]]:
                            clipped.set_normal(vertex[1].normalized())
                            clipped.set_uv(vertex[2])
                            clipped.set_color(vertex[3])
                            clipped.add_vertex(inverse*vertex[0])
                            clipped_count += 1
            if not kept.is_empty():
                arrays[Mesh.ARRAY_INDEX] = kept
                replacement.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays)
                replacement.surface_set_material(replacement.get_surface_count()-1,material)
            if clipped_count > 0:
                clipped.set_material(material)
                clipped.commit(replacement)
        if changed:
            if replacement.get_surface_count() == 0: instance.hide()
            else:
                instance.mesh = replacement
                for surface in range(replacement.get_surface_count()): instance.set_surface_override_material(surface,null)
    if paint == null:
        var fallback := StandardMaterial3D.new()
        fallback.albedo_color = Color(0.0168,0.0844,0.1714)
        paint = fallback
    var blue := paint.duplicate() as StandardMaterial3D
    blue.cull_mode = BaseMaterial3D.CULL_DISABLED
    blue.set_meta("cab_vertex_color",paint_vertex)
    var rubber := StandardMaterial3D.new()
    rubber.albedo_color = Color(0.018,0.022,0.026)
    rubber.roughness = 0.92
    rubber.cull_mode = BaseMaterial3D.CULL_DISABLED
    var glass := StandardMaterial3D.new()
    glass.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
    glass.albedo_color = Color(0.0,0.0,0.0,0.018)
    glass.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
    glass.cull_mode = BaseMaterial3D.CULL_DISABLED
    glass.depth_draw_mode = BaseMaterial3D.DEPTH_DRAW_DISABLED
    for side in [-1.0,1.0]:
        _make_side(lead,side,blue,rubber,glass)

static func _emit(tool: SurfaceTool, a: Vector3, b: Vector3, c: Vector3, normal: Vector3) -> void:
    tool.set_normal(normal)
    tool.add_vertex(a)
    tool.add_vertex(b)
    tool.add_vertex(c)

static func _quad(tool: SurfaceTool, a: Vector3,b: Vector3,c: Vector3,d: Vector3,normal: Vector3) -> void:
    _emit(tool,a,b,c,normal)
    _emit(tool,a,c,d,normal)

static func _rect(tool: SurfaceTool,x: float,y0: float,y1: float,z0: float,z1: float,n: Vector3) -> void:
    _quad(tool,Vector3(x,y0,z0),Vector3(x,y1,z0),Vector3(x,y1,z1),Vector3(x,y0,z1),n)

static func _contour(y0: float,y1: float,z0: float,z1: float,radius: float) -> Array[Vector2]:
    var points: Array[Vector2] = []
    # XY here are longitudinal Z and height Y. Same outline on both skins.
    var corners := [Vector2(z1-radius,y1-radius),Vector2(z0+radius,y1-radius),Vector2(z0+radius,y0+radius),Vector2(z1-radius,y0+radius)]
    for corner in range(4):
        for step in range(9):
            var angle := float(corner)*PI*0.5+float(step)*PI/16.0
            points.append(corners[corner]+Vector2(cos(angle),sin(angle))*radius)
    return points

static func _node(lead: Node3D,tool: SurfaceTool,material: Material,label: String,layers: int) -> void:
    tool.set_material(material)
    var instance := MeshInstance3D.new()
    instance.name = label
    instance.mesh = tool.commit()
    instance.layers = layers
    if layers == 4: instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
    lead.add_child(instance)


static func _make_side(lead: Node3D, side: float, blue: Material,rubber: Material,glass: Material) -> void:
    # 81-717: a narrow portrait window on the right, a separate cab door on
    # the left. Both skins have actual openings, not transparent wall overlays.
    if side > 0.0:
        _window_panel(lead,side,blue,rubber,glass,BODY_BOTTOM,BODY_TOP,-9.505,-7.66,
            1.88,3.02,-9.12,-8.37,0.09,"RightCabWindow")
        _sash(lead,side,2.57,-9.10,-8.39)
        _waist_trim(lead,side,-9.505,-7.66)
    else:
        _window_panel(lead,side,blue,rubber,null,BODY_BOTTOM,BODY_TOP,-9.505,-7.66,
            0.975,3.065,-9.30,-8.22,0.025,"DriverDoorFrame")
        var door := Node3D.new()
        door.name = "DriverEntranceDoor"
        door.set_meta("hinge_axis",Vector3.UP)
        door.set_meta("open_angle",-side*PI*0.5)
        door.set_meta("exit_in_cab_frame",Vector3(-1.95,BODY_BOTTOM,-8.75))
        lead.add_child(door)
        _window_panel(door,side,blue,rubber,glass,0.990,3.050,-9.285,-8.235,
            1.91,3.015,-9.105,-8.455,0.085,"DriverDoorWindow")
        _waist_trim(door,side,-9.27,-8.25)
        var chrome := StandardMaterial3D.new()
        chrome.albedo_color = Color(0.65,0.68,0.70)
        chrome.metallic = 0.85
        chrome.roughness = 0.28
        for x in [side*1.22,side*1.39]:
            _bar(door,Vector3(x,2.10,-9.18),Vector3(x,2.73,-9.18),0.012,chrome,"DoorGrabHandle")
            _bar(door,Vector3(x,1.78,-8.43),Vector3(x,1.78,-8.28),0.015,chrome,"DoorLatch")
        for y in [1.15,2.85]:
            _bar(door,Vector3(side*1.36,y-0.065,-8.25),Vector3(side*1.36,y+0.065,-8.25),0.019,chrome,"DoorHinge")
        var hinge := Vector3(side*1.30,0.990,-8.235)
        for child in door.get_children():
            if child is Node3D: (child as Node3D).position -= hinge
        door.position = hinge

static func _window_panel(parent: Node3D,side: float,blue: Material,rubber: Material,glass: Material,
        bottom: float,top: float,front: float,rear: float,
        y0: float,y1: float,z0: float,z1: float,radius: float,label: String) -> void:
    var inside := side*1.252
    var outside := side*1.345
    var wall := SurfaceTool.new()
    wall.begin(Mesh.PRIMITIVE_TRIANGLES)
    wall.set_color(blue.get_meta("cab_vertex_color",Color.WHITE))
    for face in [inside,outside]:
        var normal := Vector3(-side if face == inside else side,0,0)
        _rect(wall,face,bottom,y0,front,rear,normal)
        _rect(wall,face,y1,top,front,rear,normal)
        _rect(wall,face,y0,y1,front,z0,normal)
        _rect(wall,face,y0,y1,z1,rear,normal)
        var centers := [Vector2(z1-radius,y1-radius),Vector2(z0+radius,y1-radius),Vector2(z0+radius,y0+radius),Vector2(z1-radius,y0+radius)]
        var corners := [Vector2(z1,y1),Vector2(z0,y1),Vector2(z0,y0),Vector2(z1,y0)]
        for corner in range(4):
            for step in range(8):
                var a := float(corner)*PI*0.5+float(step)*PI/16.0
                var b := a+PI/16.0
                var v: Vector2 = centers[corner]+Vector2(cos(a),sin(a))*radius
                var w: Vector2 = centers[corner]+Vector2(cos(b),sin(b))*radius
                _emit(wall,Vector3(face,corners[corner].y,corners[corner].x),Vector3(face,v.y,v.x),Vector3(face,w.y,w.x),normal)
    var opening := _contour(y0,y1,z0,z1,radius)
    for i in range(opening.size()):
        var a := opening[i]
        var b := opening[(i+1)%opening.size()]
        var n := Vector3(0,(a.y+b.y)*0.5-(y0+y1)*0.5,(a.x+b.x)*0.5-(z0+z1)*0.5).normalized()
        _quad(wall,Vector3(inside,a.y,a.x),Vector3(outside,a.y,a.x),Vector3(outside,b.y,b.x),Vector3(inside,b.y,b.x),-n)
    _node(parent,wall,blue,label+"Steel",3)
    var seal := SurfaceTool.new()
    seal.begin(Mesh.PRIMITIVE_TRIANGLES)
    var border := _contour(y0-0.022,y1+0.022,z0-0.022,z1+0.022,radius+0.022)
    for x in [inside-side*0.002,outside+side*0.002]:
        for i in range(opening.size()):
            var j := (i+1)%opening.size()
            _quad(seal,Vector3(x,opening[i].y,opening[i].x),Vector3(x,border[i].y,border[i].x),Vector3(x,border[j].y,border[j].x),Vector3(x,opening[j].y,opening[j].x),Vector3(-side if x*side < 1.3 else side,0,0))
    _node(parent,seal,rubber,label+"Rubber",3)
    if glass != null:
        var pane := SurfaceTool.new()
        pane.begin(Mesh.PRIMITIVE_TRIANGLES)
        for i in range(opening.size()):
            var j := (i+1)%opening.size()
            _emit(pane,Vector3(side*1.29,(y0+y1)*0.5,(z0+z1)*0.5),Vector3(side*1.29,opening[i].y,opening[i].x),Vector3(side*1.29,opening[j].y,opening[j].x),Vector3(-side,0,0))
        _node(parent,pane,glass,label+"Glass",4)

static func _bar(parent: Node3D,a: Vector3,b: Vector3,radius: float,material: Material,label: String) -> void:
    var node := MeshInstance3D.new()
    node.name = label
    var mesh := CylinderMesh.new()
    mesh.top_radius = radius
    mesh.bottom_radius = radius
    mesh.height = a.distance_to(b)
    mesh.radial_segments = 12
    mesh.material = material
    node.mesh = mesh
    var direction := (b-a).normalized()
    var axis := Vector3.UP.cross(direction)
    if axis.length_squared() > 0.00001:
        node.basis = Basis(axis.normalized(),Vector3.UP.angle_to(direction))
    node.position = (a+b)*0.5
    node.layers = 3
    parent.add_child(node)

static func _sash(parent: Node3D,side: float,y: float,z0: float,z1: float) -> void:
    var chrome := StandardMaterial3D.new()
    chrome.albedo_color = Color(0.60,0.64,0.65)
    chrome.metallic = 0.75
    chrome.roughness = 0.35
    _bar(parent,Vector3(side*1.29,y,z0),Vector3(side*1.29,y,z1),0.014,chrome,"CabWindowSlidingSash")

static func _waist_trim(parent: Node3D,side: float,z0: float,z1: float) -> void:
    var chrome := StandardMaterial3D.new()
    chrome.albedo_color = Color(0.68,0.70,0.68)
    chrome.metallic = 0.65
    chrome.roughness = 0.4
    for y in [1.62,1.69,1.76]:
        _bar(parent,Vector3(side*1.351,y,z0),Vector3(side*1.351,y,z1),0.021,chrome,"CabWaistMoulding")

static func mirror_position(side: float) -> Vector3:
    return Vector3(side*1.28,2.68,-10.08)

static func mirror_mount(parent: Node3D,side: float,material: Material) -> void:
    # Short direct supports from the nearest windscreen corner. Nothing starts
    # at the side window or extends along the side wall.
    var mount := mirror_position(side)
    for y in [2.47,2.55]:
        var anchor := Vector3(side*1.25,y,-9.665)
        var end := Vector3(mount.x,y,mount.z)
        _bar(parent,anchor,end,0.012,material,"ShortWindscreenMirrorMount")
    _bar(parent,Vector3(mount.x,2.47,mount.z),mount,0.012,material,"MirrorMountUpright")

static func mirror_parts(lead: Node3D) -> Dictionary:
    var result := {-1.0:[],1.0:[]}
    for child in lead.find_children("*","MeshInstance3D",true,false):
        var source := child as MeshInstance3D
        var transform := lead.global_transform.affine_inverse()*source.global_transform
        var box: AABB = transform*source.get_aabb()
        var backing := box.size.x > 2.7 and box.position.z < -9.70 and box.end.z > -9.63 and box.position.y > 2.40 and box.end.y < 2.75
        var glass := box.size.x > 2.8 and box.size.z < 0.002 and absf(box.position.z+9.651) < 0.004 and box.position.y > 2.54
        if not backing and not glass: continue
        source.hide()
        for side in [-1.0,1.0]:
            var mesh := ArrayMesh.new()
            for surface in range(source.mesh.get_surface_count()):
                var arrays: Array = source.mesh.surface_get_arrays(surface).duplicate(true)
                var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
                var original: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
                if original.is_empty():
                    original.resize(vertices.size())
                    for i in range(vertices.size()): original[i] = i
                var kept := PackedInt32Array()
                for i in range(0,original.size(),3):
                    if (transform*vertices[original[i]]).x*side > 0.0:
                        kept.append(original[i]); kept.append(original[i+1]); kept.append(original[i+2])
                if kept.is_empty(): continue
                if glass:
                    var low := Vector3(INF,INF,INF)
                    var high := Vector3(-INF,-INF,-INF)
                    for index in kept:
                        var point: Vector3 = transform*vertices[index]
                        low = low.min(point)
                        high = high.max(point)
                    var uv := PackedVector2Array()
                    uv.resize(vertices.size())
                    for index in kept:
                        var point: Vector3 = transform*vertices[index]
                        uv[index] = Vector2(inverse_lerp(low.x,high.x,point.x),1.0-inverse_lerp(low.y,high.y,point.y))
                    arrays[Mesh.ARRAY_TEX_UV] = uv
                arrays[Mesh.ARRAY_INDEX] = kept
                mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays)
                mesh.surface_set_material(mesh.get_surface_count()-1,source.get_active_material(surface))
            var part := MeshInstance3D.new()
            part.mesh = mesh
            part.transform = transform
            part.name = "OriginalMirrorGlass" if glass else "OriginalMirrorBracket"
            part.set_meta("reflection",glass)
            result[side].append(part)
    return result

␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends RefCounted
## Upright prints on original framed saloon surfaces; never reuse imported UVs.
const POSTER = preload("res://assets/saloon_v49/goodmix-duo-zakhar.jpg")

static func _print(parent: Node3D,label: String,center: Vector3,size: Vector2,normal: Vector3) -> void:
    var material := StandardMaterial3D.new()
    material.albedo_texture=POSTER
    material.albedo_color=Color.WHITE
    material.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED
    material.cull_mode=BaseMaterial3D.CULL_DISABLED
    material.texture_repeat=false
    material.texture_filter=BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
    var right := Vector3.UP.cross(normal).normalized()
    var up := Vector3.UP
    var p := center+normal*0.006
    var points := [p-right*size.x*0.5-up*size.y*0.5,p+right*size.x*0.5-up*size.y*0.5,p+right*size.x*0.5+up*size.y*0.5,p-right*size.x*0.5+up*size.y*0.5]
    var uvs := [Vector2(0,1),Vector2(1,1),Vector2(1,0),Vector2(0,0)]
    var st := SurfaceTool.new()
    st.begin(Mesh.PRIMITIVE_TRIANGLES)
    for index in [0,1,2,0,2,3]:
        st.set_normal(normal)
        st.set_uv(uvs[index])
        st.add_vertex(points[index])
    var mesh := MeshInstance3D.new()
    mesh.name=label
    mesh.mesh=st.commit()
    mesh.material_override=material
    mesh.layers=17
    mesh.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
    parent.add_child(mesh)

static func apply(train: Node3D) -> void:
    var mounts: Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://assets/saloon_v49/mounts.json"))
    for car in train.get_children():
        if not car is Node3D or str(car.name) not in ["OriginalV106Car01","OriginalV106Car04"]: continue
        if car.has_node("GoodmixUprightV54"): continue
        var holder := Node3D.new()
        holder.name="GoodmixUprightV54"
        var front := str(car.name)=="OriginalV106Car01"
        var layout: Dictionary=mounts[str(car.name)]
        var middle := (float(layout.door_z[0])+float(layout.door_z[3]))*0.5
        var found := {"end":false,"left":false,"right":false}
        for node in car.find_children("*","MeshInstance3D",true,false):
            var label := str(node.name).to_lower()
            if not label.contains("goodmix") or label.contains("frame"): continue
            var original := node as MeshInstance3D
            if original.mesh==null: continue
            var box: AABB=car.global_transform.affine_inverse()*original.global_transform*original.get_aabb()
            var center := box.get_center()
            if box.size.y<0.10: continue
            if box.size.z<0.12 and box.size.x>0.45:
                if not found.end:
                    var normal := Vector3.BACK if center.z<middle else Vector3.FORWARD
                    _print(holder,"GoodmixEndUpright",center,Vector2(box.size.x,box.size.y),normal)
                    found.end=true
                # Printed face only; retain the original physical frame.
                original.hide()
            elif box.size.x<0.12 and box.size.z>0.10:
                var key := "left" if center.x<0 else "right"
                if not found[key]:
                    _print(holder,"GoodmixSideUpright"+key,center,Vector2(box.size.z,box.size.y),Vector3.RIGHT if center.x<0 else Vector3.LEFT)
                    found[key]=true
                original.hide()
        if not found.end:
            var z := float(layout.door_z[0])-1.195+0.004 if front else float(layout.door_z[3])+1.195-0.004
            _print(holder,"GoodmixEndUpright",Vector3(0,2.44,z),Vector2(1.48,1.04),Vector3.BACK if front else Vector3.FORWARD)
        for side in [-1.0,1.0]:
            var key := "left" if side<0 else "right"
            if not found[key]:
                var z := float(layout.door_z[0])+0.65 if front else float(layout.door_z[3])-0.65
                _print(holder,"GoodmixSideUpright"+key,Vector3(side*1.193,2.48,z),Vector2(0.42,0.295),Vector3.RIGHT if side<0 else Vector3.LEFT)
        car.add_child(holder)
␀␀␀␀␀extends RefCounted
## TZ46: new surface-mounted saloon artwork. No legacy advertising module.
## V49 uses fixed mounts on the original opaque interior; legacy helpers retained.
const PRINT_LAYERS := 1 | (1 << 4) # Camera layer 1 + existing saloon light layer 5.
const MOUNT_OFFSET := 0.008
const DIR := "res://assets/saloon_v46/"
const MAP = preload("res://assets/saloon_v46/minsk_network.svg")
const LINE = preload("res://assets/saloon_v46/moscow_line.svg")
const NOTICE = preload("res://assets/saloon_v46/passenger_notice.svg")
var _materials: Dictionary = {}
var _tools: Dictionary = {}
var _doors: Array = []
var _portrait := 0
var _banner := 0

static func decorate(game: Node3D,train: Node3D,door_system: Node) -> void:
    var module = load("res://scripts/depot/saloon_advertising_v46.gd").new()
    module._doors=door_system.get("leaves")
    var index := 0
    for node in train.get_children():
        if node is Node3D and str(node.name).begins_with("OriginalV106Car"):
            module._decorate_car(game,node as Node3D,index)
            index+=1

func _material(texture: Texture2D) -> StandardMaterial3D:
    if _materials.has(texture): return _materials[texture]
    var material := StandardMaterial3D.new()
    material.albedo_texture=texture
    material.roughness=0.88
    material.cull_mode=BaseMaterial3D.CULL_DISABLED
    material.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED
    material.texture_repeat=false
    material.metallic=0.0
    material.texture_filter=BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
    # Gentle ink visibility under the existing saloon lights; no added lights.
    material.emission_enabled=true
    material.emission_texture=texture
    material.emission=Color.WHITE
    material.emission_energy_multiplier=0.10
    _materials[texture]=material
    return material

func _decorate_car(_game: Node3D,car: Node3D,_index: int) -> void:
    if car.has_node("SaloonArtworkV46"): return
    # V49: fixed original-model mounts, including the sloped upper side panels.
    # No runtime triangle probing / CylinderMesh access is needed for these cars.
    var manifest: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://assets/saloon_v49/mounts.json"))
    if not manifest.has(str(car.name)):
        push_error("V49: no artwork mounts for " + str(car.name))
        return
    _tools.clear()
    var counts := {"advertisement":0,"network_map":0,"line_diagram":0,"notice":0,"emergency_exit":0}
    for mount in manifest[str(car.name)].mounts:
        var asset := str(mount.asset)
        if str(mount.kind)=="line_diagram": asset="res://assets/signage_v54/moscow_line.svg"
        var texture := load(asset) as Texture2D
        if texture == null:
            push_error("V49: missing artwork " + str(mount.asset))
            continue
        if mount.has("center"):
            _fixed_print(mount,texture)
        else:
            var rect: Array = mount.rect
            var used: Array[Dictionary] = []
            _attach({"patch":{"axis":int(mount.axis),"plane":float(mount.plane),"normal":_vector(mount.normal)},"rect":Rect2(rect[0],rect[1],rect[2],rect[3])},texture,used)
        counts[mount.kind] += 1
    var holder := Node3D.new()
    holder.name="SaloonArtworkV46"
    car.add_child(holder)
    for material in _tools:
        var mesh := MeshInstance3D.new()
        mesh.name="PrintedInteriorPanels"
        mesh.mesh=(_tools[material] as SurfaceTool).commit()
        mesh.material_override=material
        mesh.layers=PRINT_LAYERS
        mesh.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
        holder.add_child(mesh)
    holder.set_meta("advertisements",counts.advertisement)
    holder.set_meta("network_maps",counts.network_map)
    holder.set_meta("line_diagrams",counts.line_diagram)
    holder.set_meta("notices",counts.notice)
    holder.set_meta("emergency_exits",counts.emergency_exit)
    holder.set_meta("placement_complete",counts.advertisement > 0 and counts.network_map == 2 and counts.line_diagram == 4)
    holder.set_meta("surface_source","V49 fixed original opaque interior mounts")
    print("V49_ART car=%s counts=%s" % [car.name,counts])
    _tools.clear()

func _vector(values: Array) -> Vector3:
    return Vector3(values[0],values[1],values[2])

func _fixed_print(mount: Dictionary,texture: Texture2D) -> void:
    var center := _vector(mount.center)
    var right := _vector(mount.right)*float(mount.size[0])*0.5
    var up := _vector(mount.up)*float(mount.size[1])*0.5
    var normal := _vector(mount.normal)
    var points := [center-right-up,center+right-up,center+right+up,center-right+up]
    var uvs := [Vector2(0,1),Vector2(1,1),Vector2(1,0),Vector2(0,0)]
    var material := _material(texture)
    if not _tools.has(material):
        var surface := SurfaceTool.new()
        surface.begin(Mesh.PRIMITIVE_TRIANGLES)
        surface.set_material(material)
        _tools[material]=surface
    var surface := _tools[material] as SurfaceTool
    for i in [0,2,1,0,3,2]:
        surface.set_normal(normal)
        surface.set_uv(uvs[i])
        surface.add_vertex(points[i])

func _surfaces(car: Node3D) -> Dictionary:
    var patches: Dictionary = {}
    var obstacles: Array[AABB] = []
    var moving: Array[Node3D] = []
    var headers: Array[Dictionary] = []
    var pairs: Dictionary = {}
    var center_z := 0.0
    var door_count := 0
    var first_door := INF
    var last_door := -INF
    for leaf in _doors:
        var root := leaf.parts[0].node as Node3D
        if not car.is_ancestor_of(root): continue
        moving.append(root)
        var box: AABB=leaf.parts[0].bounds
        obstacles.append(box.grow(0.012))
        var center: Vector3=leaf.center
        center_z+=center.z
        first_door=minf(first_door,center.z)
        last_door=maxf(last_door,center.z)
        door_count+=1
        var side := -1.0 if center.x < 0.0 else 1.0
        var key := "%d:%d" % [int(side),roundi(float(leaf.seam)*100)]
        if not pairs.has(key): pairs[key]={"bounds":box,"side":side}
        else: pairs[key].bounds=(pairs[key].bounds as AABB).merge(box)
    if door_count > 0: center_z/=float(door_count)
    var ordered: Array=pairs.values()
    ordered.sort_custom(func(a: Dictionary,b: Dictionary) -> bool: return (a.bounds as AABB).get_center().z < (b.bounds as AABB).get_center().z)
    for i in range(ordered.size()):
        var box: AABB=ordered[i].bounds
        headers.append({"z":box.get_center().z,"y":box.end.y+0.145,"top":box.end.y,"start":box.position.z,"end":box.end.z,"side":ordered[i].side,"pair":i})
    for node in car.find_children("*","MeshInstance3D",true,false):
        var mesh := node as MeshInstance3D
        if mesh.mesh == null or not mesh.is_visible_in_tree(): continue
        var name := str(mesh.name).to_lower()
        if name.contains("caution") or name.contains("saloonartwork") or name.contains("ticker"): continue
        var under_control := false
        for root in moving:
            if root == mesh or root.is_ancestor_of(mesh): under_control=true; break
        if under_control: continue
        var cab := car.get_node_or_null("OriginalCabIntegration")
        if cab != null and cab.is_ancestor_of(mesh): continue
        var pose := car.global_transform.affine_inverse()*mesh.global_transform
        var bounds: AABB=pose*mesh.get_aabb()
        if bounds.end.y < 1.55 or bounds.position.y > 3.25: continue
        for surface in range(mesh.mesh.get_surface_count()):
            if not mesh.mesh is ArrayMesh: continue
            if mesh.mesh.surface_get_primitive_type(surface) != Mesh.PRIMITIVE_TRIANGLES: continue
            var material := mesh.get_active_material(surface) as BaseMaterial3D
            if material == null: continue
            var color := material.albedo_color
            var description := material.resource_name.to_lower()
            if mesh.mesh.get_surface_count() == 1: description+=" "+name
            var glass := description.contains("glass") or description.contains("window") or description.contains("стекл")
            var opaque := material.transparency == BaseMaterial3D.TRANSPARENCY_DISABLED and color.a > 0.98
            # Paint colour is not a mounting constraint. Existing textured posters,
            # glazing and polished hardware are protected at TRIANGLE scope.
            var paint_texture := material.albedo_texture == null or (material.albedo_texture.get_width() <= 64 and material.albedo_texture.get_height() <= 64)
            var mountable := opaque and not glass and paint_texture and material.metallic < 0.65 and maxf(color.r,maxf(color.g,color.b)) > 0.06
            var arrays := mesh.mesh.surface_get_arrays(surface)
            var verts: PackedVector3Array=arrays[Mesh.ARRAY_VERTEX]
            var indices: PackedInt32Array=arrays[Mesh.ARRAY_INDEX] if arrays[Mesh.ARRAY_INDEX] != null else PackedInt32Array()
            var count := indices.size() if not indices.is_empty() else verts.size()
            for i in range(0,count-2,3):
                var ia: int=indices[i] if not indices.is_empty() else i
                var ib: int=indices[i+1] if not indices.is_empty() else i+1
                var ic: int=indices[i+2] if not indices.is_empty() else i+2
                var a: Vector3=pose*verts[ia]
                var b: Vector3=pose*verts[ib]
                var c: Vector3=pose*verts[ic]
                var low := a.min(b).min(c)
                var high := a.max(b).max(c)
                if high.y < 1.55 or low.y > 3.25: continue
                if not mountable:
                    # Never append the merged mesh's whole-car AABB here.
                    obstacles.append(AABB(low,high-low).grow(0.001))
                    continue
                # Use the geometric face, not smoothed/imported vertex normals.
                var face := (b-a).cross(c-a)
                if face.length_squared() < 0.000000001: continue
                face=face.normalized()
                var axis := 0 if absf(face.x) > 0.985 else 2 if absf(face.z) > 0.985 else -1
                if axis < 0: continue
                var center := (a+b+c)/3.0
                if door_count > 0:
                    if str(car.name) == "OriginalV106Car01" and center.z < first_door-1.8: continue
                    if str(car.name) == "OriginalV106Car04" and center.z > last_door+1.8: continue
                var normal := Vector3.ZERO
                if axis == 0:
                    if absf(center.x) < 0.80 or absf(center.x) > 1.55: continue
                    normal.x=-signf(center.x)
                else:
                    if absf(center.z-center_z) < 4.0: continue
                    normal.z=-signf(center.z-center_z)
                if high[axis]-low[axis] > 0.006: continue
                var plane: float=center[axis]
                var key := "%d:%d:%d" % [axis,roundi(plane*200),int(signf(normal[axis]))]
                var u := 2 if axis == 0 else 0
                var polygon := PackedVector2Array([Vector2(a[u],a.y),Vector2(b[u],b.y),Vector2(c[u],c.y)])
                var bottom := polygon[0].min(polygon[1]).min(polygon[2])
                var top := polygon[0].max(polygon[1]).max(polygon[2])
                var rect := Rect2(bottom,top-bottom)
                if not patches.has(key): patches[key]={"axis":axis,"plane":plane,"normal":normal,"bounds":rect,"triangles":[],"center_z":center_z,"headers":headers}
                # Mount on the passenger-facing side of any <=5 mm slab group.
                if (plane-float(patches[key].plane))*normal[axis] > 0.0: patches[key].plane=plane
                patches[key].bounds=(patches[key].bounds as Rect2).merge(rect)
                patches[key].triangles.append({"bounds":rect,"polygon":polygon})
    var result: Array=patches.values()
    for patch in result:
        var nearer: Array = []
        var axis: int=patch.axis
        var origin := 0.0 if axis == 0 else center_z
        for other in result:
            if int(other.axis) != axis: continue
            if signf(float(other.plane)-origin) != signf(float(patch.plane)-origin): continue
            var separation := (float(other.plane)-float(patch.plane))*(patch.normal as Vector3)[axis]
            if separation > 0.006: nearer.append(other.triangles)
        patch["nearer"]=nearer
        var blockers: Array[AABB] = []
        var u := 2 if axis == 0 else 0
        for box in obstacles:
            var obstacle_box: AABB=box
            if float(patch.plane) < obstacle_box.position[axis]-0.14 or float(patch.plane) > obstacle_box.end[axis]+0.14: continue
            var projected := Rect2(Vector2(obstacle_box.position[u],obstacle_box.position.y),Vector2(obstacle_box.size[u],obstacle_box.size.y))
            if (patch.bounds as Rect2).intersects(projected.grow(0.006)): blockers.append(obstacle_box)
        patch["blockers"]=blockers
    return {"patches":result,"obstacles":obstacles,"headers":headers}
func _slot(patches: Array,obstacles: Array,used: Array[Dictionary],dimensions: Vector2,kind: String,preference: float) -> Dictionary:
    var choices: Array[Dictionary] = []
    for patch in patches:
        var bounds: Rect2=patch.bounds
        if bounds.size.x < dimensions.x+0.015 or bounds.size.y < dimensions.y+0.015: continue
        if kind == "banner" and int(patch.axis) != 0: continue
        var ys: Array=[2.15,2.38,1.92,2.60] if kind != "banner" else [2.98,3.04,2.88]
        ys.append(bounds.end.y-dimensions.y*0.5-0.008)
        ys.append(bounds.position.y+dimensions.y*0.5+0.008)
        ys.append(bounds.get_center().y)
        var u0 := bounds.position.x+dimensions.x*0.5+0.008
        var u1 := bounds.end.x-dimensions.x*0.5-0.008
        var us: Array=[(u0+u1)*0.5,u0,u1]
        var axis: int=patch.axis
        var projected_axis := 2 if axis == 0 else 0
        for box in patch.get("blockers",obstacles):
            var obstacle: AABB=box
            if float(patch.plane) < obstacle.position[axis]-0.14 or float(patch.plane) > obstacle.end[axis]+0.14: continue
            for edge in [obstacle.position[projected_axis]-dimensions.x*0.5-0.014,obstacle.end[projected_axis]+dimensions.x*0.5+0.014]:
                if edge >= u0 and edge <= u1: us.append(edge)
        var steps := mini(90,int((u1-u0)/0.15))
        for i in range(steps): us.append(lerpf(u0,u1,float(i+1)/float(steps+1)))
        var unique_u: Dictionary = {}
        for coordinate in us: unique_u[roundi(coordinate*1000.0)]=coordinate
        us.clear()
        for coordinate in unique_u.values(): us.append(float(coordinate))
        for y in ys:
            if y-dimensions.y*0.5 < bounds.position.y or y+dimensions.y*0.5 > bounds.end.y: continue
            for u in us:
                var rect := Rect2(Vector2(u,y)-dimensions*0.5,dimensions)
                if not _fits(patch,rect,obstacles,used): continue
                var score := 0.0
                if kind == "map": score+=100.0 if int(patch.axis) == 2 else 0.0
                if int(patch.axis) == 2: score+=preference*(float(patch.plane)-float(patch.center_z))
                else: score+=3.0 if signf(float(patch.plane)) == preference else 0.0
                if int(patch.axis) == 0: score-=absf(float(patch.plane))*20.0
                score-=absf(u-(u0+u1)*0.5)*0.12
                choices.append({"patch":patch,"rect":rect,"score":score})
    if choices.is_empty(): return {}
    choices.sort_custom(func(a: Dictionary,b: Dictionary) -> bool: return float(a.score) > float(b.score))
    return choices[0]

func _header_slot(patches: Array,obstacles: Array,used: Array[Dictionary],header: Dictionary,dimensions: Vector2) -> Dictionary:
    for patch in patches:
        if int(patch.axis) != 0 or signf(float(patch.plane)) != float(header.side): continue
        var bounds: Rect2=patch.bounds
        for y in [float(header.top)+dimensions.y*0.5+0.025,bounds.end.y-dimensions.y*0.5-0.008,float(header.y)]:
            if y-dimensions.y*0.5 <= float(header.top)+0.012: continue
            var rect := Rect2(Vector2(float(header.z),y)-dimensions*0.5,dimensions)
            if _fits(patch,rect,obstacles,used): return {"patch":patch,"rect":rect}
    return {}

func _covered(triangles: Array,point: Vector2) -> bool:
    for triangle in triangles:
        if not (triangle.bounds as Rect2).grow(0.001).has_point(point): continue
        var p: PackedVector2Array=triangle.polygon
        var a := (p[1]-p[0]).cross(point-p[0])
        var b := (p[2]-p[1]).cross(point-p[1])
        var c := (p[0]-p[2]).cross(point-p[2])
        # Inclusive edges: points on the two triangles' shared diagonal are valid.
        if minf(a,minf(b,c)) >= -0.000001 or maxf(a,maxf(b,c)) <= 0.000001: return true
    return false

func _fits(patch: Dictionary,rect: Rect2,obstacles: Array,used: Array[Dictionary]) -> bool:
    if not (patch.bounds as Rect2).grow(0.001).encloses(rect): return false
    for entry in used:
        if int(entry.axis) == int(patch.axis) and absf(float(entry.plane)-float(patch.plane)) < 0.04:
            if (entry.rect as Rect2).grow(0.012).intersects(rect): return false
    var axis: int=patch.axis
    var u := 2 if axis == 0 else 0
    for box in patch.get("blockers",obstacles):
        var bounds: AABB=box
        if float(patch.plane) < bounds.position[axis]-0.14 or float(patch.plane) > bounds.end[axis]+0.14: continue
        var projected := Rect2(Vector2(bounds.position[u],bounds.position.y),Vector2(bounds.size[u],bounds.size.y)).grow(0.006)
        if projected.intersects(rect): return false
    for x in range(5):
        for y in range(5):
            var point := rect.position+rect.size*Vector2(float(x)/4.0,float(y)/4.0)
            if not _covered(patch.triangles,point): return false
            # Reject exterior faces hidden behind another solid interior panel.
            for triangles in patch.get("nearer",[]):
                if _covered(triangles,point): return false
    return true

func _anchor_slot(patches: Array,obstacles: Array,used: Array[Dictionary],dimensions: Vector2,kind: String,preference: float) -> Dictionary:
    # Deterministic fallback: original door jambs and the measured panel edges.
    # Every candidate still needs full original-triangle coverage and clearance.
    for patch in patches:
        if int(patch.axis) != 0: continue
        if signf(float(patch.plane)) != preference: continue
        for header in patch.headers:
            if float(header.side) != preference: continue
            var us: Array=[float(header.z)]
            if kind != "line":
                us=[float(header.start)-dimensions.x*0.5-0.025,float(header.end)+dimensions.x*0.5+0.025]
            var ys: Array=[float(header.top)+dimensions.y*0.5+0.025] if kind == "line" else [2.30,2.08,2.53]
            for u in us:
                for y in ys:
                    var rect := Rect2(Vector2(u,y)-dimensions*0.5,dimensions)
                    if _fits(patch,rect,obstacles,used): return {"patch":patch,"rect":rect}
    return {}
func _attach(slot: Dictionary,texture: Texture2D,used: Array[Dictionary]) -> void:
    var patch: Dictionary=slot.patch
    var rect: Rect2=slot.rect
    var normal: Vector3=patch.normal
    var axis: int=patch.axis
    var u := 2 if axis == 0 else 0
    var points: Array[Vector3] = []
    for point in [rect.position,rect.position+Vector2(rect.size.x,0),rect.end,rect.position+Vector2(0,rect.size.y)]:
        var v := Vector3.ZERO
        v[axis]=float(patch.plane)
        v[u]=point.x; v.y=point.y
        points.append(v+normal*MOUNT_OFFSET)
    # UVs preserve the art's exact aspect ratio; reverse winding for opposite walls.
    var uv := [Vector2(0,1),Vector2(1,1),Vector2(1,0),Vector2(0,0)]
    var order := [0,2,1,0,3,2]
    if (points[1]-points[0]).cross(points[2]-points[0]).dot(normal) < 0.0: order=[0,1,2,0,2,3]
    # Make text read left-to-right while looking at either inward-facing wall.
    var horizontal := Vector3.BACK if axis == 0 and normal.x < 0.0 else Vector3.FORWARD if axis == 0 else Vector3.RIGHT if normal.z > 0.0 else Vector3.LEFT
    var flip := (points[1]-points[0]).dot(horizontal) < 0.0
    var material := _material(texture)
    if not _tools.has(material):
        var tool := SurfaceTool.new()
        tool.begin(Mesh.PRIMITIVE_TRIANGLES)
        tool.set_material(material)
        _tools[material]=tool
    var tool := _tools[material] as SurfaceTool
    for i in order:
        var tex: Vector2=uv[i]
        if flip: tex.x=1.0-tex.x
        tool.set_normal(normal)
        tool.set_uv(tex)
        tool.add_vertex(points[i])
    used.append({"axis":axis,"plane":patch.plane,"rect":rect})
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends Node3D
## Shared passenger ticker and ceiling CCTV mounts. No train control or physics.
var _game: Node3D
var _train: Node3D
var _cars: Dictionary = {}
var _view: SubViewport
var _ticker: Control
var _labels: Array[Label] = []
var _message := ""
var _span := 512.0
var _scroll := 0.0
var _tick := 0.0
var _material: StandardMaterial3D

func initialize(game: Node3D,train: Node3D) -> void:
    _game=game
    _train=train
    _view=SubViewport.new()
    _view.name="PassengerInformationTexture"
    _view.size=Vector2i(512,64)
    _view.disable_3d=true
    _view.render_target_update_mode=SubViewport.UPDATE_DISABLED
    add_child(_view)
    var backing := ColorRect.new()
    backing.color=Color("#020803")
    backing.size=Vector2(512,64)
    _view.add_child(backing)
    _ticker=Control.new()
    _ticker.size=Vector2(512,64)
    _ticker.clip_contents=true
    _view.add_child(_ticker)
    for i in range(2):
        var label := Label.new()
        label.add_theme_font_size_override("font_size",30)
        label.add_theme_color_override("font_color",Color("#58ed78"))
        label.add_theme_color_override("font_shadow_color",Color("#155e25"))
        label.add_theme_constant_override("shadow_offset_x",1)
        label.add_theme_constant_override("shadow_offset_y",1)
        label.position.y=10
        label.mouse_filter=Control.MOUSE_FILTER_IGNORE
        _ticker.add_child(label)
        _labels.append(label)
    _material=StandardMaterial3D.new()
    _material.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED
    _material.albedo_texture=_view.get_texture()
    _material.texture_filter=BaseMaterial3D.TEXTURE_FILTER_LINEAR
    _install_cars()

func _install_cars() -> void:
    for node in _train.get_children():
        if node is Node3D and str(node.name).begins_with("OriginalV106Car"):
            _install_car(node as Node3D)

func camera_mount(car: Node3D) -> Node3D:
    _install_car(car)
    return _cars[car].mount as Node3D

func _poster_bounds(car: Node3D,body: AABB) -> AABB:
    var chosen := AABB()
    var best := -INF
    for node in car.find_children("*","MeshInstance3D",true,false):
        var mesh := node as MeshInstance3D
        if mesh.mesh == null or not mesh.is_visible_in_tree(): continue
        var bounds: AABB=car.global_transform.affine_inverse()*mesh.global_transform*mesh.get_aabb()
        var center := bounds.get_center()
        # Only a textured transverse passenger poster, never side windows/doors.
        if bounds.size.x < 0.65 or bounds.size.x > 2.25 or bounds.size.y < 0.4 or bounds.size.y > 1.5: continue
        if bounds.size.z > 0.10 or center.y < 1.8 or center.y > 3.05: continue
        if absf(center.x-body.get_center().x) > 0.7: continue
        var textured := false
        var named := str(mesh.name).to_lower().contains("goodmix")
        for surface in range(mesh.mesh.get_surface_count()):
            var material := mesh.get_active_material(surface) as BaseMaterial3D
            if material != null and material.albedo_texture != null:
                textured=true
                var description := (material.resource_name+material.albedo_texture.resource_path).to_lower()
                named=named or description.contains("goodmix")
        if not textured: continue
        # Prefer the front passenger bulkhead; named original poster wins outright.
        var score := (100.0 if named else 0.0)+bounds.size.x*2.0-center.z*0.02
        if score > best:
            best=score
            chosen=bounds
    if best == -INF:
        # Original head cab ends at -7.4 m; other cars use their model-local bounds.
        var front := maxf(body.position.z+0.25,-7.25) if str(car.name) == "OriginalV106Car01" else body.position.z+0.28
        chosen=AABB(Vector3(body.get_center().x-0.62,2.0,front),Vector3(1.24,0.78,0.025))
    return chosen

func _install_car(car: Node3D) -> void:
    if _cars.has(car): return
    var body: AABB=_game.call("_get_model_bounds",car)
    var poster := _poster_bounds(car,body)
    var sign_z := 1.0 if poster.get_center().z < body.get_center().z else -1.0
    var center_x := body.get_center().x
    var panel_width := clampf(poster.size.x,0.95,1.85)
    var panel_y := minf(3.06,poster.end.y+0.125)
    var panel_pos := Vector3(poster.get_center().x,panel_y,poster.get_center().z+sign_z*0.055)
    var black := StandardMaterial3D.new()
    black.albedo_color=Color("#111815")
    black.roughness=0.75
    var casing := BoxMesh.new()
    casing.size=Vector3(panel_width+0.055,0.21,0.065)
    casing.material=black
    var board := MeshInstance3D.new()
    board.name="PassengerInformationCase"
    board.mesh=casing
    board.position=panel_pos
    board.layers=17
    car.add_child(board)
    var face := MeshInstance3D.new()
    face.name="GreenPassengerTicker"
    var quad := QuadMesh.new()
    quad.size=Vector2(panel_width,0.155)
    quad.material=_material
    face.mesh=quad
    face.position=panel_pos+Vector3(0,0,sign_z*0.034)
    face.rotation.y=0.0 if sign_z > 0.0 else PI
    face.layers=17
    face.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
    car.add_child(face)
    var mount := Node3D.new()
    mount.name="SaloonCeilingCameraAnchor"
    # Right upper corner marked by the user, slightly inside the passenger volume.
    var right_x := minf(body.end.x-0.28,center_x+1.03)
    mount.position=Vector3(right_x,3.01,poster.get_center().z+sign_z*0.48)
    car.add_child(mount)
    var look := Vector3(center_x,1.95,poster.get_center().z+sign_z*8.0)
    mount.look_at(car.to_global(look),car.global_basis.y.normalized())
    var housing := Node3D.new()
    housing.name="SaloonCeilingDomeCamera"
    housing.position=mount.position+Vector3(0,0.10,0)
    car.add_child(housing)
    var white := StandardMaterial3D.new()
    white.albedo_color=Color("#d1d5cf")
    white.roughness=0.5
    var foot := CylinderMesh.new()
    foot.top_radius=0.105; foot.bottom_radius=0.105
    foot.height=0.025; foot.radial_segments=16; foot.material=white
    _mesh(housing,foot,Vector3(0,0.032,0))
    var dome := SphereMesh.new()
    dome.radius=0.085; dome.height=0.105
    dome.radial_segments=16; dome.rings=8; dome.material=black
    _mesh(housing,dome,Vector3(0,-0.022,0))
    var lens := SphereMesh.new()
    lens.radius=0.025; lens.height=0.05
    lens.radial_segments=12; lens.rings=6
    var glass := StandardMaterial3D.new()
    glass.albedo_color=Color("#1c3941"); glass.metallic=0.45; glass.roughness=0.18
    lens.material=glass
    var lens_node := _mesh(housing,lens,Vector3(0,-0.04,sign_z*0.064))
    _cars[car]={"mount":mount,"housing":housing,"lens":lens_node,"face":face}

func _mesh(parent: Node3D,mesh: Mesh,pos: Vector3) -> MeshInstance3D:
    var instance := MeshInstance3D.new()
    instance.mesh=mesh
    instance.position=pos
    instance.layers=17
    parent.add_child(instance)
    return instance

func _process(delta: float) -> void:
    if not is_instance_valid(_game) or not is_instance_valid(_view): return
    # Fourth original car is attached asynchronously by the existing scene.
    _install_cars()
    var viewer := get_viewport().get_camera_3d()
    var nearby := false
    for car in _cars:
        var entry: Dictionary=_cars[car]
        var housing := entry.housing as Node3D
        var mount := entry.mount as Node3D
        var using_this := str(_game.get("camera_mode")) == "salon" and viewer != null and viewer.global_position.distance_squared_to(mount.global_position) < 0.16
        housing.visible=not using_this
        if viewer != null and viewer.global_position.distance_squared_to((entry.face as Node3D).global_position) < 10000.0: nearby=true
    if not nearby: return
    _scroll+=delta*43.0
    _tick+=delta
    if _tick < 0.05: return
    _tick=0.0
    var information: Dictionary=_game.call("passenger_information")
    var message := str(information.get("current_station","")) if bool(information.get("at_station",false)) else "НАСТУПНАЯ СТАНЦЫЯ — "+str(information.get("next_station","УРУЧЧА"))
    if bool(information.get("at_station",false)): message="СТАНЦЫЯ — "+message
    if message != _message:
        _message=message
        _scroll=0.0
        var font := ThemeDB.fallback_font
        _span=maxf(512.0,font.get_string_size(_message,HORIZONTAL_ALIGNMENT_LEFT,-1,30).x+90.0)
        for label in _labels: label.text=_message
    var offset := fposmod(_scroll,_span)
    for i in range(_labels.size()): _labels[i].position.x=-offset+float(i)*_span
    _view.render_target_update_mode=SubViewport.UPDATE_ONCE
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends RefCounted
## Runtime visual overrides only. Original meshes/material resources are never edited.
const WEAR = preload("res://assets/saloon_v49/interior_wear.gdshader")
const DO_NOT_LEAN = preload("res://assets/saloon_v49/do_not_lean.svg")
# Explicit dependency for the fixed-mount artwork loader / standalone staging.
const EMERGENCY_EXIT = preload("res://assets/saloon_v49/emergency_exit.svg")
const MOUNTS := "res://assets/saloon_v49/mounts.json"
const PRINT_LAYERS := 1 | (1 << 4)
# Original GLB linear colours: floor, blue upholstery, beige panels, handrails.
const COLOURS := [Vector3(0.162029,0.177888,0.181164),Vector3(0.029557,0.057805,0.095307),Vector3(0.679542,0.637597,0.520996),Vector3(0.386429,0.401978,0.376262)]

static func apply(train: Node3D,door_system: Node) -> void:
    var visual = load("res://scripts/depot/saloon_realism_v49.gd").new()
    var mounts: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(MOUNTS))
    var leaves: Array = door_system.get("leaves")
    var index := 0
    for car in train.get_children():
        if not mounts.has(str(car.name)): continue
        visual._car(car,mounts[str(car.name)],leaves,index)
        index+=1

func _car(car: Node3D,layout: Dictionary,leaves: Array,index: int) -> void:
    if car.has_meta("v49_visuals"): return
    var moving: Array[Node3D] = []
    var labels := 0
    for leaf in leaves:
        var root := leaf.parts[0].node as Node3D
        if not car.is_ancestor_of(root): continue
        moving.append(root)
        if _glass_label(car,root): labels+=1
    var counts := [0,0,0,0]
    for node in car.find_children("*","MeshInstance3D",true,false):
        var mesh := node as MeshInstance3D
        if mesh.mesh == null: continue
        var skip := false
        var ancestor: Node = mesh
        while ancestor != car:
            if str(ancestor.name) in ["OriginalCabIntegration","SaloonArtworkV46","V49DoNotLean"] or ancestor in moving:
                skip=true
                break
            ancestor=ancestor.get_parent()
        if skip: continue
        for surface in range(mesh.mesh.get_surface_count()):
            var material := mesh.get_active_material(surface) as StandardMaterial3D
            if material == null or material.transparency != BaseMaterial3D.TRANSPARENCY_DISABLED or material.albedo_texture != null: continue
            var kind := _kind(material.albedo_color)
            if kind < 0: continue
            var wear := ShaderMaterial.new()
            wear.shader=WEAR
            wear.set_shader_parameter("base_color",material.albedo_color)
            wear.set_shader_parameter("original_metallic",material.metallic)
            wear.set_shader_parameter("original_roughness",material.roughness)
            wear.set_shader_parameter("surface_kind",kind)
            wear.set_shader_parameter("mesh_to_car",car.global_transform.affine_inverse()*mesh.global_transform)
            wear.set_shader_parameter("passenger_z",Vector2(layout.passenger_z[0],layout.passenger_z[1]))
            wear.set_shader_parameter("doorway_z",Vector4(layout.door_z[0],layout.door_z[1],layout.door_z[2],layout.door_z[3]))
            wear.set_shader_parameter("car_seed",float(index+1))
            mesh.set_surface_override_material(surface,wear)
            counts[kind]+=1
    car.set_meta("v49_visuals",{"material_surfaces":counts,"glass_labels":labels})
    print("V49_MATERIALS car=%s surfaces=%s glass_labels=%d" % [car.name,counts,labels])

func _kind(colour: Color) -> int:
    var linear := colour.srgb_to_linear()
    for i in range(COLOURS.size()):
        if Vector3(colour.r,colour.g,colour.b).distance_to(COLOURS[i]) < 0.006 or Vector3(linear.r,linear.g,linear.b).distance_to(COLOURS[i]) < 0.006:
            return i
    return -1

func _glass_label(car: Node3D,root: Node3D) -> bool:
    if root.has_node("V49DoNotLean"): return true
    for node in root.find_children("*","MeshInstance3D",true,false):
        var glass := node as MeshInstance3D
        if glass.mesh == null: continue
        var transparent := false
        for surface in range(glass.mesh.get_surface_count()):
            var material := glass.get_active_material(surface) as BaseMaterial3D
            if material != null and material.transparency != BaseMaterial3D.TRANSPARENCY_DISABLED:
                transparent=true
        if not transparent: continue
        var box: AABB = (car.global_transform.affine_inverse()*glass.global_transform)*glass.mesh.get_aabb()
        if box.size.x > 0.1 or box.size.z < 0.15 or box.size.y < 0.3 or box.get_center().y < 1.3: continue
        var normal := Vector3(-signf(box.get_center().x),0,0)
        var center := box.get_center()
        center.x=box.position.x if normal.x < 0.0 else box.end.x
        center+=normal*0.003
        center.y=box.position.y+box.size.y*0.52
        var right := Vector3.BACK if normal.x < 0.0 else Vector3.FORWARD
        var width := minf(0.44,box.size.z*0.88)
        var up := Vector3.UP*width*240.0/1024.0*0.5
        right*=width*0.5
        var transform := root.global_transform.affine_inverse()*car.global_transform
        var points := [center-right-up,center+right-up,center+right+up,center-right+up]
        var uv := [Vector2(0,1),Vector2(1,1),Vector2(1,0),Vector2(0,0)]
        var material := StandardMaterial3D.new()
        material.albedo_texture=DO_NOT_LEAN
        material.transparency=BaseMaterial3D.TRANSPARENCY_ALPHA
        material.cull_mode=BaseMaterial3D.CULL_DISABLED
        material.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED
        material.texture_repeat=false
        material.texture_filter=BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
        var tool := SurfaceTool.new()
        tool.begin(Mesh.PRIMITIVE_TRIANGLES)
        for i in [0,2,1,0,3,2]:
            tool.set_normal((transform.basis*normal).normalized())
            tool.set_uv(uv[i])
            tool.add_vertex(transform*points[i])
        var label := MeshInstance3D.new()
        label.name="V49DoNotLean"
        label.mesh=tool.commit()
        label.material_override=material
        label.layers=PRINT_LAYERS
        label.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
        root.add_child(label)
        return true
    return false
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends RefCounted
## 81-717.5 reference: Kun, Metrovagonmash operating manual (1993), chapter 2.
## https://djvu.online/file/hm3MBHnsxWZgp
## Photo reference: mwms.tmholding.ru/media/events/ (81-717 overhaul workshop).
## 780 mm tread diameter; 2100 mm bogie wheelbase; 1520 mm running gauge.
const Route = preload("res://scripts/depot/route_profile.gd")
const RADIUS := 0.390
const HALF_BASE := 1.050
var _cars: Dictionary = {}
var _bodies: Dictionary = {}
var _materials: Dictionary = {}
var _parts: Dictionary = {}
var _frame: ArrayMesh
var _wheels: Array[ArrayMesh] = []
var _cube: BoxMesh
var _cylinder: CylinderMesh

func _init() -> void:
    for entry in [["frame",Color("#38403f"),0.48,0.73],["edge",Color("#59615d"),0.55,0.61],["rubber",Color("#242a27"),0.0,0.94],["wheel",Color("#414844"),0.65,0.62],["tread",Color("#969e9c"),0.86,0.30],["bolt",Color("#777f79"),0.65,0.55]]:
        var material := StandardMaterial3D.new()
        material.albedo_color=entry[1]
        material.metallic=float(entry[2]); material.roughness=float(entry[3])
        _materials[entry[0]]=material
    _cube=BoxMesh.new(); _cube.size=Vector3.ONE
    _cylinder=CylinderMesh.new()
    _cylinder.top_radius=0.5; _cylinder.bottom_radius=0.5
    _cylinder.height=1.0; _cylinder.radial_segments=16
    _make_frame()
    _wheels.append(_wheel_mesh(-1.0))
    _wheels.append(_wheel_mesh(1.0))

func body_bounds(car: Node3D,fallback: AABB) -> AABB:
    if _bodies.has(car): return _bodies[car]
    var found := false
    var body := AABB()
    for node in car.find_children("*","MeshInstance3D",true,false):
        var mesh := node as MeshInstance3D
        if mesh.mesh == null: continue
        var bounds: AABB=car.global_transform.affine_inverse()*mesh.global_transform*mesh.get_aabb()
        if bounds.size.x < 1.8 or bounds.size.y < 0.15 or bounds.get_center().y < 0.8: continue
        body=bounds if not found else body.merge(bounds)
        found=true
    if not found or body.size.z < fallback.size.z*0.75: body=fallback
    _bodies[car]=body
    return body

func half_body_gap(first: Node3D,first_full: AABB,second: Node3D,second_full: AABB) -> float:
    var a := body_bounds(first,first_full)
    var b := body_bounds(second,second_full)
    # Old full-bounds spacing includes the protruding couplers: halve the
    # actual distance between body faces, rather than just the old 250 mm term.
    return maxf(0.04,(first_full.end.z-a.end.z+b.position.z-second_full.position.z+0.25)*0.5)

func shorten_original_coupler(car: Node3D,front: bool) -> void:
    if not _bodies.has(car): return
    var body: AABB=_bodies[car]
    for node in car.find_children("*","MeshInstance3D",true,false):
        var mesh := node as MeshInstance3D
        if mesh.mesh == null: continue
        var bounds: AABB=car.global_transform.affine_inverse()*mesh.global_transform*mesh.get_aabb()
        if bounds.end.y > 0.80 or bounds.size.z > 1.6 or bounds.size.x > 1.3: continue
        var outside := bounds.get_center().z < body.position.z+0.08 if front else bounds.get_center().z > body.end.z-0.08
        if outside:
            mesh.hide()
            mesh.set_meta("replaced_intercar_coupler",true)

func setup_car(car: Node3D,bounds: AABB,rest: Transform3D) -> PackedFloat32Array:
    if _cars.has(car): return _cars[car].supports
    var positions: Array[float] = []
    for node in car.find_children("*","MeshInstance3D",true,false):
        var mesh := node as MeshInstance3D
        if mesh.mesh == null: continue
        var box: AABB=car.global_transform.affine_inverse()*mesh.global_transform*mesh.get_aabb()
        var c := box.get_center()
        if box.size.y < 0.57 or box.size.y > 1.05 or box.size.z < 0.57 or box.size.z > 1.05: continue
        if box.size.x > 0.45 or absf(c.x-bounds.get_center().x) < 0.50 or c.y > 0.62: continue
        var duplicate := false
        for z in positions:
            if absf(z-c.z) < 0.12: duplicate=true
        if not duplicate: positions.append(c.z)
    positions.sort()
    var centers := PackedFloat32Array()
    if positions.size() >= 4:
        centers.append((positions[0]+positions[1])*0.5)
        centers.append((positions[-2]+positions[-1])*0.5)
    else:
        centers.append(bounds.get_center().z-6.3)
        centers.append(bounds.get_center().z+6.3)
    _retire_old_geometry(car,centers,bounds.get_center().x)
    var supports := PackedFloat32Array()
    var bogies: Array[Dictionary] = []
    for center in centers:
        var support := rest*Vector3(bounds.get_center().x,0.0,center)
        supports.append(support.z)
        var root := Node3D.new()
        root.name="Detailed81_717Bogie"
        root.set_meta("bogie_visual",true)
        car.add_child(root)
        var frame := MeshInstance3D.new()
        frame.name="WeldedFrameSuspensionAndDrive"
        frame.mesh=_frame
        frame.layers=1
        root.add_child(frame)
        var wheels: Array[Node3D] = []
        for z in [-HALF_BASE,HALF_BASE]:
            for side_index in range(2):
                var side := -1.0 if side_index == 0 else 1.0
                var wheel := MeshInstance3D.new()
                wheel.name="ProfiledFlangedWheel"
                wheel.mesh=_wheels[side_index]
                wheel.position=Vector3(side*Route.RAIL_CENTER,0,z)
                wheel.layers=1
                root.add_child(wheel)
                wheels.append(wheel)
        bogies.append({"root":root,"z":support.z,"wheels":wheels})
    supports.sort()
    _cars[car]={"supports":supports,"bogies":bogies}
    return supports

func _retire_old_geometry(car: Node3D,centers: PackedFloat32Array,center_x: float) -> void:
    # Only the old low undercarriage within the two wheelbase envelopes.
    # Floor, longitudinal underframe and body geometry stay in place.
    for node in car.find_children("*","MeshInstance3D",true,false):
        var mesh := node as MeshInstance3D
        if mesh.mesh == null: continue
        var bounds: AABB=car.global_transform.affine_inverse()*mesh.global_transform*mesh.get_aabb()
        if bounds.end.y > 0.91 or bounds.size.z > 3.7 or bounds.size.x > 2.65: continue
        if bounds.position.y < -0.40 or absf(bounds.get_center().x-center_x) > 1.5: continue
        for z in centers:
            if bounds.position.z >= z-1.85 and bounds.end.z <= z+1.85:
                mesh.hide()
                mesh.set_meta("replaced_bogie_geometry",true)
                break

func update_car(car: Node3D,train: Node3D,distance: float) -> void:
    if not _cars.has(car): return
    for bogie in _cars[car].bogies:
        var z: float=train.global_position.z+float(bogie.z)
        var pitch := -atan(Route.grade(z))
        var projected := HALF_BASE*cos(pitch)
        var a := Route.height(z-projected)
        var b := Route.height(z+projected)
        pitch=-atan2(b-a,projected*2.0)
        # Global rail datum prevents model-origin/lateral offsets and inherited
        # body pitch from moving the tread off the two running railheads.
        var root := bogie.root as Node3D
        root.global_transform=Transform3D(Basis(Vector3.RIGHT,pitch),Vector3(Route.CENTER_X,(a+b)*0.5+RADIUS,z))
        for wheel in bogie.wheels:
            (wheel as Node3D).rotation.x=fposmod((distance-Route.START_Z)/RADIUS,TAU)

func _part(mesh: Mesh,material: String,pose: Transform3D) -> void:
    if not _parts.has(material):
        var tool := SurfaceTool.new()
        tool.begin(Mesh.PRIMITIVE_TRIANGLES)
        tool.set_material(_materials[material])
        _parts[material]=tool
    (_parts[material] as SurfaceTool).append_from(mesh,0,pose)

func _box(pos: Vector3,size: Vector3,material: String = "frame",basis: Basis = Basis.IDENTITY) -> void:
    _part(_cube,material,Transform3D(basis*Basis.from_scale(size),pos))

func _cyl(pos: Vector3,radius: float,length: float,material: String = "frame",axis: Vector3 = Vector3.UP) -> void:
    var basis := Basis(Quaternion(Vector3.UP,axis.normalized()))
    _part(_cylinder,material,Transform3D(basis*Basis.from_scale(Vector3(radius*2,length,radius*2)),pos))

func _rod(a: Vector3,b: Vector3,radius: float,material: String = "frame") -> void:
    _cyl((a+b)*0.5,radius,a.distance_to(b),material,b-a)

func _spring(radius: float,height: float,wire: float) -> ArrayMesh:
    var tool := SurfaceTool.new()
    tool.begin(Mesh.PRIMITIVE_TRIANGLES)
    var steps := 54
    var sides := 6
    for i in range(steps):
        for j in range(sides):
            for pair in [Vector2i(i,j),Vector2i(i+1,j),Vector2i(i+1,j+1),Vector2i(i,j),Vector2i(i+1,j+1),Vector2i(i,j+1)]:
                var t := float(pair.x)/float(steps)
                var angle := t*TAU*4.5
                var tube := float(pair.y)*TAU/float(sides)
                var radial := Vector3(cos(angle),0,sin(angle))
                var normal := radial*cos(tube)+Vector3.UP*sin(tube)
                var center := radial*radius+Vector3.UP*((t-0.5)*height)
                tool.set_normal(normal)
                tool.set_uv(Vector2(t,float(pair.y)/float(sides)))
                tool.add_vertex(center+normal*wire)
    return tool.commit()

func _make_frame() -> void:
    var primary := _spring(0.077,0.23,0.016)
    var secondary := _spring(0.135,0.27,0.022)
    for side in [-1.0,1.0]:
        var x: float=side*1.025
        # Pressed/welded box side member with raised bearing pedestals.
        _box(Vector3(x,0.33,0),Vector3(0.17,0.22,2.78))
        _box(Vector3(x,0.447,0),Vector3(0.20,0.025,2.78),"edge")
        _box(Vector3(x,0.21,0),Vector3(0.19,0.025,2.70),"edge")
        for z in [-HALF_BASE,HALF_BASE]:
            _box(Vector3(x,0.01,z),Vector3(0.27,0.24,0.30))
            _cyl(Vector3(side*1.18,0.01,z),0.115,0.055,"edge",Vector3.RIGHT)
            _cyl(Vector3(side*1.212,0.01,z),0.072,0.018,"frame",Vector3.RIGHT)
            for bolt in range(6):
                var angle := float(bolt)*TAU/6.0
                _cyl(Vector3(side*1.224,sin(angle)*0.087+0.01,z+cos(angle)*0.087),0.014,0.019,"bolt",Vector3.RIGHT)
            for dz in [-0.21,0.21]:
                var spring_pos := Vector3(x,0.19,z+dz)
                _part(primary,"frame",Transform3D(Basis.IDENTITY,spring_pos))
                _cyl(spring_pos+Vector3(0,-0.13,0),0.10,0.025,"edge")
                _cyl(spring_pos+Vector3(0,0.13,0),0.10,0.025,"edge")
            _rod(Vector3(x,0.12,z),Vector3(x,0.31,z-signf(z)*0.42),0.027,"edge")
        # Two-stage central spring bolster, hangers and dampers.
        for z in [-0.29,0.29]:
            _part(secondary,"frame",Transform3D(Basis.IDENTITY,Vector3(side*0.92,0.39,z)))
            _cyl(Vector3(side*0.92,0.24,z),0.16,0.035,"edge")
            _cyl(Vector3(side*0.92,0.54,z),0.16,0.035,"edge")
            _rod(Vector3(side*1.12,0.20,z),Vector3(side*1.12,0.59,z+0.04),0.024,"edge")
        _rod(Vector3(side*1.13,0.18,-0.48),Vector3(side*1.13,0.48,-0.17),0.040)
        _rod(Vector3(side*1.13,0.37,-0.29),Vector3(side*1.13,0.59,-0.05),0.019,"tread")
        # Brake cylinder and its longitudinal rod/linkage.
        _cyl(Vector3(side*1.12,0.20,0.64),0.075,0.38,"edge",Vector3.BACK)
        _rod(Vector3(side*1.12,0.20,0.43),Vector3(side*1.12,0.13,-0.55),0.018,"bolt")
        _rod(Vector3(side*1.17,0.13,-0.55),Vector3(side*1.17,-0.04,-0.74),0.022)
        _rod(Vector3(side*1.08,0.47,-1.30),Vector3(side*1.08,0.47,1.30),0.012,"rubber")
    for z in [-0.48,0.48]:
        _box(Vector3(0,0.32,z),Vector3(1.95,0.21,0.20))
        _box(Vector3(0,0.43,z),Vector3(1.97,0.025,0.23),"edge")
    _box(Vector3(0,0.58,0),Vector3(2.18,0.16,0.28))
    _cyl(Vector3(0,0.72,0),0.20,0.12,"edge")
    _cyl(Vector3(0,0.79,0),0.14,0.025,"rubber")
    for z in [-HALF_BASE,HALF_BASE]:
        _cyl(Vector3(0,0,z),0.075,2.30,"wheel",Vector3.RIGHT)
        var toward_center := -signf(z)
        # Frame-mounted traction motor, ribbed casing, axle gearbox and coupling.
        var motor_z: float=z+toward_center*0.40
        _cyl(Vector3(-0.15,0.17,motor_z),0.17,0.80,"frame",Vector3.RIGHT)
        for x in [-0.49,-0.34,-0.19,-0.04,0.11,0.26]:
            _cyl(Vector3(x,0.17,motor_z),0.182,0.018,"edge",Vector3.RIGHT)
        _box(Vector3(0.45,0.04,z+0.10*toward_center),Vector3(0.28,0.36,0.44))
        _cyl(Vector3(0.61,0.02,z),0.17,0.055,"edge",Vector3.RIGHT)
        _rod(Vector3(0.45,0.25,z),Vector3(0.43,0.39,z+toward_center*0.30),0.035,"edge")
        for side in [-1.0,1.0]:
            for end in [-1.0,1.0]:
                # Segmented curved shoe follows the wheel rim, not a square block.
                for segment in [-1.0,0.0,1.0]:
                    var angle: float=(0.0 if end > 0.0 else PI)+segment*0.17
                    _box(Vector3(side*Route.RAIL_CENTER,sin(angle)*0.414,z+cos(angle)*0.414),Vector3(0.09,0.075,0.035),"rubber",Basis(Vector3.RIGHT,-angle))
                _rod(Vector3(side*1.03,0.30,z+end*0.30),Vector3(side*0.95,0.03,z+end*0.43),0.025,"edge")
    _frame=ArrayMesh.new()
    for tool in _parts.values(): (tool as SurfaceTool).commit(_frame)
    _frame.resource_name="81_717MotorBogieFrame"
    _parts.clear()

func _wheel_mesh(side: float) -> ArrayMesh:
    # Axial/radial profile: deep hub, dished web, inner flange and polished tread.
    var profile := PackedVector2Array([Vector2(-0.105,0.080),Vector2(-0.105,0.15),Vector2(-0.05,0.17),Vector2(-0.026,0.29),Vector2(-0.073,0.35),Vector2(-0.073,0.407),Vector2(-0.055,0.416),Vector2(-0.032,0.402),Vector2(-0.025,0.390),Vector2(0.050,0.390),Vector2(0.070,0.383),Vector2(0.070,0.338),Vector2(0.025,0.30),Vector2(0.008,0.17),Vector2(0.095,0.15),Vector2(0.105,0.115),Vector2(0.105,0.080)])
    var wheel := ArrayMesh.new()
    for polished in [false,true]:
        var tool := SurfaceTool.new()
        tool.begin(Mesh.PRIMITIVE_TRIANGLES)
        tool.set_material(_materials["tread" if polished else "wheel"])
        for segment in range(profile.size()):
            if (segment >= 5 and segment <= 10) != polished: continue
            var next := (segment+1)%profile.size()
            var edge := profile[next]-profile[segment]
            for step in range(64):
                var corners := [Vector2i(segment,step),Vector2i(next,step),Vector2i(next,step+1),Vector2i(segment,step+1)]
                var order := [0,1,2,0,2,3] if side > 0.0 else [0,2,1,0,3,2]
                for index in order:
                    var pair: Vector2i=corners[index]
                    var p := profile[pair.x]
                    var angle := float(pair.y)*TAU/64.0
                    tool.set_normal(Vector3(-edge.y*side,edge.x*cos(angle),edge.x*sin(angle)).normalized())
                    tool.set_uv(Vector2(float(pair.y)/64.0,float(pair.x)/float(profile.size())))
                    tool.add_vertex(Vector3(p.x*side,p.y*cos(angle),p.y*sin(angle)))
        tool.commit(wheel)
    wheel.resource_name="81_717ProfiledWheel780"
    return wheel
extends RefCounted
const Route = preload("res://scripts/depot/route_profile.gd")

## Shared original placement and bogies; both legacy and modular trains call this.
static func place(game: Node3D, pose_cache: Dictionary, rest_poses: Dictionary) -> void:
    if not is_instance_valid(game.train): return
    for node in game.train.get_children():
        if not node is Node3D: continue
        var car := node as Node3D
        if str(car.name).begins_with("OriginalV106Car"):
            if not pose_cache.has(car): pose_cache[car] = game._get_model_bounds(car)
            if not rest_poses.has(car): rest_poses[car] = car.transform
            var bounds: AABB = pose_cache[car]
            var rest: Transform3D = rest_poses[car]
            var center := rest*bounds.get_center()
            var supports: PackedFloat32Array = game._bogie_visuals.setup_car(car,bounds,rest)
            var front_y := Route.height(game.train.global_position.z+supports[0])
            var rear_y := Route.height(game.train.global_position.z+supports[1])
            var support_span := maxf(0.1,supports[1]-supports[0])
            var pitch := -atan2(rear_y-front_y,support_span)
            var basis := Basis(Vector3.RIGHT,pitch)*rest.basis
            # Exported cars have different model origins. Rotate about each
            # carriage centre, never its possibly distant GLB origin.
            var balance := (center.z-supports[0])/support_span
            var target := center+Vector3(0,lerpf(front_y,rear_y,balance),0)
            car.transform = Transform3D(basis,target-basis*bounds.get_center())
            game._bogie_visuals.update_car(car,game.train,game.distance)
        elif car.get_child_count() > 0 and car.get_child(0) is MeshInstance3D:
            if not car.has_meta("route_coupler_z"):
                var z := (car.get_child(0) as Node3D).position.z
                car.set_meta("route_coupler_z",z)
                car.position.z = z
                for child in car.get_children():
                    if child is Node3D: (child as Node3D).position.z -= z
            var z := float(car.get_meta("route_coupler_z"))
            car.position.y = Route.height(game.train.global_position.z+z)
            car.rotation.x = -atan(Route.grade(game.train.global_position.z+z))

␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends Node3D
## Shared train-only lighting: no tunnel geometry receives layer 16.
const SALOON_LAYER := 16
var lights: Array[OmniLight3D] = []
var emitters: Array[BaseMaterial3D] = []
var enabled := true
var button: Button
var cars_lit := 0

func initialize(game: Node3D, train: Node3D, ui: CanvasLayer) -> void:
    var cab := game.get("cab_runtime") as Node3D
    for node in train.get_children():
        if not str(node.name).begins_with("OriginalV106Car0"): continue
        var car := node as Node3D
        var box: AABB = game.call("_get_model_bounds",car)
        var start := maxf(box.position.z,-7.4) if str(car.name) == "OriginalV106Car01" else box.position.z
        var length := box.end.z-start
        for mesh_node in car.find_children("*","MeshInstance3D",true,false):
            var mesh := mesh_node as MeshInstance3D
            if cab != null and cab.is_ancestor_of(mesh): continue
            var bounds := car.global_transform.affine_inverse()*mesh.global_transform*mesh.get_aabb()
            if str(car.name) == "OriginalV106Car01" and bounds.end.z < -7.6: continue
            mesh.layers |= SALOON_LAYER
            # Only existing narrow ceiling luminaire surfaces, never whole walls.
            if bounds.position.y > 3.0 and bounds.size.y < 0.12:
                for surface in range(mesh.mesh.get_surface_count()):
                    var original := mesh.get_active_material(surface) as BaseMaterial3D
                    if original == null: continue
                    var color := original.albedo_color
                    if minf(color.r,minf(color.g,color.b)) < 0.72: continue
                    if bounds.size.x > 0.8 and bounds.size.z > 0.8 and original.shading_mode != BaseMaterial3D.SHADING_MODE_UNSHADED: continue
                    var material := original.duplicate() as BaseMaterial3D
                    material.shading_mode = BaseMaterial3D.SHADING_MODE_PER_PIXEL
                    material.emission_enabled = true
                    material.emission = Color(0.86,0.90,0.94)
                    mesh.set_surface_override_material(surface,material)
                    emitters.append(material)
        for fraction in [0.20,0.50,0.80]:
            var lamp := OmniLight3D.new()
            lamp.name = "SaloonCeilingLight"
            lamp.position = Vector3(box.get_center().x,3.12,start+length*float(fraction))
            lamp.light_color = Color(0.98,0.98,1.0)
            lamp.light_energy = 1.25
            lamp.omni_range = 6.2
            lamp.omni_attenuation = 1.15
            lamp.light_cull_mask = SALOON_LAYER
            lamp.shadow_enabled = false
            car.add_child(lamp)
            lights.append(lamp)
        cars_lit += 1
    button = Button.new()
    button.position = Vector2(495,55)
    button.custom_minimum_size = Vector2(240,42)
    button.toggle_mode = true
    ui.add_child(button)
    button.pressed.connect(func(): enabled = not enabled; _apply())
    _apply()
    print("SALOON_LIGHTING_READY cars=",cars_lit," lights=",lights.size()," emitters=",emitters.size())

func _apply() -> void:
    for lamp in lights: lamp.visible = enabled
    for material in emitters:
        material.emission_energy_multiplier = 0.65 if enabled else 0.0
    button.text = "СВЕТ САЛОНОВ: "+("ВКЛ." if enabled else "ВЫКЛ.")
    button.set_pressed_no_signal(enabled)
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends Node3D
const CAB_RUNTIME = preload("res://scripts/cab_v37.gd")
const DOOR_SYSTEM = preload("res://scripts/v33_door_controller.gd")
const BOGIE_VISUALS = preload("res://scripts/depot/v106_bogies.gd")
const CAR03_SCENE = preload("res://assets/v106_original/car03/v106_car_03.glb")
const CAR02_SCENE = preload("res://assets/v106_original/car02/v106_car_02.glb")
const V106_SCENE = preload("res://assets/v106_lod1/v106_car01_lod1_mesh289_normals_fixed.glb")
## Touch orbit camera around the imported V106 wagon.
var camera: Camera3D
var train: Node3D
var speed := 0.0
var throttle := false
var brake := false
var hud: Label
@export var route_end_distance := 12.0
@export var tunnel_script: Script
var distance := 300.0
var orbit_yaw := 0.35
var orbit_pitch := 0.10
var orbit_radius := 4.6
var _touch_points: Dictionary = {}
var camera_touch_id := -1
var _pinching := false
var _pinch_distance := 0.0
var _cab_fov := 80.0
var touch_dragging := false
var touch_last := Vector2.ZERO
var wagon_center := Vector3(0, 1.2, 0)
var camera_pan := Vector3.ZERO
var camera_move: Dictionary = {}
const CAMERA_MOVE_SPEED := 7.0
signal station_approach_changed(distance_m: float, illumination: float)
var _tunnel: Node3D
var _train_bounds := AABB()
var camera_mode := "external"
var _environment: Environment
var _station: Node3D
var _station_stop_z := 0.0
var _diagnostics_enabled := false
var _diagnostic_clock := 0.0
var _focused_car := 0
var _car_centers: Array[Vector3] = []
var cab_runtime: Node3D
var door_system: Node
var _ui_layer: CanvasLayer
var info_binding: Node
var _bogie_visuals = BOGIE_VISUALS.new()

func _ready() -> void:
    get_window().focus_exited.connect(_reset_camera_touch)
    get_viewport().size_changed.connect(_reset_camera_touch)
    print("TZ30_BOOT ready")
    _diagnostics_enabled = OS.has_feature("web")
    print("TZ30_BOOT diagnostics configured")
    _create_world_environment()
    train = Node3D.new()
    train.name = "PlayerTrainPlacement"
    add_child(train)
    train.position = Vector3(0.992, 0.22, distance)
    var original_car := V106_SCENE.instantiate()
    original_car.name = "OriginalV106Car01"
    train.add_child(original_car)
    var second_car := CAR02_SCENE.instantiate()
    second_car.name = "OriginalV106Car02"
    train.add_child(second_car)
    print("V106 SINGLE CAR: imported model instantiated")
    var bounds := _get_model_bounds(original_car)
    if bounds.size.length() > 0.01:
        wagon_center = bounds.get_center()
        orbit_radius = 4.6
        print("V106 BOUNDS: ", bounds)
    var second_bounds := _get_model_bounds(second_car)
    if bounds.size.z > 1.0 and second_bounds.size.z > 1.0:
        # Align bounding-box ends, irrespective of each GLB origin.
        var first_body: AABB = _bogie_visuals.body_bounds(original_car,bounds)
        var second_body: AABB = _bogie_visuals.body_bounds(second_car,second_bounds)
        var gap: float = _bogie_visuals.half_body_gap(original_car,bounds,second_car,second_bounds)
        second_car.position.z = first_body.end.z + gap - second_body.position.z
        _bogie_visuals.shorten_original_coupler(original_car,false)
        _bogie_visuals.shorten_original_coupler(second_car,true)
        print("CAR02 aligned to CAR01: offset=", second_car.position.z, " gap=", gap)
        _add_visible_coupler(first_body, second_body, second_car.position.z, gap)
    var third_car := CAR03_SCENE.instantiate()
    third_car.name = "OriginalV106Car03"
    train.add_child(third_car)
    var third_bounds := _get_model_bounds(third_car)
    if second_bounds.size.z > 1.0 and third_bounds.size.z > 1.0:
        var second_body: AABB = _bogie_visuals.body_bounds(second_car,second_bounds)
        var third_body: AABB = _bogie_visuals.body_bounds(third_car,third_bounds)
        var third_gap: float = _bogie_visuals.half_body_gap(second_car,second_bounds,third_car,third_bounds)
        third_car.position.z = second_car.position.z + second_body.end.z + third_gap - third_body.position.z
        _bogie_visuals.shorten_original_coupler(second_car,false)
        _bogie_visuals.shorten_original_coupler(third_car,true)
        _add_visible_coupler_between(second_car, second_body, third_car, third_body, third_gap)
    # Car04 is loaded after the first frame; avoid blocking initial scene setup.
    call_deferred("_attach_fourth_car", third_car, third_bounds)
    _create_route_tunnel()
    camera = Camera3D.new()
    camera.current = true
    camera.far = 120
    camera.near = 0.04
    add_child(camera)
    var ui := CanvasLayer.new()
    _ui_layer = ui
    add_child(ui)
    hud = Label.new()
    hud.position = Vector2(15, 15)
    hud.add_theme_font_size_override("font_size", 22)
    hud.add_theme_color_override("font_color", Color.YELLOW)
    ui.add_child(hud)
    orbit_radius = 8.0
    var row := HBoxContainer.new()
    row.set_anchors_preset(Control.PRESET_BOTTOM_WIDE)
    row.offset_top = -90
    ui.add_child(row)
    var go := Button.new()
    go.text = "РАЗГОН"
    go.custom_minimum_size = Vector2(180, 75)
    go.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    row.add_child(go)
    go.button_down.connect(func(): throttle = true)
    go.button_up.connect(func(): throttle = false; _publish_diagnostics())
    var stop := Button.new()
    stop.text = "ТОРМОЗ"
    stop.custom_minimum_size = Vector2(180, 75)
    stop.size_flags_horizontal = Control.SIZE_EXPAND_FILL
    row.add_child(stop)
    stop.button_down.connect(func(): brake = true)
    stop.button_up.connect(func(): brake = false; _publish_diagnostics())
    _add_camera_controls(ui)
    _add_view_modes(ui)
    _update_camera()
    _configure_tunnel()

func _attach_fourth_car(third_car: Node3D, third_bounds: AABB) -> void:
    var resource := load("res://assets/v106_original/car04/v106_car_04.glb") as PackedScene
    if resource == null:
        push_error("CAR04: GLB resource failed to load")
        return
    var fourth_car := resource.instantiate() as Node3D
    if fourth_car == null:
        push_error("CAR04: GLB scene failed to instantiate")
        return
    fourth_car.name = "OriginalV106Car04"
    train.add_child(fourth_car)
    var fourth_bounds := _get_model_bounds(fourth_car)
    if third_bounds.size.z > 1.0 and fourth_bounds.size.z > 1.0:
        var third_body: AABB = _bogie_visuals.body_bounds(third_car,third_bounds)
        var fourth_body: AABB = _bogie_visuals.body_bounds(fourth_car,fourth_bounds)
        var gap04: float = _bogie_visuals.half_body_gap(third_car,third_bounds,fourth_car,fourth_bounds)
        fourth_car.position.z = third_car.position.z + third_body.end.z + gap04 - fourth_body.position.z
        _bogie_visuals.shorten_original_coupler(third_car,false)
        _bogie_visuals.shorten_original_coupler(fourth_car,true)
        _add_visible_coupler_between(third_car, third_body, fourth_car, fourth_body, gap04)
    print("CAR04 attached; bounds=", fourth_bounds, " offset=", fourth_car.position.z)
    _configure_tunnel()
    _add_headlight()
    door_system = DOOR_SYSTEM.new()
    door_system.name = "SharedDoorSystem"
    add_child(door_system)
    door_system.call("setup",train)
    cab_runtime = CAB_RUNTIME.new()
    cab_runtime.name = "OriginalCabIntegration"
    var lead := train.get_node("OriginalV106Car01") as Node3D
    lead.add_child(cab_runtime)
    cab_runtime.call("initialize",self,lead,door_system)
    cab_runtime.call("make_screen_controls",_ui_layer)
    info_binding = _create_info_binding()
    info_binding.name = "RouteInfoBinding"
    add_child(info_binding)
    info_binding.call("initialize", self, _info_route_root())
    var lighting := preload("res://scripts/train_interior_v36.gd").new()
    lighting.name = "TrainInteriorLighting"
    add_child(lighting)
    lighting.initialize(self,train,_ui_layer)
    _decorate_consist()
    _configure_tunnel()
    print("FOUR_CAR_READY bounds=", _train_bounds, " models=4")

func _create_info_binding() -> Node:
    return preload("res://audio/controllers/route_info_binding.gd").new()

func _info_route_root() -> Node:
    return self

func _report_saloon_artwork_v46() -> void:
    # Temporary visual diagnostic: distinguish missing artwork from hidden geometry.
    var summary := "TZ46 "
    for car in train.get_children():
        if not (car is Node3D) or not str(car.name).begins_with("OriginalV106Car"):
            continue
        var holder := (car as Node3D).get_node_or_null("SaloonArtworkV46")
        var number := str(car.name).trim_prefix("OriginalV106Car")
        if holder == null:
            summary += number + ":MISSING "
            continue
        summary += "%s:A%d/M%d/L%d " % [number, int(holder.get_meta("advertisements",0)), int(holder.get_meta("network_maps",0)), int(holder.get_meta("line_diagrams",0))]
    print("TZ46_VISIBLE_DIAGNOSTIC ", summary)
    var label := Label.new()
    label.name = "TZ46PlacementDiagnostic"
    label.text = summary + "\\nA=ads M=maps L=lines"
    label.position = Vector2(14, 52)
    label.add_theme_font_size_override("font_size", 16)
    label.add_theme_color_override("font_color", Color.YELLOW)
    _ui_layer.add_child(label)

func _add_visible_coupler_between(first: Node3D, first_bounds: AABB, second: Node3D, second_bounds: AABB, gap: float) -> void:
    var end_z := first.position.z + first_bounds.position.z + first_bounds.size.z
    var next_z := second.position.z + second_bounds.position.z
    var midpoint := (end_z + next_z) * 0.5
    var metal := StandardMaterial3D.new()
    metal.albedo_color = Color(0.13, 0.14, 0.15)
    metal.metallic = 0.65
    var root := Node3D.new()
    root.name = "CouplerCar02Car03"
    train.add_child(root)
    var shaft := MeshInstance3D.new()
    var cylinder := CylinderMesh.new()
    cylinder.top_radius = 0.09
    cylinder.bottom_radius = 0.09
    cylinder.height = gap + 0.16
    shaft.mesh = cylinder
    shaft.rotation.x = PI * 0.5
    shaft.position = Vector3(0, 0.46, midpoint)
    shaft.material_override = metal
    root.add_child(shaft)
    var head := MeshInstance3D.new()
    var box := BoxMesh.new()
    box.size = Vector3(0.40, 0.20, 0.19)
    head.mesh = box
    head.position = Vector3(0, 0.46, midpoint)
    head.material_override = metal
    root.add_child(head)

func _add_visible_coupler(front: AABB, rear: AABB, rear_offset: float, gap: float) -> void:
    # Static visual automatic coupler between car-end faces.
    var z0 := front.position.z + front.size.z
    var z1 := rear.position.z + rear_offset
    var mid := (z0 + z1) * 0.5
    var steel := StandardMaterial3D.new()
    steel.albedo_color = Color(0.13, 0.14, 0.15)
    steel.metallic = 0.7
    steel.roughness = 0.64
    var coupler := Node3D.new()
    coupler.name = "VisibleInterCarCoupler"
    train.add_child(coupler)
    for y in [0.40, 0.56]:
        var shaft := MeshInstance3D.new()
        shaft.name = "CouplerSteelBar"
        var mesh := CylinderMesh.new()
        mesh.top_radius = 0.075
        mesh.bottom_radius = 0.075
        mesh.height = gap + 0.20
        shaft.mesh = mesh
        shaft.material_override = steel
        shaft.rotation.x = PI * 0.5
        shaft.position = Vector3(0, y, mid)
        coupler.add_child(shaft)
    var head := MeshInstance3D.new()
    head.name = "AutomaticCouplerHead"
    var head_mesh := BoxMesh.new()
    head_mesh.size = Vector3(0.42, 0.22, 0.20)
    head.mesh = head_mesh
    head.material_override = steel
    head.position = Vector3(0, 0.48, mid)
    coupler.add_child(head)
    for x in [-0.28, 0.28]:
        var hose := MeshInstance3D.new()
        hose.name = "CouplerAirHose"
        var hose_mesh := CylinderMesh.new()
        hose_mesh.top_radius = 0.025
        hose_mesh.bottom_radius = 0.025
        hose_mesh.height = gap + 0.14
        hose.mesh = hose_mesh
        hose.material_override = steel
        hose.rotation.x = PI * 0.5
        hose.position = Vector3(x, 0.28, mid)
        coupler.add_child(hose)

func _add_camera_controls(ui: CanvasLayer) -> void:
    var panel := VBoxContainer.new()
    panel.name = "CameraMovement"
    panel.set_anchors_preset(Control.PRESET_TOP_RIGHT)
    panel.position = Vector2(-184, 55)
    panel.set_anchor(SIDE_LEFT, 1.0)
    panel.set_anchor(SIDE_RIGHT, 1.0)
    ui.add_child(panel)
    for entry in [["ВПЕРЁД", "forward"], ["НАЗАД", "back"], ["ВЛЕВО", "left"], ["ВПРАВО", "right"], ["ВЫШЕ", "up"], ["НИЖЕ", "down"], ["БЛИЖЕ", "near"], ["ДАЛЬШЕ", "far"], ["ЦЕНТР", "reset"], ["ВАГОН -", "previous_car"], ["ВАГОН +", "next_car"]]:
        var button := Button.new()
        button.text = entry[0]
        button.custom_minimum_size = Vector2(175, 42)
        panel.add_child(button)
        var action: String = entry[1]
        if action == "previous_car" or action == "next_car":
            button.pressed.connect(func(): _cycle_car_focus(-1 if action == "previous_car" else 1))
        elif action == "reset":
            button.pressed.connect(func(): _set_camera_mode("external"))
        else:
            button.button_down.connect(func(): camera_move[action] = true)
            button.button_up.connect(func(): camera_move[action] = false)

func _get_model_bounds(root: Node3D) -> AABB:
    var found := false
    var result := AABB()
    var pending: Array[Node] = [root]
    while not pending.is_empty():
        var node: Node = pending.pop_back()
        if node is MeshInstance3D:
            var mesh_node := node as MeshInstance3D
            if mesh_node.mesh != null:
                var local_bounds := mesh_node.get_aabb()
                var xf := root.global_transform.affine_inverse() * mesh_node.global_transform
                var transformed := xf * local_bounds
                if not found:
                    result = transformed
                    found = true
                else:
                    result = result.merge(transformed)
        for child in node.get_children():
            pending.append(child)
    return result

func _zoom_view(ratio: float) -> void:
    if camera_mode == "cabin":
        _cab_fov = clampf(_cab_fov/ratio,42.0,105.0)
        camera.fov = _cab_fov
    else:
        orbit_radius = clampf(orbit_radius/ratio,0.35,120.0)

func _input(event: InputEvent) -> void:
    if camera_mode=="flight":
        if event is InputEventScreenTouch:
            if (not event.pressed or event.canceled) and event.index==camera_touch_id:
                camera_touch_id=-1
                get_viewport().set_input_as_handled()
            return
        if event is InputEventScreenDrag:
            if event.index==camera_touch_id:
                orbit_yaw-=event.relative.x*0.008
                orbit_pitch=clampf(orbit_pitch+event.relative.y*0.006,-1.2,1.2)
                _update_camera()
                get_viewport().set_input_as_handled()
            return
        if event is InputEventMouse and event.device==-1: return
    if event is InputEventScreenTouch:
        if event.pressed: _touch_points[event.index] = event.position
        else: _touch_points.erase(event.index)
        if _touch_points.size() >= 2:
            _pinching = true
            touch_dragging = false
            if is_instance_valid(cab_runtime): cab_runtime.call("cancel_interaction")
            var points := _touch_points.values()
            _pinch_distance = (points[0] as Vector2).distance_to(points[1])
            get_viewport().set_input_as_handled()
        elif _pinching:
            get_viewport().set_input_as_handled()
            if _touch_points.is_empty():
                _pinching = false
                _pinch_distance = 0.0
        return
    if event is InputEventScreenDrag:
        if _touch_points.has(event.index): _touch_points[event.index] = event.position
        if _pinching:
            if _touch_points.size() >= 2:
                var points := _touch_points.values()
                var span := (points[0] as Vector2).distance_to(points[1])
                if _pinch_distance > 5.0 and span > 5.0: _zoom_view(span/_pinch_distance)
                _pinch_distance = span
            get_viewport().set_input_as_handled()

func _unhandled_input(event: InputEvent) -> void:
    if camera_mode=="flight":
        if event is InputEventScreenTouch:
            if event.pressed and not event.canceled and camera_touch_id<0:
                camera_touch_id=event.index
                get_viewport().set_input_as_handled()
            return
        if event is InputEventScreenDrag: return
        if event is InputEventMouse and event.device==-1: return
    if _pinching or (event is InputEventMouse and not _touch_points.is_empty()): return
    if is_instance_valid(cab_runtime) and cab_runtime.call("handle_input",event,camera):
        get_viewport().set_input_as_handled()
        return
    if event is InputEventScreenTouch:
        touch_dragging = event.pressed
        touch_last = event.position
    elif event is InputEventScreenDrag and touch_dragging:
        orbit_yaw -= event.relative.x * 0.008
        orbit_pitch = clampf(orbit_pitch + event.relative.y * 0.006, -1.2, 1.2)
    elif event is InputEventMouseMotion and Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
        orbit_yaw -= event.relative.x * 0.008
        orbit_pitch = clampf(orbit_pitch + event.relative.y * 0.006, -1.2, 1.2)
    elif event is InputEventMouseButton and event.pressed:
        if event.button_index == MOUSE_BUTTON_WHEEL_UP:
            _zoom_view(1.15)
        elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
            _zoom_view(1.0/1.15)

func _box(parent: Node3D, pos: Vector3, dimensions: Vector3, color: Color) -> void:
    var item := MeshInstance3D.new()
    var mesh := BoxMesh.new()
    mesh.size = dimensions
    item.mesh = mesh
    var mat := StandardMaterial3D.new()
    mat.albedo_color = color
    mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
    item.material_override = mat
    item.position = pos
    parent.add_child(item)

func _physics_process(delta: float) -> void:
    var dt := minf(delta,0.1)
    # Four-car train: acceleration and braking are bounded by mass/inertia.
    # All rates are m/s²; neither releasing traction nor applying the service
    # brake may instantly cancel momentum.
    const MAX_TRACTION_ACCEL := 0.95
    const SERVICE_BRAKE_DECEL := 1.05
    const COAST_DECEL := 0.035
    const MAX_SPEED := 22.0
    var direction := 1
    var traction_request := 1.0 if throttle else 0.0
    var brake_request := 1.0 if brake else 0.0
    var adhesion := 1.0
    if is_instance_valid(cab_runtime):
        var input: Dictionary = cab_runtime.call("physics_inputs",dt,speed,throttle,brake)
        direction = int(input.direction)
        traction_request = clampf(float(input.traction),0.0,1.0)
        brake_request = clampf(float(input.brake),0.0,1.0)
        adhesion = clampf(float(input.adhesion),0.75,1.15)
    if brake_request > 0.001:
        # Service brake ramps in through cab_runtime; speed integrates smoothly.
        speed = maxf(speed-dt*SERVICE_BRAKE_DECEL*brake_request*adhesion,0.0)
    elif traction_request > 0.001:
        # Tractive effort weakens toward line speed.
        var speed_factor := clampf(1.0-speed/MAX_SPEED*0.45,0.45,1.0)
        speed = minf(speed+dt*MAX_TRACTION_ACCEL*traction_request*speed_factor*adhesion,MAX_SPEED)
    else:
        speed = maxf(speed-dt*COAST_DECEL,0.0)
    distance = maxf(route_end_distance,distance-float(direction)*speed*dt)
    if distance <= route_end_distance and direction == 1: speed = 0.0
    train.position.z = distance
    var step := CAMERA_MOVE_SPEED * delta
    if camera_mode == "cabin":
        orbit_yaw = clampf(orbit_yaw,-PI*0.5,PI*0.5)
    if camera_move.get("forward", false): camera_pan.z -= step
    if camera_move.get("back", false): camera_pan.z += step
    if camera_move.get("left", false): camera_pan.x -= step
    if camera_move.get("right", false): camera_pan.x += step
    if camera_move.get("up", false): camera_pan.y += step
    if camera_move.get("down", false): camera_pan.y -= step
    if camera_move.get("near", false): _zoom_view(exp(delta))
    if camera_move.get("far", false): _zoom_view(exp(-delta))
    _update_camera()
    var station_distance := maxf(0.0, distance + _train_bounds.position.z - _station_stop_z)
    var illumination := station_illumination(station_distance)
    station_approach_changed.emit(station_distance, illumination)
    _diagnostic_clock += delta
    if _diagnostic_clock >= 1.0:
        _diagnostic_clock = 0.0
        _publish_diagnostics()
    hud.text = "V106 · 4 ВАГОНА | %.0f км/ч | %.1f м | %s" % [speed * 3.6, distance, camera_mode]

func _update_camera() -> void:
    if camera_mode == "external":
        var focus := train.global_position + wagon_center + camera_pan
        var offset := Vector3(sin(orbit_yaw)*cos(orbit_pitch),sin(orbit_pitch),cos(orbit_yaw)*cos(orbit_pitch))*orbit_radius
        var desired := focus + offset
        if is_instance_valid(_tunnel) and _tunnel.has_method("constrain_camera"):
            desired = _tunnel.call("constrain_camera",desired)
        camera.global_position = desired
        if desired.distance_squared_to(focus) > 0.001:
            camera.look_at(focus, Vector3.UP)
    else:
        var cabin := camera_mode == "cabin"
        var local_eye := Vector3(-0.4 if cabin else 0.0,2.35,_train_bounds.position.z+1.35 if cabin else -2.0)
        if cabin and is_instance_valid(cab_runtime):
            local_eye = cab_runtime.call("eye_in_train")
        if cabin:
            orbit_yaw = clampf(orbit_yaw,-PI*0.5,PI*0.5)
        var desired := train.to_global(local_eye if cabin else local_eye + camera_pan)
        camera.global_position = _tunnel.call("constrain_camera",desired) if is_instance_valid(_tunnel) else desired
        if cabin:
            camera.global_basis = train.global_basis*Basis.from_euler(Vector3(-orbit_pitch,orbit_yaw,0))
        else:
            camera.rotation = Vector3(-orbit_pitch,orbit_yaw,0)

func _configure_tunnel() -> void:
    _train_bounds = _get_model_bounds(train)
    _car_centers.clear()
    for child in train.get_children():
        if str(child.name).begins_with("OriginalV106Car"):
            _car_centers.append(child.position+_get_model_bounds(child).get_center())
    _focused_car = mini(_focused_car,_car_centers.size()-1)
    wagon_center = _car_centers[_focused_car]
    if is_instance_valid(_tunnel) and camera != null:
        _tunnel.call("configure",train,_train_bounds,camera)

func _add_headlight() -> void:
    var lead := train.get_node("OriginalV106Car01") as Node3D
    _illuminate_headlamp_lenses(lead)
    # Use the actual outer lamp nodes of the preserved V106 GLB.
    for index in range(2):
        var lamp := lead.find_child("headlamp-0" if index == 0 else "headlamp-5",true,false) as Node3D
        if lamp == null:
            push_error("V106 headlamp attachment node missing")
            continue
        var headlight := SpotLight3D.new()
        headlight.name = "TrainHeadlightLeft" if index == 0 else "TrainHeadlightRight"
        lead.add_child(headlight)
        headlight.position = lead.to_local(lamp.global_position)+Vector3(0,0,-0.07)
        headlight.rotation = Vector3(deg_to_rad(-1.5),deg_to_rad(1.8 if index == 0 else -1.8),0)
        headlight.light_color = Color(1.0,0.94,0.82)
        headlight.light_energy = 3.5
        headlight.spot_range = 105.0
        headlight.spot_angle = 32.0
        headlight.spot_attenuation = 1.2
        headlight.spot_angle_attenuation = 1.5
        headlight.shadow_enabled = true


func _illuminate_headlamp_lenses(lead: Node3D) -> void:
    # Emission changes only the existing front glass surfaces. Shared GLB
    # materials, lamp housings and the two lighting beams remain untouched.
    var glowing_lens: BaseMaterial3D
    var lit_lamps := 0
    for index in range(6):
        var lamp := lead.find_child("headlamp-%d" % index,true,false) as Node3D
        if lamp == null:
            push_error("V106 headlamp lens node missing")
            continue
        var lit := false
        for child in lamp.find_children("*","MeshInstance3D",true,false):
            var lens := child as MeshInstance3D
            if lens.mesh == null:
                continue
            for surface in range(lens.mesh.get_surface_count()):
                var original := lens.get_active_material(surface) as BaseMaterial3D
                if original == null or original.transparency == BaseMaterial3D.TRANSPARENCY_DISABLED or original.albedo_color.a >= 0.5:
                    continue
                if glowing_lens == null:
                    glowing_lens = original.duplicate() as BaseMaterial3D
                    glowing_lens.albedo_color = Color(0.65,0.60,0.49,1.0)
                    glowing_lens.transparency = BaseMaterial3D.TRANSPARENCY_DISABLED
                    glowing_lens.emission_enabled = true
                    glowing_lens.emission = Color(1.0,0.94,0.82)
                    glowing_lens.emission_energy_multiplier = 1.5
                lens.set_surface_override_material(surface,glowing_lens)
                lit = true
        if lit:
            lit_lamps += 1
    if lit_lamps != 6:
        push_error("V106: expected six illuminated headlamp lenses, found %d" % lit_lamps)

func _set_camera_mode(mode: String) -> void:
    camera_touch_id=-1
    _touch_points.clear()
    _pinching=false
    _pinch_distance=0.0
    touch_dragging=false
    camera_mode = mode
    camera.fov = _cab_fov if mode == "cabin" else 75.0
    if is_instance_valid(cab_runtime): cab_runtime.call("cancel_interaction")
    _focused_car = 0
    if not _car_centers.is_empty():
        wagon_center = _car_centers[0]
    camera_pan = Vector3.ZERO
    orbit_radius = 8.0
    orbit_yaw = 0.35 if mode == "external" else 0.0
    orbit_pitch = 0.10 if mode == "external" else 0.0
    _update_camera()
    _publish_diagnostics()
    print("CAMERA_MODE ",mode)

func _add_view_modes(ui: CanvasLayer) -> void:
    var row := HBoxContainer.new()
    row.name = "ViewModes"
    row.set_anchors_preset(Control.PRESET_BOTTOM_WIDE)
    row.offset_top = -145
    row.offset_bottom = -97
    ui.add_child(row)
    for entry in [["СНАРУЖИ","external"],["КАБИНА","cabin"],["САЛОН","salon"]]:
        var button := Button.new()
        button.text = entry[0]
        button.custom_minimum_size = Vector2(150,48)
        button.size_flags_horizontal = Control.SIZE_EXPAND_FILL
        row.add_child(button)
        var mode: String = entry[1]
        button.pressed.connect(func(): _set_camera_mode(mode))

# A station is attached once, before entering the 150 m approach zone.
# StationBase can be supplied by the route scene without duplicating its assets.
func attach_station(scene: PackedScene, placement: Transform3D, stop_z: float) -> void:
    if is_instance_valid(_station):
        _station.queue_free()
    _station = scene.instantiate() as Node3D
    assert(_station != null,"Station root must be Node3D")
    add_child(_station)
    _station.global_transform = placement
    _station_stop_z = stop_z

func station_illumination(distance_m: float) -> float:
    return 1.0 - smoothstep(30.0,150.0,distance_m)

func diagnostic_state() -> Dictionary:
    var cars := 0
    for child in train.get_children():
        if str(child.name).begins_with("OriginalV106Car"):
            cars += 1
    return {
        "cab_loaded":is_instance_valid(cab_runtime) and bool(cab_runtime.get("ready_for_play")),
        "cab_version":"cab-r2.1-v39-r2",
        "cab_cleanup_ready":bool(cab_runtime.get("cleanup_ready")) if is_instance_valid(cab_runtime) else false,
        "saloon_lights":get_node("TrainInteriorLighting").get("lights").size() if has_node("TrainInteriorLighting") else 0,
        "saloon_cars":int(get_node("TrainInteriorLighting").get("cars_lit")) if has_node("TrainInteriorLighting") else 0,
        "cab_textures_verified":int(cab_runtime.get("_source_recipe").get("verified_nonempty_images",0)) if is_instance_valid(cab_runtime) else 0,
        "door_system_ready":is_instance_valid(door_system) and bool(door_system.get("validated")),
        "tunnel_visible":is_instance_valid(_tunnel) and _tunnel.is_visible_in_tree(),"train_visible":train.is_visible_in_tree(),
        "cars":cars,"focused_car":_focused_car+1,"speed":speed,"distance":distance,"view":camera_mode,
        "length":_train_bounds.size.z,
        "modules":_tunnel.call("active_module_count") if is_instance_valid(_tunnel) else 0,
        "recycles":_tunnel.get("recycle_count") if is_instance_valid(_tunnel) else 0,
        "coverage":_tunnel.call("coverage_is_valid") if is_instance_valid(_tunnel) else false,
        "headlights":train.get_node("OriginalV106Car01").find_children("TrainHeadlight*","SpotLight3D",true,false).size()
    }

func _publish_diagnostics() -> void:
    if _diagnostics_enabled:
        JavaScriptBridge.eval("window.metro2Diagnostics = "+JSON.stringify(diagnostic_state())+"; null",true)

func _cycle_car_focus(direction: int) -> void:
    if _car_centers.is_empty():
        return
    var next := posmod(_focused_car+direction,_car_centers.size())
    _set_camera_mode("external")
    _focused_car = next
    wagon_center = _car_centers[_focused_car]
    _update_camera()
    _publish_diagnostics()



# Composition hooks: legacy defaults are preserved; modules may supply a route/world.
func _create_world_environment() -> void:
    var world := WorldEnvironment.new()
    var env := Environment.new()
    env.background_mode = Environment.BG_COLOR
    env.background_color = Color(0.006, 0.008, 0.012)
    env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
    env.ambient_light_color = Color(0.50, 0.49, 0.46)
    env.ambient_light_energy = 0.085
    _environment = env
    env.fog_enabled = true
    env.fog_mode = Environment.FOG_MODE_DEPTH
    env.fog_depth_begin = 60.0
    env.fog_depth_end = 120.0
    env.fog_depth_curve = 1.2
    env.fog_density = 1.0
    env.fog_light_color = Color(0.006,0.008,0.012)
    env.fog_light_energy = 0.025
    env.fog_sun_scatter = 0.0
    world.environment = env
    add_child(world)
    var light := DirectionalLight3D.new()
    light.rotation_degrees = Vector3(-40, -25, 0)
    light.light_energy = 0.025
    add_child(light)

func _create_route_tunnel() -> void:
    # Lightweight straight route, independent from legacy tunnel_v2.gd.
    var tunnel := Node3D.new()
    _tunnel = tunnel
    tunnel.name = "LightweightStraightTunnel"
    tunnel.set_script(tunnel_script if tunnel_script != null else load("res://scripts/tunnel_lightweight_straight.gd"))
    add_child(tunnel)

# Viewer-only subclasses can isolate failing decorators without changing gameplay.
func _decorate_consist() -> void:
    preload("res://scripts/v106_warning_stickers.gd").restore(train, door_system)
    preload("res://scripts/depot/saloon_advertising_v46.gd").decorate(self,train,door_system)
    _report_saloon_artwork_v46()

func _notification(what: int) -> void:
    if what==NOTIFICATION_APPLICATION_FOCUS_OUT:
        camera_touch_id=-1
        _touch_points.clear()
        _pinching=false
        _pinch_distance=0.0
        touch_dragging=false

func _reset_camera_touch() -> void:
    camera_touch_id=-1
␀␀␀␀extends RefCounted
## Rebuild exactly two fixed-body caution signs per door opening.
## Imported warning quads are never reused: their positions may overlap doors.
const WARNING = preload("res://assets/v106_warning/v106_warning_caution.png")
const SIGN_WIDTH := 0.16
const SIGN_HEIGHT := 0.115
const SIGN_Y := 1.28
const EDGE_MARGIN := 0.10
const SURFACE_OFFSET := 0.008

static func restore(train: Node3D, door_system: Node) -> void:
    var material := StandardMaterial3D.new()
    material.albedo_texture = WARNING
    material.albedo_color = Color.WHITE
    material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
    material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA_SCISSOR
    material.alpha_scissor_threshold = 0.025
    material.cull_mode = BaseMaterial3D.CULL_DISABLED
    material.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
    material.render_priority = 2
    var all_leaves: Array = door_system.get("leaves")
    for car in train.get_children():
        if not car is Node3D or not str(car.name).begins_with("OriginalV106Car"):
            continue
        # Imported GLB warning meshes are the cause of overlapping decals.
        # Hide ALL of them, including those nested under moving door leaves.
        for node in car.find_children("passenger-door-caution*", "MeshInstance3D", true, false):
            (node as MeshInstance3D).hide()
        var old := car.get_node_or_null("FixedBodyWarningSigns")
        if old != null:
            old.queue_free()
        var holder := Node3D.new()
        holder.name = "FixedBodyWarningSigns"
        car.add_child(holder)
        var side_leaves: Array = [[], []]
        for leaf in all_leaves:
            var part: Dictionary = leaf
            var piece: Dictionary = part["parts"][0]
            var root := piece["node"] as Node3D
            if root == null or not car.is_ancestor_of(root):
                continue
            var center: Vector3 = part["center"]
            side_leaves[0 if center.x < 0.0 else 1].append(part)
        var created := 0
        for side in side_leaves:
            side.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
                var ac: Vector3 = a["center"]
                var bc: Vector3 = b["center"]
                return ac.z < bc.z
            )
            if side.size() != 8:
                push_warning("Warning signs: expected 8 door leaves per side on " + str(car.name) + ", got " + str(side.size()))
                continue
            for pair in range(4):
                var first: Dictionary = side[pair * 2]
                var second: Dictionary = side[pair * 2 + 1]
                var a: AABB = first["parts"][0]["bounds"]
                var b: AABB = second["parts"][0]["bounds"]
                var side_x: float = (first["center"] as Vector3).x
                var direction := -1.0 if side_x < 0.0 else 1.0
                var outer_face_x := maxf(maxf(absf(a.position.x), absf(a.end.x)), maxf(absf(b.position.x), absf(b.end.x)))
                var x := direction * (outer_face_x + SURFACE_OFFSET)
                var start_z := minf(a.position.z, b.position.z) - EDGE_MARGIN - SIGN_WIDTH * 0.5
                var end_z := maxf(a.end.z, b.end.z) + EDGE_MARGIN + SIGN_WIDTH * 0.5
                _make_sign(holder, material, Vector3(_body_surface_x(car, direction, SIGN_Y, start_z, x), SIGN_Y, start_z), pair, "A")
                _make_sign(holder, material, Vector3(_body_surface_x(car, direction, SIGN_Y, end_z, x), SIGN_Y, end_z), pair, "B")
                created += 2
        print("V106_WARNING_FIXED ", car.name, " signs=", created)

static func _make_sign(holder: Node3D, material: Material, pos: Vector3, pair: int, edge: String) -> void:
    var sign := MeshInstance3D.new()
    sign.name = "BodyCaution_%d_%s" % [pair, edge]
    var quad := QuadMesh.new()
    quad.size = Vector2(SIGN_WIDTH, SIGN_HEIGHT)
    sign.mesh = quad
    sign.material_override = material
    sign.position = pos
    sign.rotation.y = -PI * 0.5 if pos.x < 0.0 else PI * 0.5
    sign.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
    holder.add_child(sign)

## Find the ACTUAL body skin at the sign position by ray/triangle intersection.
## AABB and door-panel centers are not body-surface coordinates.
static func _body_surface_x(car: Node3D, side: float, y: float, z: float, fallback: float) -> float:
    var from := Vector3(side * 2.5, y, z)
    var ray := Vector3(-side, 0.0, 0.0)
    var nearest := INF
    var hit_x := fallback
    for node in car.find_children("*", "MeshInstance3D", true, false):
        var mesh_node := node as MeshInstance3D
        if mesh_node.mesh == null or not mesh_node.visible:
            continue
        var name_lower := str(mesh_node.name).to_lower()
        if name_lower.begins_with("passenger-door") or name_lower.begins_with("bodycaution") or name_lower.begins_with("minskdoor"):
            continue
        var pose: Transform3D = car.global_transform.affine_inverse() * mesh_node.global_transform
        var box: AABB = pose * mesh_node.get_aabb()
        if y < box.position.y or y > box.end.y or z < box.position.z or z > box.end.z:
            continue
        for surface in range(mesh_node.mesh.get_surface_count()):
            if mesh_node.mesh.surface_get_primitive_type(surface) != Mesh.PRIMITIVE_TRIANGLES:
                continue
            var arrays := mesh_node.mesh.surface_get_arrays(surface)
            var verts: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
            var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
            var count := indices.size() if not indices.is_empty() else verts.size()
            for i in range(0, count - 2, 3):
                var ia := indices[i] if not indices.is_empty() else i
                var ib := indices[i + 1] if not indices.is_empty() else i + 1
                var ic := indices[i + 2] if not indices.is_empty() else i + 2
                var a: Vector3 = pose * verts[ia]
                var b: Vector3 = pose * verts[ib]
                var cc: Vector3 = pose * verts[ic]
                var hit = Geometry3D.ray_intersects_triangle(from, ray, a, b, cc)
                if hit is Vector3:
                    var distance: float = from.distance_to(hit)
                    if distance < nearest:
                        nearest = distance
                        hit_x = hit.x + side * SURFACE_OFFSET
    return hit_x
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀extends Node
## Door leaves discovered by their imported mesh bounds; GLB originals stay untouched.
## Existing leaf parents move all child meshes together with their caution decal.
signal ready_count(count: int)
var leaves: Array[Dictionary] = []
var openness: float = 0.0
var target_open: bool = false
var validated: bool = false
var side_targets := {-1:false,1:false}
var side_open := {-1:0.0,1:0.0}
const SLIDE_METERS := 0.56
const ANIMATION_SECONDS := 1.3

func setup(consist: Node3D) -> void:
    leaves.clear()
    validated = false
    for car in consist.get_children():
        if not str(car.name).begins_with("OriginalV106Car"):
            continue
        var panels: Array[Dictionary] = []
        var decals: Array[Dictionary] = []
        _scan(car, car, panels, decals)
        var grouped: Dictionary = {}
        for item in panels:
            var center: Vector3 = item["center"]
            var key := "%s:%s" % [roundi(center.x * 10.0), roundi(center.z * 100.0)]
            if not grouped.has(key):
                grouped[key] = []
            grouped[key].append(item)
        var car_leaves: Array[Dictionary] = []
        for key in grouped:
            var group: Array = grouped[key]
            if group.size() != 1:
                continue
            var center: Vector3 = group[0]["center"]
            car_leaves.append({"parts": group, "center": center, "decals": []})
        for decal in decals:
            var decal_center: Vector3 = decal["center"]
            var best_distance := 0.65
            var best_index := -1
            for i in range(car_leaves.size()):
                var center: Vector3 = car_leaves[i]["center"]
                var distance := absf(center.z - decal_center.z) + absf(center.x - decal_center.x) * 0.05
                if signf(center.x) == signf(decal_center.x) and distance < best_distance:
                    best_distance = distance
                    best_index = i
            if best_index >= 0:
                car_leaves[best_index]["decals"].append(decal)
        if car_leaves.size() != 16:
            push_error("V106 door discovery: %s found %d/16 leaves" % [car.name, car_leaves.size()])
            leaves.clear()
            ready_count.emit(0)
            return
        for leaf in car_leaves:
            if leaf["decals"].size() != 1:
                push_error("V106 door decal mismatch in %s" % car.name)
                leaves.clear()
                ready_count.emit(0)
                return
        # Require one and only one matching leaf within the same car.
        for i in range(car_leaves.size()):
            var center: Vector3 = car_leaves[i]["center"]
            var partners: Array[int] = []
            for j in range(car_leaves.size()):
                if i == j:
                    continue
                var other: Vector3 = car_leaves[j]["center"]
                var distance := absf(other.z - center.z)
                if absf(other.x - center.x) < 0.2 and distance > 0.60 and distance < 0.80:
                    partners.append(j)
            if partners.size() != 1:
                push_error("Ambiguous door pairing in %s, leaf %d" % [car.name, i])
                leaves.clear()
                ready_count.emit(0)
                return
            var partner: Vector3 = car_leaves[partners[0]]["center"]
            car_leaves[i]["direction"] = signf(center.z - partner.z)
            car_leaves[i]["seam"] = (center.z+partner.z)*0.5
        _attach_stationary_leaf_details(car,car_leaves)
        _restore_door_stripes(car,car_leaves)
        leaves.append_array(car_leaves)
    validated = leaves.size() == 64
    ready_count.emit(leaves.size())
    if leaves.size() != 64:
        push_warning("Door controller expected 64 leaves; found %d. Animation disabled." % leaves.size())

func _scan(root: Node, car: Node3D, panels: Array[Dictionary], decals: Array[Dictionary]) -> void:
    if root is MeshInstance3D and root.mesh != null:
        var bounds: AABB = root.get_aabb()
        var size: Vector3 = bounds.size
        var to_car: Transform3D = car.global_transform.affine_inverse() * root.global_transform
        var center: Vector3 = to_car * bounds.get_center()
        if str(root.name).begins_with("passenger-door-caution"):
            decals.append({"node": root, "center": center, "origin": root.position,
                "slide_axis": root.get_parent().global_basis.inverse() * car.global_basis.z})
        elif size.x > 0.67 and size.x < 0.70 and size.y > 2.0 and size.y < 2.1 and size.z > 0.02 and size.z < 0.04 and absf(center.x) > 1.0 and absf(center.x) < 1.4:
            # Move the existing leaf parent, including skin, glass and trim.
            var leaf: Node3D = root.get_parent()
            panels.append({"node": leaf, "center": center, "bounds":to_car*bounds, "origin": leaf.position,
                "slide_axis": leaf.get_parent().global_basis.inverse() * car.global_basis.z})
    for child in root.get_children():
        _scan(child, car, panels, decals)

func _restore_door_stripes(car: Node3D, car_leaves: Array[Dictionary]) -> void:
    # Read the existing waist stripe so the door paint meets its actual height
    # and colour on both the original and LOD1 cars. No GLB is rewritten.
    var top := 1.9425
    var width := 0.105
    var paint := StandardMaterial3D.new()
    paint.albedo_color = Color(0.91,0.87,0.75)
    paint.roughness = 0.55
    for child in car.find_children("*","MeshInstance3D",true,false):
        var source := child as MeshInstance3D
        if source.mesh == null or source.mesh.get_surface_count() == 0: continue
        var bounds: AABB = car.global_transform.affine_inverse()*source.global_transform*source.get_aabb()
        if bounds.size.z < 4.0 or bounds.size.x < 2.3 or bounds.size.y < 0.07 or bounds.size.y > 0.15: continue
        if absf(bounds.get_center().y-1.89) > 0.08: continue
        var material := source.get_active_material(0) as BaseMaterial3D
        if material == null or material.albedo_color.r < 0.6 or material.albedo_color.g < 0.6: continue
        paint.albedo_color = material.albedo_color
        paint.roughness = material.roughness
        paint.metallic = material.metallic
        top = bounds.end.y
        width = bounds.size.y
        break
    paint.resource_name = "MinskDoorStripePaint"
    paint.cull_mode = BaseMaterial3D.CULL_DISABLED
    for leaf in car_leaves:
        var item: Dictionary = leaf["parts"][0]
        var parent := item["node"] as Node3D
        if parent.has_node("MinskDoorStripe"): continue
        var bounds: AABB = item["bounds"]
        var direction: float = leaf["direction"]
        var seam: float = leaf["seam"]
        var side := signf((leaf["center"] as Vector3).x)
        var outer := absf((bounds.end.z if direction > 0.0 else bounds.position.z)-seam)
        var inner := maxf(0.008,absf((bounds.position.z if direction > 0.0 else bounds.end.z)-seam))
        var bottom := bounds.position.y+0.035
        var knee := bottom+(top-bottom)*0.28
        # Photo reference: long inward diagonal, low waist, short outward foot.
        # Each half stays on its own leaf and stops at the black centre seal.
        var outline := PackedVector2Array([
            Vector2(outer,top),Vector2(outer-width*1.4,top),
            Vector2(inner,knee),Vector2(outer-width*2.7,bottom),
            Vector2(outer,bottom),Vector2(inner+width*1.65,knee),
            Vector2(outer,top-width)])
        var indices := Geometry2D.triangulate_polygon(outline)
        if indices.is_empty():
            push_error("Door stripe triangulation failed in "+str(car.name))
            continue
        var x := (bounds.end.x if side > 0.0 else bounds.position.x)+side*0.003
        var local := parent.global_transform.affine_inverse()*car.global_transform
        var normal := (local.basis.inverse().transposed()*Vector3(side,0,0)).normalized()
        var tool := SurfaceTool.new()
        tool.begin(Mesh.PRIMITIVE_TRIANGLES)
        tool.set_material(paint)
        for index in indices:
            var point := outline[index]
            tool.set_normal(normal)
            tool.add_vertex(local*Vector3(x,point.y,seam+direction*point.x))
        var stripe := MeshInstance3D.new()
        stripe.name = "MinskDoorStripe"
        stripe.mesh = tool.commit()
        stripe.mesh.resource_name = "MinskDoorChevron"
        stripe.layers = (parent.get_child(0) as MeshInstance3D).layers
        stripe.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
        stripe.set_meta("reference","Minsk 81-717: waist stripe, low chevron and outward foot")
        stripe.set_meta("passenger_door_livery",true)
        parent.add_child(stripe)

func _half(poly: Array, axis: int, edge: float, greater: bool) -> Array:
    var result: Array = []
    for i in range(poly.size()):
        var a: Array = poly[i]
        var b: Array = poly[(i+1)%poly.size()]
        var av: float = a[0][axis]
        var bv: float = b[0][axis]
        var ai: bool = av >= edge if greater else av <= edge
        var bi: bool = bv >= edge if greater else bv <= edge
        if ai: result.append(a)
        if ai != bi:
            var t := (edge-av)/(bv-av)
            result.append([a[0].lerp(b[0],t),a[1].lerp(b[1],t),a[2].lerp(b[2],t),a[3].lerp(b[3],t)])
    return result

func _partition(poly: Array, volume: AABB) -> Dictionary:
    var outside: Array = []
    var inside: Array = poly
    for axis in range(3):
        for upper in [false,true]:
            var edge: float = volume.end[axis] if upper else volume.position[axis]
            var piece := _half(inside,axis,edge,upper)
            if piece.size() >= 3: outside.append(piece)
            inside = _half(inside,axis,edge,not upper)
            if inside.size() < 3: return {"outside":outside,"inside":[]}
    return {"outside":outside,"inside":inside}

func _emit_polygon(tool: SurfaceTool, poly: Array, inverse: Transform3D) -> int:
    var count := 0
    for k in range(1,poly.size()-1):
        var a: Vector3 = poly[0][0]
        var b: Vector3 = poly[k][0]
        var c: Vector3 = poly[k+1][0]
        if (b-a).cross(c-a).length_squared() < 0.000000000001: continue
        for vertex in [poly[0],poly[k],poly[k+1]]:
            tool.set_normal((inverse.basis.inverse().transposed()*vertex[1]).normalized())
            tool.set_uv(vertex[2])
            tool.set_color(vertex[3])
            tool.add_vertex(inverse*vertex[0])
            count += 1
    return count

func _attach_stationary_leaf_details(car: Node3D, car_leaves: Array[Dictionary]) -> void:
    var openings: Array[Dictionary] = []
    var details: Array[Dictionary] = []
    var layers: Array[int] = []
    for i in range(car_leaves.size()):
        details.append({})
        layers.append(0)
        if float(car_leaves[i]["direction"]) > 0.0: continue
        var left: Vector3 = car_leaves[i]["center"]
        for j in range(car_leaves.size()):
            var right: Vector3 = car_leaves[j]["center"]
            if float(car_leaves[j]["direction"]) <= 0.0 or absf(left.x-right.x) > 0.2 or absf(absf(right.z-left.z)-0.69) > 0.10: continue
            var center := (left+right)*0.5
            var low_x := center.x-0.045 if center.x < 0.0 else center.x-0.080
            # Inboard door trims only. Jambs lie outside this longitudinal
            # interval, the sill below it, the fixed rail/header above it.
            var volume := AABB(Vector3(low_x,1.033,center.z-0.65),Vector3(0.125,1.865,1.30))
            openings.append({"volume":volume,"split":center.z,"negative":i,"positive":j})
    var sources := car.find_children("*","MeshInstance3D",true,false)
    for child in sources:
        var source := child as MeshInstance3D
        if source.mesh == null or not source.is_visible_in_tree(): continue
        var moving_part := false
        for leaf in car_leaves:
            for item in leaf["parts"]:
                var root := item["node"] as Node
                if source == root or root.is_ancestor_of(source): moving_part = true
        if moving_part: continue
        var transform := car.global_transform.affine_inverse()*source.global_transform
        var inverse := transform.affine_inverse()
        var normal_basis := transform.basis.inverse().transposed()
        var bounds: AABB = transform*source.get_aabb()
        var relevant: Array[Dictionary] = []
        for opening in openings:
            if bounds.intersects(opening["volume"]): relevant.append(opening)
        if relevant.is_empty(): continue
        var replacement := ArrayMesh.new()
        var changed := false
        for surface in range(source.mesh.get_surface_count()):
            var arrays: Array = source.mesh.surface_get_arrays(surface).duplicate(true)
            var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
            var normals: PackedVector3Array = arrays[Mesh.ARRAY_NORMAL] if arrays[Mesh.ARRAY_NORMAL] != null else PackedVector3Array()
            var uvs: PackedVector2Array = arrays[Mesh.ARRAY_TEX_UV] if arrays[Mesh.ARRAY_TEX_UV] != null else PackedVector2Array()
            var colors: PackedColorArray = arrays[Mesh.ARRAY_COLOR] if arrays[Mesh.ARRAY_COLOR] != null else PackedColorArray()
            var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX] if arrays[Mesh.ARRAY_INDEX] != null else PackedInt32Array()
            if indices.is_empty():
                indices.resize(vertices.size())
                for i in range(vertices.size()): indices[i] = i
            var material := source.get_active_material(surface)
            var kept := PackedInt32Array()
            var clipped := SurfaceTool.new()
            clipped.begin(Mesh.PRIMITIVE_TRIANGLES)
            var clipped_count := 0
            for triangle in range(0,indices.size(),3):
                var ids := [indices[triangle],indices[triangle+1],indices[triangle+2]]
                var a: Vector3 = transform*vertices[ids[0]]
                var b: Vector3 = transform*vertices[ids[1]]
                var c: Vector3 = transform*vertices[ids[2]]
                var low := a.min(b).min(c)
                var tri_box := AABB(low,a.max(b).max(c)-low)
                var candidates: Array[Dictionary] = []
                for opening in relevant:
                    if tri_box.intersects(opening["volume"]): candidates.append(opening)
                if candidates.is_empty():
                    kept.append_array(PackedInt32Array(ids))
                    continue
                var fallback := (b-a).cross(c-a).normalized()
                var polygon: Array = []
                for index in ids:
                    polygon.append([transform*vertices[index],(normal_basis*normals[index]).normalized() if normals.size() == vertices.size() else fallback,uvs[index] if uvs.size() == vertices.size() else Vector2.ZERO,colors[index] if colors.size() == vertices.size() else Color.WHITE])
                var remaining: Array = [polygon]
                var extracted := false
                for opening in candidates:
                    var next: Array = []
                    for piece in remaining:
                        var partition := _partition(piece,opening["volume"])
                        next.append_array(partition["outside"])
                        var inside: Array = partition["inside"]
                        if inside.size() < 3: continue
                        for positive in [false,true]:
                            var half := _half(inside,2,float(opening["split"]),positive)
                            if half.size() < 3: continue
                            var index: int = int(opening["positive"] if positive else opening["negative"])
                            if not details[index].has(material):
                                var builder := SurfaceTool.new()
                                builder.begin(Mesh.PRIMITIVE_TRIANGLES)
                                builder.set_material(material)
                                details[index][material] = {"tool":builder,"count":0}
                            var record: Dictionary = details[index][material]
                            var count := _emit_polygon(record["tool"],half,Transform3D.IDENTITY)
                            record["count"] = int(record["count"])+count
                            if count > 0:
                                extracted = true
                                layers[index] |= source.layers
                    remaining = next
                if not extracted:
                    kept.append_array(PackedInt32Array(ids))
                    continue
                changed = true
                for piece in remaining: clipped_count += _emit_polygon(clipped,piece,inverse)
            if not kept.is_empty():
                arrays[Mesh.ARRAY_INDEX] = kept
                replacement.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays)
                replacement.surface_set_material(replacement.get_surface_count()-1,material)
            if clipped_count > 0:
                clipped.set_material(material)
                clipped.commit(replacement)
        if changed:
            # Retain an empty instance mesh when fully extracted, so a later
            # visibility pass cannot resurrect the old stationary geometry.
            source.mesh = replacement
            if replacement.get_surface_count() == 0: source.hide()
            else:
                for surface in range(replacement.get_surface_count()): source.set_surface_override_material(surface,null)
    for i in range(car_leaves.size()):
        var mesh := ArrayMesh.new()
        for record in details[i].values():
            if int(record["count"]) > 0: (record["tool"] as SurfaceTool).commit(mesh)
        if mesh.get_surface_count() == 0: continue
        var part := MeshInstance3D.new()
        part.name = "AttachedOriginalDoorTrim%02d" % i
        part.mesh = mesh
        part.layers = layers[i]
        car.add_child(part)
        car_leaves[i]["parts"].append({"node":part,"origin":Vector3.ZERO,"slide_axis":Vector3(0,0,1)})

func _process(delta: float) -> void:
    if not validated:
        return
    for side in [-1,1]:
        side_open[side] = move_toward(float(side_open[side]),1.0 if side_targets[side] else 0.0,delta/ANIMATION_SECONDS)
    openness = maxf(float(side_open[-1]),float(side_open[1]))
    target_open = bool(side_targets[-1]) or bool(side_targets[1])
    for leaf in leaves:
        var direction: float = leaf["direction"]
        var amount: float = side_open[-1 if (leaf["center"] as Vector3).x < 0.0 else 1]
        for item in leaf["parts"]:
            var node: Node3D = item["node"]
            node.position = item["origin"] + item["slide_axis"] * direction * SLIDE_METERS * amount
        for item in leaf["decals"]:
            var node: Node3D = item["node"]
            node.position = item["origin"] + item["slide_axis"] * direction * SLIDE_METERS * amount

func request_side(side: int, speed_mps: float) -> bool:
    if absf(speed_mps) > 0.05 or not validated:
        return false
    side_targets[side] = true
    target_open = true
    return true

func request_open(speed_mps: float) -> void:
    request_side(-1,speed_mps)
    request_side(1,speed_mps)

func request_close() -> void:
    side_targets[-1] = false
    side_targets[1] = false
    target_open = false

func can_move() -> bool:
    return not target_open and openness <= 0.001 and validated


␀␀␀␀␀␀␀␀␀␀␀␀␀extends "res://modules/trains/v106/v106_train.gd"
## The original V47 train; V49 visual artwork/materials only.
const ADVERTISING_STATUS := "ADVERTISING: ENABLED — V49 FIXED MOUNTS"

func _decorate_consist() -> void:
    # Keep the legacy body-sticker restoration isolated; no mechanical changes.
    preload("res://scripts/depot/saloon_advertising_v46.gd").decorate(self,train,door_system)
    preload("res://scripts/depot/saloon_realism_v49.gd").apply(train,door_system)
    preload("res://scripts/depot/goodmix_restore.gd").apply(train)

func _attach_fourth_car(third_car: Node3D, third_bounds: AABB) -> void:
    super._attach_fourth_car(third_car,third_bounds)
    _ui_layer.hide()
    camera.current = false
    set_physics_process(false)
    _disable_input(self)

func _disable_input(node: Node) -> void:
    node.set_process_input(false)
    node.set_process_unhandled_input(false)
    node.set_process_unhandled_key_input(false)
    for child in node.get_children():
        _disable_input(child)
